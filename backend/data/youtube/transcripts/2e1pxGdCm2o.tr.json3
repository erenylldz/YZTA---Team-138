{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 90,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Tekrar merhaba, bu dersimiz de bir önceki"
    } ]
  }, {
    "tStartMs": 2730,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "dersimiz de konuştuğumuz konuların devamı"
    } ]
  }, {
    "tStartMs": 5940,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "olarak yatırımcı tipleriyle başlayacağız."
    } ]
  }, {
    "tStartMs": 8490,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "Daha sonra yine bir önceki derste"
    } ]
  }, {
    "tStartMs": 10140,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "konuştuğumuz yatırım çeşitlerinin detaylarına"
    } ]
  }, {
    "tStartMs": 12960,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "ineceğiz. Sen de onlardan birisin."
    } ]
  }, {
    "tStartMs": 14910,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "Melek yatırımcılarla başlayalım istersen ve"
    } ]
  }, {
    "tStartMs": 16950,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "yatırımcı tiplerini konuşalım."
    } ]
  }, {
    "tStartMs": 18270,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "Evet. Melek yatırımcılık herhalde melek gibi iyi"
    } ]
  }, {
    "tStartMs": 23220,
    "dDurationMs": 4410,
    "segs": [ {
      "utf8": "algılandıkları için zamanında verilmiş bir isim. Oldukça eski."
    } ]
  }, {
    "tStartMs": 28000,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "50-60 yıl önce ilk melek yatırımcılık"
    } ]
  }, {
    "tStartMs": 30810,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "örnekleri yapılmış. Melek yatırımcının çok"
    } ]
  }, {
    "tStartMs": 34950,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "basit bir tanımı var. Bireysel olarak bireyin"
    } ]
  }, {
    "tStartMs": 38400,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "kendi finansal varlıklarını yatırım olarak"
    } ]
  }, {
    "tStartMs": 41820,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "bir Start-up'a verdiği örnek tamamen."
    } ]
  }, {
    "tStartMs": 45540,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "Tabi meleklerin bir de bu smart money ya da"
    } ]
  }, {
    "tStartMs": 48150,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "akıllı para dediğimiz kendi kültürel, sosyal"
    } ]
  }, {
    "tStartMs": 52170,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "ya da entelektüel sermayesini katması da söz"
    } ]
  }, {
    "tStartMs": 55020,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "konusu. Sadece para vermesi değil, işin"
    } ]
  }, {
    "tStartMs": 57630,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "içinde olması ki benim de biliyorsun tercihim"
    } ]
  }, {
    "tStartMs": 61830,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "o yönde. Ama mümkünse belli bir süre sonra"
    } ]
  }, {
    "tStartMs": 65850,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "ikincil pazar dediğimiz daha büyük sermayenin"
    } ]
  }, {
    "tStartMs": 68970,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "girdiği durumda hisselerinin tamamını ya da"
    } ]
  }, {
    "tStartMs": 71370,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "bir kısmını satıp yeni yine erken aşamaları"
    } ]
  }, {
    "tStartMs": 74730,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "girmesi şeklinde. Yani bir melek yatırımcının"
    } ]
  }, {
    "tStartMs": 76620,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "bakış açısı genelde çok basit olarak bu."
    } ]
  }, {
    "tStartMs": 79350,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "Bu melekler tek başlarına da hareket"
    } ]
  }, {
    "tStartMs": 81000,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "edebiliyorlar, grup halinde de hareket edebiliyorlar."
    } ]
  }, {
    "tStartMs": 83500,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "Melek yatırım ağları diye geçiyor."
    } ]
  }, {
    "tStartMs": 85770,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "Bu gruplar da ayrı ayrı birey olarak"
    } ]
  }, {
    "tStartMs": 88380,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "yatırım yapabiliyorlar veya bir şirket kurup"
    } ]
  }, {
    "tStartMs": 90330,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "onun üzerinden de yatırım yapabiliyorlar."
    } ]
  }, {
    "tStartMs": 92400,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "Ama bu fonlardan ya da VC dediğimiz girişim"
    } ]
  }, {
    "tStartMs": 95730,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "sermayesi fonlarından farklı bir modeldir."
    } ]
  }, {
    "tStartMs": 99120,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "Melek yatırım ağlarının aslında bazen odak alanları olabiliyor."
    } ]
  }, {
    "tStartMs": 104430,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "Keza melek yatırımcıların da odak alanları olabiliyor."
    } ]
  }, {
    "tStartMs": 107580,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "Sadece spesifik konulara yatırım yapan çünkü"
    } ]
  }, {
    "tStartMs": 110040,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "biraz entellektüel sermayesine sosyal"
    } ]
  }, {
    "tStartMs": 111930,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "sermayesini de kullanması gerektiği bir alan"
    } ]
  }, {
    "tStartMs": 114480,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "olduğu için belli alanlar seçebiliyorlar."
    } ]
  }, {
    "tStartMs": 116630,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "O yüzden sizde bir melek yatırımcı veya melek"
    } ]
  }, {
    "tStartMs": 119250,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "yatırım ağı, yine yatırım fonlarında da"
    } ]
  }, {
    "tStartMs": 121650,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "VC'ler de de bu geçerli. Ama odak alanınızın"
    } ]
  }, {
    "tStartMs": 125550,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "içinde olan kişilere ve kurumlara ve gruplara"
    } ]
  }, {
    "tStartMs": 129090,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "yaklaşmak, o şekilde operasyonunu yapmak"
    } ]
  }, {
    "tStartMs": 132240,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "mantıklı olacaktır. Melek yatırım ağlarında"
    } ]
  }, {
    "tStartMs": 134760,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "deyinmemiz gereken başka bir detay var mı?"
    } ]
  }, {
    "tStartMs": 138240,
    "dDurationMs": 5190,
    "segs": [ {
      "utf8": "Şöyle, aslında genel son birkaç yıldır bir,"
    } ]
  }, {
    "tStartMs": 143430,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "bir yeni bir eğilim, yeni bir yönlenme, yeni"
    } ]
  }, {
    "tStartMs": 145980,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "bir trend var. O da şu bütün burada"
    } ]
  }, {
    "tStartMs": 148650,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "anlattığımız ve anlatacağımız kurallar da"
    } ]
  }, {
    "tStartMs": 150930,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "değişiyor yavaş yavaş melekler de farklı"
    } ]
  }, {
    "tStartMs": 153690,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "davranmaya başladı. Melek yatırım ağları da"
    } ]
  }, {
    "tStartMs": 155700,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "farklı davranmaya başladı VC'ler de hatta"
    } ]
  }, {
    "tStartMs": 158160,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "private equity dediğimiz artık iyice gelişmiş"
    } ]
  }, {
    "tStartMs": 160980,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "şirketlere yatırım yapıp, hatta çoğunluğunu"
    } ]
  }, {
    "tStartMs": 163770,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "alıp sonra bir süre sonra satıp çıkmak"
    } ]
  }, {
    "tStartMs": 167340,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "modeline dönme modelinden çıkmaya başladılar."
    } ]
  }, {
    "tStartMs": 170620,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "Ne yapıyorlar? Erken aşama yatırım yapıyor."
    } ]
  }, {
    "tStartMs": 173340,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "Private equity'ler bugün normalde 40- 50"
    } ]
  }, {
    "tStartMs": 176820,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "milyon dolardan aşağı bir seferde bir şirkete"
    } ]
  }, {
    "tStartMs": 179880,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "yatırım yapan şirketler şu anda 3-5 milyon"
    } ]
  }, {
    "tStartMs": 182010,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "dolarlık yeni kurulmuş oyun stüdyolarına"
    } ]
  }, {
    "tStartMs": 184800,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "yatırım yapıyorlar mesela. Dolayısıyla onu"
    } ]
  }, {
    "tStartMs": 186720,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "bir kenara koyarsak. Ama bu da önemli bir"
    } ]
  }, {
    "tStartMs": 188850,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "faktör çünkü, yani 2-3 sene önce birisi gelip"
    } ]
  }, {
    "tStartMs": 193350,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "de yeni kurulmuş şirket ben VC'lere gideceğim"
    } ]
  }, {
    "tStartMs": 195750,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "derse ben diyordum ki ya vakit kaybı yani yazık."
    } ]
  }, {
    "tStartMs": 199700,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "Onun da zamanına yazık. Öyle değil artık."
    } ]
  }, {
    "tStartMs": 202320,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "Mutlaka artık hiçbir VC kimseye hayır demiyor."
    } ]
  }, {
    "tStartMs": 207050,
    "dDurationMs": 2570,
    "segs": [ {
      "utf8": "Neredeyse PE'ler bile private"
    } ]
  }, {
    "tStartMs": 209620,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "equity'ler bile o noktaya geldi. Ama yine de"
    } ]
  }, {
    "tStartMs": 212030,
    "dDurationMs": 4680,
    "segs": [ {
      "utf8": "bunu göz ardı etmeyip etmeyelim deyip normal"
    } ]
  }, {
    "tStartMs": 216710,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "şeye dönelim biz daha geçmişteki modele dönelim."
    } ]
  }, {
    "tStartMs": 221060,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "Meleklerin özellikleri şunlar."
    } ]
  }, {
    "tStartMs": 222800,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "Koydukları bir şirkete koydukları para"
    } ]
  }, {
    "tStartMs": 224660,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "miktarı genellikle küçük, küçükten kastımız"
    } ]
  }, {
    "tStartMs": 227330,
    "dDurationMs": 6540,
    "segs": [ {
      "utf8": "işte bugünün parasıyla 50-100 bin TL. Belki 150 bin TL."
    } ]
  }, {
    "tStartMs": 234650,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "Bir şirkete bir seferde koyduğu genellikle"
    } ]
  }, {
    "tStartMs": 237710,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "melekler de bir seferde yetiniyor."
    } ]
  }, {
    "tStartMs": 240050,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "Bazen 2 sefer, bazen 3 seferde bu takip yatırımlarını"
    } ]
  }, {
    "tStartMs": 244040,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "yapabiliyorlar. Following yatırım dedikleri"
    } ]
  }, {
    "tStartMs": 245990,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "ki bu VC'ler için yani girişim sermayesi"
    } ]
  }, {
    "tStartMs": 249200,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "fonlar için çok standart. Genellikle bir"
    } ]
  }, {
    "tStartMs": 251450,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "sefer yatırım yapmak istemez onlar kendi"
    } ]
  }, {
    "tStartMs": 253850,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "hisselerini korumak, hatta bazen arttırmak"
    } ]
  }, {
    "tStartMs": 255950,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "için daha sonraki yatırım turlarına da"
    } ]
  }, {
    "tStartMs": 258290,
    "dDurationMs": 4290,
    "segs": [ {
      "utf8": "girerler. Meleklerin küçük miktarlarda"
    } ]
  }, {
    "tStartMs": 262580,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "yatırmasının bir çıktısı olarak da aslında"
    } ]
  }, {
    "tStartMs": 265280,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "aşama geliyor değil mi? Erken aşamada iki şey"
    } ]
  }, {
    "tStartMs": 268490,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "giriyor. Bir aşama, iki çok sayıda. Çünkü"
    } ]
  }, {
    "tStartMs": 271700,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "erken aşamanın riski daha yüksek ya, yani ne"
    } ]
  }, {
    "tStartMs": 273800,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "kadar erken giriyorsan o şirketin başarısız"
    } ]
  }, {
    "tStartMs": 276020,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "olma ihtimali istatistiksel olarak, kişi,"
    } ]
  }, {
    "tStartMs": 279140,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "pazar üründen bağımsız olarak düşük."
    } ]
  }, {
    "tStartMs": 283440,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "Hatta ben hep şey diyorum biliyorsun piyasada"
    } ]
  }, {
    "tStartMs": 286740,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "bir şey var ya. Yüzde 90 başarısız oluyor bunlar."
    } ]
  }, {
    "tStartMs": 290190,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "Yani istatistiksel olarak doğru."
    } ]
  }, {
    "tStartMs": 292260,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "Ama ben ona şunu ekliyorum. Evet o girişimci de"
    } ]
  }, {
    "tStartMs": 295110,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "%90 başarısız olabiliyor ama o girişimci"
    } ]
  }, {
    "tStartMs": 297540,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "yüzde 90 devam ediyor. Bunu unutmamak gerekiyor."
    } ]
  }, {
    "tStartMs": 300600,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "O girişim başka bir girişim kuruyor ve devam ediyor."
    } ]
  }, {
    "tStartMs": 302850,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "O ilişkileri korumakta hep önemli oluyor."
    } ]
  }, {
    "tStartMs": 304730,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "Onun için yani burada girişime"
    } ]
  }, {
    "tStartMs": 306390,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "yatırım gibi yapıyorsun şirkete koyuyorsun"
    } ]
  }, {
    "tStartMs": 309420,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "paranı ya da diğer sermayelerini."
    } ]
  }, {
    "tStartMs": 311580,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Ama aslında girişimciye yapıyor olman gerekiyor."
    } ]
  }, {
    "tStartMs": 314220,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Öyle bakman gerekir. Erken aşama için."
    } ]
  }, {
    "tStartMs": 316890,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "Platform demişken ve erken aşama demişken, aslında"
    } ]
  }, {
    "tStartMs": 320250,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "trend de demişken, büyüyen bir konu daha var."
    } ]
  }, {
    "tStartMs": 324180,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "O da kitlesel fonlama konusu."
    } ]
  }, {
    "tStartMs": 326060,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "Oraya nasıl yaklaşmak lazım? Evet, şu anda Türkiye'de"
    } ]
  }, {
    "tStartMs": 329730,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "yeni olmakla beraber bence erken aşamanın kurtarıcısı."
    } ]
  }, {
    "tStartMs": 334350,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "Niye kurtarıcısı diyorum? Çünkü bir regüle."
    } ]
  }, {
    "tStartMs": 336780,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Yani Sermaye Piyasaları Kurulu"
    } ]
  }, {
    "tStartMs": 339180,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "SPK'ya bağlı bir mekanizma tarafından"
    } ]
  }, {
    "tStartMs": 341880,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "yapılıyor bu yatırım. Yani hem yatırımı yapan"
    } ]
  }, {
    "tStartMs": 344970,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "SPK güvencesinde hem de alan SPK güvencesinde."
    } ]
  }, {
    "tStartMs": 347820,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Bu çok kritik bir bence faktör"
    } ]
  }, {
    "tStartMs": 350670,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "ve çok büyüyeceğini düşünüyorum ben bu alanın."
    } ]
  }, {
    "tStartMs": 353550,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Melek yatırımcılara da bence bu fırsat olacak."
    } ]
  }, {
    "tStartMs": 355950,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "Önce tehdit gibi görünüyor ama bence fırsat bu. Niye?"
    } ]
  }, {
    "tStartMs": 358710,
    "dDurationMs": 4410,
    "segs": [ {
      "utf8": "Çünkü direk kendin uğraşacağına hukuki ödemeler"
    } ]
  }, {
    "tStartMs": 363120,
    "dDurationMs": 3050,
    "segs": [ {
      "utf8": "hisselerin sana gelmesi gibi şeyleri bir platform yapıyor"
    } ]
  }, {
    "tStartMs": 366170,
    "dDurationMs": 3130,
    "segs": [ {
      "utf8": "senin için bunu ve devletin damgası var,"
    } ]
  }, {
    "tStartMs": 369300,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "üstünde onayı var. Bence çok çok önemli."
    } ]
  }, {
    "tStartMs": 371580,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "Yani ben bundan sonra büyük ölçüde oradan yatırım"
    } ]
  }, {
    "tStartMs": 374310,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "yapacağım diye hissediyorum."
    } ]
  }, {
    "tStartMs": 375960,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Hatta da başladım da başladığını biliyorum."
    } ]
  }, {
    "tStartMs": 379050,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "Aslında kitlesel fonlama platformları burada"
    } ]
  }, {
    "tStartMs": 383970,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "kişilerin yerini alıyor. Kitlesel fonlama"
    } ]
  }, {
    "tStartMs": 386280,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "platformları, melek yatırımcılar, melek"
    } ]
  }, {
    "tStartMs": 388680,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "yatırımcı grupları ve daha sonra aslında"
    } ]
  }, {
    "tStartMs": 391920,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "biraz bu sıralama şeye göre de gidiyor."
    } ]
  }, {
    "tStartMs": 395070,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "Şirketin büyüklüğüne göre de gidiyor,"
    } ]
  }, {
    "tStartMs": 396690,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "aşamasına göre de gidiyor."
    } ]
  }, {
    "tStartMs": 398310,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "Bundan sonra da yatırım fonları geliyor."
    } ]
  }, {
    "tStartMs": 399780,
    "dDurationMs": 4660,
    "segs": [ {
      "utf8": "Evet burada 50 lira hatta 1 lira bile yatırım yapabiliyorsun"
    } ]
  }, {
    "tStartMs": 404440,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "yatırımcı tarafında baktığında."
    } ]
  }, {
    "tStartMs": 406900,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "İşte nitelikli yatırımcı değilsen yani gelirlerini"
    } ]
  }, {
    "tStartMs": 409950,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "bir şekilde dökümante etmediyse 50.000 liraya"
    } ]
  }, {
    "tStartMs": 412050,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "kadar yatırım yapabiliyorsun. Toplamda da bir"
    } ]
  }, {
    "tStartMs": 414720,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "şirketin alabileceği yatırım on bir milyon TL"
    } ]
  }, {
    "tStartMs": 418440,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "az değil yani. Buradaki değerleme yani onun"
    } ]
  }, {
    "tStartMs": 421470,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "karşılığında yüzde kaç hisse vereceğini de"
    } ]
  }, {
    "tStartMs": 424560,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "girişim girişimci karar veriyor, platform"
    } ]
  }, {
    "tStartMs": 428310,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "okay'liyor ve yayınlıyor."
    } ]
  }, {
    "tStartMs": 430050,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Bu da bir pazar yeri aslında. Burada satılan şeyler,"
    } ]
  }, {
    "tStartMs": 433050,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "hisseler,satan şirket yani girişim alan da"
    } ]
  }, {
    "tStartMs": 437220,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "yatırımcı burada. Ya da melek ya da başka bir"
    } ]
  }, {
    "tStartMs": 440130,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "şey olması gerekmiyor. Birey olması gerekiyor."
    } ]
  }, {
    "tStartMs": 442080,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "Kurum da yapabilirsin ama aslolan"
    } ]
  }, {
    "tStartMs": 444690,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "burada bireyin kararıyla oluyor."
    } ]
  }, {
    "tStartMs": 446280,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "Bunu da söylemiş olalım. Kitlesel fonlama aslında"
    } ]
  }, {
    "tStartMs": 449550,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "dediğin gibi SPK ve devlet regülasyonlarından"
    } ]
  }, {
    "tStartMs": 453090,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "daha çok yeni geçmeye ve popülerleşmeye başladı."
    } ]
  }, {
    "tStartMs": 457140,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "O yüzden kitlesel fonlamaya bu denli"
    } ]
  }, {
    "tStartMs": 460380,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "derin girmemizin sebeplerinden biri buydu."
    } ]
  }, {
    "tStartMs": 462810,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "Bir de inanmamız da aslında. Tamam, melek"
    } ]
  }, {
    "tStartMs": 465750,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "yatırımcıları aslında konuştuk ama erken"
    } ]
  }, {
    "tStartMs": 468750,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "aşamada girişimleri hızlandıran başka"
    } ]
  }, {
    "tStartMs": 471990,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "platformlar da var. Bunlardan biri de"
    } ]
  }, {
    "tStartMs": 474210,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "hızlandırıcılar ve kuluçka merkezleri."
    } ]
  }, {
    "tStartMs": 476460,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "Onların yatırım süreçlerine dahiliyeti nedir?"
    } ]
  }, {
    "tStartMs": 479070,
    "dDurationMs": 5560,
    "segs": [ {
      "utf8": "Güzel nokta bunlar batı'da, Amerika'da"
    } ]
  }, {
    "tStartMs": 484630,
    "dDurationMs": 4050,
    "segs": [ {
      "utf8": "özellikle çok yaygın ve artık oturmuş sistemler."
    } ]
  }, {
    "tStartMs": 488680,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "Türkiye'de de epeyce bir zamandır var."
    } ]
  }, {
    "tStartMs": 492790,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "Ve bunlar da yatırım yapıyo aslında"
    } ]
  }, {
    "tStartMs": 494500,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "hepsi yapmıyor ama bazıları yapıyor, bazıları"
    } ]
  }, {
    "tStartMs": 496450,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "da yatırım yapma opsiyonu alıyor."
    } ]
  }, {
    "tStartMs": 498490,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "Yaptığı şey aslında senin gelişmene bizim bu eğitimde"
    } ]
  }, {
    "tStartMs": 500920,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "yapmaya çalıştığımız şeyi onlar belli bir"
    } ]
  }, {
    "tStartMs": 502780,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "dönemde fiziksel ya da online olarak programa"
    } ]
  }, {
    "tStartMs": 507430,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "alıp girişimleri, diğer sermaye tiplerini,"
    } ]
  }, {
    "tStartMs": 510850,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "yani sosyal, entelektüel, kültürel gibi"
    } ]
  }, {
    "tStartMs": 513130,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "sermaye tiplerini genellikle karşılıksız,"
    } ]
  }, {
    "tStartMs": 515380,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "bazen hisse alma opsiyonu ama bazen de hisse"
    } ]
  }, {
    "tStartMs": 517450,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "alarak yapıyor. Bazen de bazıları da para da"
    } ]
  }, {
    "tStartMs": 519760,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "veriyor bunun için yani dolayısıyla ortak"
    } ]
  }, {
    "tStartMs": 521830,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "oluyor, yatırım yapıyorlar, finansal"
    } ]
  }, {
    "tStartMs": 523570,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "yatırımda yapıyorlar. Bunları da araştırmak"
    } ]
  }, {
    "tStartMs": 527320,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "da fayda var. Oyun dünyasında da çok yeni ama"
    } ]
  }, {
    "tStartMs": 531040,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "o da başladı Türkiye'de, dünyada yine çok örneği var."
    } ]
  }, {
    "tStartMs": 534200,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "Ona da bakmakta yarar var diye düşünüyorum."
    } ]
  }, {
    "tStartMs": 536280,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "Bu dersi burada bitirelim."
    } ]
  }, {
    "tStartMs": 538000,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "Bir sonraki derste yatırım fonlarının detayıyla"
    } ]
  }, {
    "tStartMs": 539980,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "devam edelim, anlaştık."
    } ]
  } ]
}
