  "events": [ {
    "tStartMs": 2270,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "Hepiniz hoş geldiniz."
    } ]
  }, {
    "tStartMs": 3500,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "Bu modülde validasyon, iterasyon ve pivot"
    } ]
  }, {
    "tStartMs": 6410,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "konuşuyoruz. Ama tabii ki bunlar ne bir onu"
    } ]
  }, {
    "tStartMs": 9770,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "konuşalım önce."
    } ]
  }, {
    "tStartMs": 10790,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "Ömer abi bu modülde neler öğreneceğiz?"
    } ]
  }, {
    "tStartMs": 12920,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "Doğrulama demek ya da validasyon, neyi"
    } ]
  }, {
    "tStartMs": 15440,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "doğrulayacağız konuşacağız,"
    } ]
  }, {
    "tStartMs": 17840,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "doğrulayamadığımız zaman küçük değişiklikler"
    } ]
  }, {
    "tStartMs": 20360,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "yapmayı yani iterasyonu konuşacağız."
    } ]
  }, {
    "tStartMs": 22760,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "Küçük değişiklikler bizi çıkmaz sokağa"
    } ]
  }, {
    "tStartMs": 25850,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "soktuysa yön değiştirme, yol değiştirmeyi"
    } ]
  }, {
    "tStartMs": 28490,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "yani pivotu konuşacağız."
    } ]
  }, {
    "tStartMs": 30230,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "Aslında yön belirleme değiştirme yöntemleri"
    } ]
  }, {
    "tStartMs": 33530,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "nelerdir? Validasyon yani doğrulama, hangi"
    } ]
  }, {
    "tStartMs": 36980,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "yoldan gideceğimiz iterasyon yön belirleme,"
    } ]
  }, {
    "tStartMs": 40220,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "o yoldan nasıl gideceğiz veya farklı"
    } ]
  }, {
    "tStartMs": 42470,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "değişiklikler yapacak mıyız, pivot yönümüzü"
    } ]
  }, {
    "tStartMs": 45530,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "tamamen değiştirme veya küçük yani büyük"
    } ]
  }, {
    "tStartMs": 48140,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "değişiklikler yapma ve bu değişiklikleri"
    } ]
  }, {
    "tStartMs": 50300,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "yapmalı mıyız, yapmamalı mıyız?"
    } ]
  }, {
    "tStartMs": 52130,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "Biraz bunlardan bahsedeceğiz."
    } ]
  }, {
    "tStartMs": 53810,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "Hatta sadece yön ya da yol değil, araç da"
    } ]
  }, {
    "tStartMs": 55910,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "değiştirebilirsiniz. Yani pivot daha daha"
    } ]
  }, {
    "tStartMs": 58400,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "radikal. Burada kritik olan şey şu esas"
    } ]
  }, {
    "tStartMs": 61100,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "fikri değiştirmiyoruz."
    } ]
  }, {
    "tStartMs": 62990,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "Fikrin gerçekleştirilmesinin önündeki"
    } ]
  }, {
    "tStartMs": 66170,
    "dDurationMs": 4710,
    "segs": [ {
      "utf8": "engelleri doğrulamalarla kaldırarak"
    } ]
  }, {
    "tStartMs": 71030,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "kanıtlamaya ya da değiştirmeye çalışıyoruz."
    } ]
  }, {
    "tStartMs": 73430,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "Validasyon için her aşamada farklı"
    } ]
  }, {
    "tStartMs": 77420,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "hipotezleri, yani varsayımları belirlemek"
    } ]
  }, {
    "tStartMs": 80000,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "önemli. Fikir aşamasında benim varsaydığım"
    } ]
  }, {
    "tStartMs": 83240,
    "dDurationMs": 4230,
    "segs": [ {
      "utf8": "problem gerçek mi MVP aşamasında varsaydığım"
    } ]
  }, {
    "tStartMs": 87470,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "çözüm uygun mu? Büyüme aşamasında"
    } ]
  }, {
    "tStartMs": 90830,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "varsaydığım kanallar uygun mu sorularını"
    } ]
  }, {
    "tStartMs": 94430,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "cevaplayabiliriz. Pivot etmek biraz daha"
    } ]
  }, {
    "tStartMs": 96860,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "özellikle erken aşamalarda yeni nesil"
    } ]
  }, {
    "tStartMs": 98900,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "girişimlerin fikir değiştirmesiyle"
    } ]
  }, {
    "tStartMs": 101450,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "karıştırılmaması gereken bir konsept."
    } ]
  }, {
    "tStartMs": 104780,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "Burada bir aslında şey var, vakamız var."
    } ]
  }, {
    "tStartMs": 108290,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "Hepimizin kullandığı, muhtemelen"
    } ]
  }, {
    "tStartMs": 111260,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "katılımcıların da kullandığı Slack"
    } ]
  }, {
    "tStartMs": 113000,
    "dDurationMs": 4050,
    "segs": [ {
      "utf8": "uygulaması. İlk başta Glitch isimli bir"
    } ]
  }, {
    "tStartMs": 117050,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "video oyununu yapmak için büyük bir yatırım"
    } ]
  }, {
    "tStartMs": 119390,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "alıyorlar. Ama sonra bir gecede 100 kişilik"
    } ]
  }, {
    "tStartMs": 122660,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "hali hazırda 100 kişi olmuş bir ekip bir"
    } ]
  }, {
    "tStartMs": 125810,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "anda karar değiştiriyor ve 180 derece"
    } ]
  }, {
    "tStartMs": 129620,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "değişim yapıyor. Bunu aslında pivot"
    } ]
  }, {
    "tStartMs": 131360,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "diyebiliriz. Bir video oyunu yaparken bir"
    } ]
  }, {
    "tStartMs": 133460,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "mesajlaşma uygulaması yapmak tamamen"
    } ]
  }, {
    "tStartMs": 137360,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "değiştirmek oluyor olabilir."
    } ]
  }, {
    "tStartMs": 138650,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "Evet ama bu radikal bir pivot."
    } ]
  }, {
    "tStartMs": 140690,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "Radikal. Büyük ihtimalle de onlar video oyunu"
    } ]
  }, {
    "tStartMs": 144320,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "yaparken aslında verimli iletişim"
    } ]
  }, {
    "tStartMs": 148220,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "kuramadıklarını, grup çalışması"
    } ]
  }, {
    "tStartMs": 150410,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "yapamadıklarını fark edip, ya böyle bir araç"
    } ]
  }, {
    "tStartMs": 152990,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "yok, hadi bunu da yapalım demiş olabilirler"
    } ]
  }, {
    "tStartMs": 155570,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": ". Demiş olabilirler. Burada problemden yola"
    } ]
  }, {
    "tStartMs": 159290,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "çıkmak konumuza her zaman atıf da yapıyoruz"
    } ]
  }, {
    "tStartMs": 162710,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "zaten."
    } ]
  }, {
    "tStartMs": 163790,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "Kendi probleminizi çözmek de bu işin"
    } ]
  }, {
    "tStartMs": 165860,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "başlangıç noktalarından bir tanesi olabilir."
    } ]
  }, {
    "tStartMs": 168170,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "Dalton Caltwell'in de dediği gibi"
    } ]
  }, {
    "tStartMs": 171320,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "ilerlemeyen bir şey üzerinde çalışarak ve"
    } ]
  }, {
    "tStartMs": 173840,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "bunu validasyon adımlarında kanıtlayarak"
    } ]
  }, {
    "tStartMs": 176630,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "daha iyi bir şey yapmamanın maliyetine"
    } ]
  }, {
    "tStartMs": 178880,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "katlanıyorsunuz. Ve aslında bu değişiklikler"
    } ]
  }, {
    "tStartMs": 183410,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "pivot kararına da sebebiyet verebiliyor."
    } ]
  }, {
    "tStartMs": 185990,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "İşte fırsat maliyeti kavramı aslında çok"
    } ]
  }, {
    "tStartMs": 188030,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "basit ve her, hayatın her aşamasında var"
    } ]
  }, {
    "tStartMs": 190610,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "olması gereken bir kavram."
    } ]
  }, {
    "tStartMs": 191840,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "Aynen öyle. Burada senin çok sevdiğin bir"
    } ]
  }, {
    "tStartMs": 194720,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "soru var aslında. Seni tanıdığımdan beri"
    } ]
  }, {
    "tStartMs": 197570,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "herkese ve her an sorduğun kaç oldu sorusu"
    } ]
  }, {
    "tStartMs": 201500,
    "dDurationMs": 4350,
    "segs": [ {
      "utf8": "var. Bunu da belki kaç oldudan ne demek"
    } ]
  }, {
    "tStartMs": 205850,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "istediğini bahsedebilirsin."
    } ]
  }, {
    "tStartMs": 207840,
    "dDurationMs": 4180,
    "segs": [ {
      "utf8": "Şimdi ölçmediğin şeyi yönetemezsiniz diye bir"
    } ]
  }, {
    "tStartMs": 212020,
    "dDurationMs": 2590,
    "segs": [ {
      "utf8": "klişe var ya. Buradaki konu o."
    } ]
  }, {
    "tStartMs": 214610,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "Varsayım yaptın dedin ki işte bunu bunu bunu"
    } ]
  }, {
    "tStartMs": 217690,
    "dDurationMs": 4590,
    "segs": [ {
      "utf8": "yaparsam şu 5 olacak yaptın 5 olmadı ama 5"
    } ]
  }, {
    "tStartMs": 222280,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "olmadığını anlamak için sürekli kaç oldu"
    } ]
  }, {
    "tStartMs": 223870,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "diye sorman lazım. Baktın bir türlü artmıyor"
    } ]
  }, {
    "tStartMs": 227110,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "işte. 1 oldu 1 oldu, 1 oldu, 2 oldu, 2 oldu,"
    } ]
  }, {
    "tStartMs": 229510,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "2 oldu, 3 oldu 3 oldu."
    } ]
  }, {
    "tStartMs": 230650,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "Demin Dalton'un da dediği gibi bir dakika"
    } ]
  }, {
    "tStartMs": 234370,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "biz yanlış yoldayız galiba."
    } ]
  }, {
    "tStartMs": 236480,
    "dDurationMs": 3530,
    "segs": [ {
      "utf8": "Dolayısıyla kaç oldu buradaki en temel araç"
    } ]
  }, {
    "tStartMs": 240490,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "hem doğrulama için, hem iterasyon için hem"
    } ]
  }, {
    "tStartMs": 242830,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "de pivot için. Doğrulama onayını alırken"
    } ]
  }, {
    "tStartMs": 245590,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "veya iterasyon pivot kararlarını alırken kaç"
    } ]
  }, {
    "tStartMs": 248320,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "olduğu da belirlediğin birincil ve ikincil"
    } ]
  }, {
    "tStartMs": 251590,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "metriklere sürekli bakıyor olmanın sonucu"
    } ]
  }, {
    "tStartMs": 254380,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "aslında bunlar. Senin daha demin saydığın"
    } ]
  }, {
    "tStartMs": 257410,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "bir, bir, bir, iki, iki, üç, bir, bir, iki,"
    } ]
  }, {
    "tStartMs": 260590,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "bir, üç gibi dengesiz giden ve aslında belli"
    } ]
  }, {
    "tStartMs": 264580,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "bir grafiğe göre ölçülemeyen herhangi bir"
    } ]
  }, {
    "tStartMs": 267100,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "metriğiniz varsa bu metrikler neler olabilir"
    } ]
  }, {
    "tStartMs": 269620,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "Ömer Abi? Mesela satış olabilir."
    } ]
  }, {
    "tStartMs": 271750,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "Satış olabilir. Başka, işinde bir de şey"
    } ]
  }, {
    "tStartMs": 275470,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "derler ya hani satıştan kaçma ama satışa da"
    } ]
  }, {
    "tStartMs": 278050,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "aldanma. Yani satıyorsun."
    } ]
  }, {
    "tStartMs": 280000,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "Ama işte deminki gibi bir, bir, bir, iki,"
    } ]
  }, {
    "tStartMs": 282370,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "iki bir, bir bir diye gidiyor."
    } ]
  }, {
    "tStartMs": 284080,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Demek ki aslında satış yapıyorum ama"
    } ]
  }, {
    "tStartMs": 287550,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "istediğim kadar ya da istediğim yönde"
    } ]
  }, {
    "tStartMs": 289170,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "yapamıyorum. O zaman kendimi aldatmayalım."
    } ]
  }, {
    "tStartMs": 291780,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "Bu bir çuvallamadır aslında."
    } ]
  }, {
    "tStartMs": 293660,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "Çuvalla ilk iterasyonu."
    } ]
  }, {
    "tStartMs": 295680,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "Peki şimdilik satış yapmayalım da sattığımız"
    } ]
  }, {
    "tStartMs": 298410,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "kullanıcılar ya da müşterilerin"
    } ]
  }, {
    "tStartMs": 301980,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "deneyimlerini izleyelim."
    } ]
  }, {
    "tStartMs": 303930,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "Orada bir sorun varsa onu düzeltelim."
    } ]
  }, {
    "tStartMs": 306000,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "Bir örnek bu mesela."
    } ]
  }, {
    "tStartMs": 307620,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Bir örnek bu olabilir. Kullanıcı sayısı,"
    } ]
  }, {
    "tStartMs": 309420,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "özellikle oyunlarda kullanıcı sayısı öne"
    } ]
  }, {
    "tStartMs": 313380,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "çıkan bir metrik, öne çıkan bir birincil"
    } ]
  }, {
    "tStartMs": 315180,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "metrik olabiliyor. Veya ekran süresi."
    } ]
  }, {
    "tStartMs": 317070,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "Bunlar birincil veya ikinci önemli"
    } ]
  }, {
    "tStartMs": 318960,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "metriklerden bazıları."
    } ]
  }, {
    "tStartMs": 320520,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "Bazen tamamen çuvallamış bir yeni nesil bir"
    } ]
  }, {
    "tStartMs": 322590,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "girişim çok az satışı olan bu, daha demin"
    } ]
  }, {
    "tStartMs": 325740,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "örneğini verdiğimiz yönde giden bir yeni"
    } ]
  }, {
    "tStartMs": 329280,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "nesil girişimden daha avantajlı olabilir."
    } ]
  }, {
    "tStartMs": 331970,
    "dDurationMs": 2470,
    "segs": [ {
      "utf8": "Tamamen çuvallamış girişim neyi çöpe"
    } ]
  }, {
    "tStartMs": 334440,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "atacağını bilir ve yoluna devam edebilir."
    } ]
  }, {
    "tStartMs": 337050,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "Ama çok da hızlı artmayan, satışlara aldanan"
    } ]
  }, {
    "tStartMs": 339810,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "diğer girişim biraz da dezavantajlı konumda"
    } ]
  }, {
    "tStartMs": 343140,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "kalabilir. Orada bu aralar çok sıkça"
    } ]
  }, {
    "tStartMs": 345930,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "kullanılan bir terim var stolap dediğimiz"
    } ]
  }, {
    "tStartMs": 350130,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "nedir stolap Ömer Abi?"
    } ]
  }, {
    "tStartMs": 351640,
    "dDurationMs": 3650,
    "segs": [ {
      "utf8": "Stolap ölçeklenemeyen, ölçeklenmeye çalışan"
    } ]
  }, {
    "tStartMs": 355300,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "yani nedir o, bir şeyler artıyor ama bunun"
    } ]
  }, {
    "tStartMs": 358860,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "maliyeti aynı hızda artmıyor."
    } ]
  }, {
    "tStartMs": 361560,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "Stolap da şu bir şeyler artıyor, maliyeti de"
    } ]
  }, {
    "tStartMs": 365010,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "yavaş artıyor ve aradaki fark değişmiyor."
    } ]
  }, {
    "tStartMs": 368250,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "Yani aslında ilerlemiyor."
    } ]
  }, {
    "tStartMs": 370140,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "Biz buna farklı platformlarda, tırnak içinde"
    } ]
  }, {
    "tStartMs": 373950,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "geleneksel büyüme de diyor."
    } ]
  }, {
    "tStartMs": 375570,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "Evet, geleneksel büyüme de diyebiliriz."
    } ]
  }, {
    "tStartMs": 377880,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "Bu geleneksel büyüme dediğimiz aslında yönde"
    } ]
  }, {
    "tStartMs": 380850,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "giden yönde büyüyen girişimler biraz mantık"
    } ]
  }, {
    "tStartMs": 383730,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "dışı hareket ediyor sayılabilir."
    } ]
  }, {
    "tStartMs": 385230,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "Neden? Aslında çok yetenekli bir ekibiniz"
    } ]
  }, {
    "tStartMs": 388530,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "veya çözmek istediğiniz çok kritik bir"
    } ]
  }, {
    "tStartMs": 390720,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "problem var. Ama siz bu geleneksel büyüme"
    } ]
  }, {
    "tStartMs": 393990,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "yönteminde sıkışıp kalırsanız"
    } ]
  }, {
    "tStartMs": 396630,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "ölçeklenebilecek bir iş modelininden"
    } ]
  }, {
    "tStartMs": 398340,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "uzaklaşmış oluyorsunuz."
    } ]
  }, {
    "tStartMs": 399480,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Aslında bu bir tuzak gibi görünebilir."
    } ]
  }, {
    "tStartMs": 402090,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Evet, bu bir tuzak aslında."
    } ]
  }, {
    "tStartMs": 404400,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "Çünkü mesela kaç oldu sorusunun cevabını"
    } ]
  }, {
    "tStartMs": 408510,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "veriyorsun. Aslında fena da gitmiyor,"
    } ]
  }, {
    "tStartMs": 410490,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "artıyor ama artmaması gereken şeyler de"
    } ]
  }, {
    "tStartMs": 413550,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "artıyor. Örneğin maliyetlerin de aynı"
    } ]
  }, {
    "tStartMs": 415140,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "şekilde artıyor. Dolayısıyla o aradaki fark,"
    } ]
  }, {
    "tStartMs": 417060,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "demin de söylediğimiz gibi açılmıyor."
    } ]
  }, {
    "tStartMs": 419940,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "Yani ölçeklenmek ne demek?"
    } ]
  }, {
    "tStartMs": 421500,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "Getiriler yukarıya doğru götürüler,"
    } ]
  }, {
    "tStartMs": 425100,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "maliyetler düz gidiyor olması lazım."
    } ]
  }, {
    "tStartMs": 427920,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "Şimdi burada kanvasa bakmak lazım."
    } ]
  }, {
    "tStartMs": 432130,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "Kanvastan kastımız yalın ya da iş modeli"
    } ]
  }, {
    "tStartMs": 434070,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "kanvası. Kanvasımız yani bizim yaptığımız"
    } ]
  }, {
    "tStartMs": 437760,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "işi tek sayfada özetlediğimiz şey iş modeli"
    } ]
  }, {
    "tStartMs": 440100,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "ya da yalın kanvas farketmez, oradaki değer"
    } ]
  }, {
    "tStartMs": 443040,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "önerisi kutucuğu burada kritik."
    } ]
  }, {
    "tStartMs": 445230,
    "dDurationMs": 4590,
    "segs": [ {
      "utf8": "Şimdi yaptığımız diyelim iterasyonlarla şunu"
    } ]
  }, {
    "tStartMs": 449820,
    "dDurationMs": 3430,
    "segs": [ {
      "utf8": "anladık ki neyi değiştirirsek değiştirelim"
    } ]
  }, {
    "tStartMs": 454200,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "ölçek gelmiyor. O zaman ne yapmamız"
    } ]
  }, {
    "tStartMs": 457380,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "gerekiyor? Pivot etmemiz gerekiyor,"
    } ]
  }, {
    "tStartMs": 459990,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "iterasyon yetmediği yerde pivota gitmemiz"
    } ]
  }, {
    "tStartMs": 461700,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "gerekiyor. Orada da bakmamız gereken şey"
    } ]
  }, {
    "tStartMs": 466260,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "değer önerisini değiştirmek."
    } ]
  }, {
    "tStartMs": 468270,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "Değer önerisini değiştirdiğimiz zaman pivot"
    } ]
  }, {
    "tStartMs": 470160,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "yapıyoruz çünkü öbür türlü kanal denedin,"
    } ]
  }, {
    "tStartMs": 472230,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "işte iş ortağı denedin."
    } ]
  }, {
    "tStartMs": 474630,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "Ne bileyim ben neye ölçtüğüne baktın"
    } ]
  }, {
    "tStartMs": 476370,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "değiştirdin. Hiçbir şey bir işe yaramadı."
    } ]
  }, {
    "tStartMs": 478020,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "O zaman değer önerisi değiştireceksin, çünkü"
    } ]
  }, {
    "tStartMs": 479910,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "hepsi dönüyor neye geliyor?"
    } ]
  }, {
    "tStartMs": 481530,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "İlk başta yola çıkış nedenini, yani fikrinin"
    } ]
  }, {
    "tStartMs": 485130,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "hangi problemi çözmek olduğunu tekrar"
    } ]
  }, {
    "tStartMs": 488070,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "doğrulamak gerekiyor."
    } ]
  }, {
    "tStartMs": 490020,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "Bunun için geç mi kaldım?"
    } ]
  }, {
    "tStartMs": 491100,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Bence geç kalmadın. Hiçbir zaman geç değil."
    } ]
  }, {
    "tStartMs": 494130,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "Bütün mesele bu kararı verirken harcadığın"
    } ]
  }, {
    "tStartMs": 496350,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "zaman, yani 6 sene sonra veriyorsan geçmiş"
    } ]
  }, {
    "tStartMs": 499470,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "olsun, 6 ay sonra veriyorsan zor işin ama 6"
    } ]
  }, {
    "tStartMs": 503250,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "hafta sonra veriyorsan çok güzel bence."
    } ]
  }, {
    "tStartMs": 505380,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "Bu yüzden de aslında özellikle yeni nesil"
    } ]
  }, {
    "tStartMs": 508410,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "girişimlerde geliştirme veya bir işi"
    } ]
  }, {
    "tStartMs": 511260,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "sürdürme iki haftalık veya işte haftalık"
    } ]
  }, {
    "tStartMs": 514830,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "tırnak içinde sprintlerle koşuluyor."
    } ]
  }, {
    "tStartMs": 517980,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "Bunlar her sprintin sonunda veya her"
    } ]
  }, {
    "tStartMs": 520230,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "haftanın, her iki haftanın sonunda bazı"
    } ]
  }, {
    "tStartMs": 522720,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "şeyleri kaç olduğu sorusunu sorarak"
    } ]
  }, {
    "tStartMs": 525210,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "ölçümlemek ve bunların değerlendirmesini"
    } ]
  }, {
    "tStartMs": 527370,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "yapmakla belli oluyor."
    } ]
  }, {
    "tStartMs": 529980,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "Burada bir de aslında ilk başta değer"
    } ]
  }, {
    "tStartMs": 531930,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "önerisini değiştirmekten önce değer"
    } ]
  }, {
    "tStartMs": 533940,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "önerisini tanımlarken ve valide ederken çok"
    } ]
  }, {
    "tStartMs": 537570,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "önemli bir konu var. Bir işi sırf sadece"
    } ]
  }, {
    "tStartMs": 541590,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "büyüme potansiyeline veya oradaki finansal"
    } ]
  }, {
    "tStartMs": 545910,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "getirilere odaklanıp tırnak içinde sıkıcı"
    } ]
  }, {
    "tStartMs": 548640,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "bir işte yola çıkmak sizin bu işe baş"
    } ]
  }, {
    "tStartMs": 551640,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "koyduğunuz 10 yılı, 15 yılı aslında"
    } ]
  }, {
    "tStartMs": 554130,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "kapatmanız demek oluyor."
    } ]
  }, {
    "tStartMs": 556140,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "15 yıl içinde de tabii ki bazı haftalarda,"
    } ]
  }, {
    "tStartMs": 559350,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "bazı sprintlerde, bazı aylarda işler iyi"
    } ]
  }, {
    "tStartMs": 562980,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "gitmeyecek ve burada kendinize bir şekilde"
    } ]
  }, {
    "tStartMs": 566520,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "ilham olup kendinizi motive etmeniz"
    } ]
  }, {
    "tStartMs": 568290,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "gerekecek. Ekibinizi motive etmeniz"
    } ]
  }, {
    "tStartMs": 569910,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "gerekecek. Bu noktalarda ilk başta yola"
    } ]
  }, {
    "tStartMs": 574080,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "çıkarken kendinize bu değer önerisini"
    } ]
  }, {
    "tStartMs": 577560,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "gerçekten çözmek istiyor muyum?"
    } ]
  }, {
    "tStartMs": 579540,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "Ben bu değer önerisini kafaya takıyor muyum"
    } ]
  }, {
    "tStartMs": 581560,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "mu sormak gerekiyor diye düşünüyorum."
    } ]
  }, {
    "tStartMs": 583350,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "Ne diyorsun? Evet katılıyorum."
    } ]
  }, {
    "tStartMs": 584880,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "Burada kritik olan şey o büyümenin"
    } ]
  }, {
    "tStartMs": 587890,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "genellikle biliyorsun haftalık büyüme"
    } ]
  }, {
    "tStartMs": 589510,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "kullanılır bu işlerde."
    } ]
  }, {
    "tStartMs": 591160,
    "dDurationMs": 2810,
    "segs": [ {
      "utf8": "Ama üç hafta üst üste büyümedim deyince de"
    } ]
  }, {
    "tStartMs": 595360,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "paniklememek lazım."
    } ]
  }, {
    "tStartMs": 596800,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "Ama işte demin de konuştuğumuz gibi işte 3 4"
    } ]
  }, {
    "tStartMs": 599260,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "sprintte, 6 haftada hala büyüyemiyorsan bir"
    } ]
  }, {
    "tStartMs": 602440,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "sorun var demektir. O zaman işte dönüp değer"
    } ]
  }, {
    "tStartMs": 606100,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "önerisini gözden geçirmek gerekiyor."
    } ]
  }, {
    "tStartMs": 607780,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "Problemin tanımını gözden geçirmek"
    } ]
  }, {
    "tStartMs": 609460,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "gerekiyor. Bir de tabii konuyu dağıtmaya"
    } ]
  }, {
    "tStartMs": 611800,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "gerek yok. Ama zaman da bir parametre ya."
    } ]
  }, {
    "tStartMs": 614770,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "Yani öyle bir zaman geliyor ki, koşullar"
    } ]
  }, {
    "tStartMs": 619090,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "artık yeniden gözden geçirmeyi şart hale"
    } ]
  }, {
    "tStartMs": 621610,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "getiriyor. İterasyon ve pivot aslında her ne"
    } ]
  }, {
    "tStartMs": 624970,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "kadar yararlı konseptler olsa da yeni nesil"
    } ]
  }, {
    "tStartMs": 628540,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "girişim ekiplerinin bunları alışkanlık"
    } ]
  }, {
    "tStartMs": 630370,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "haline getirmemesi gerektiğini düşünüyorum."
    } ]
  }, {
    "tStartMs": 632440,
    "dDurationMs": 3650,
    "segs": [ {
      "utf8": "Evet, nedensiz spor olsun diye değişiklik"
    } ]
  }, {
    "tStartMs": 636100,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "yapmayacaksın. Bunlar kullanılan terimler"
    } ]
  }, {
    "tStartMs": 638740,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "olmasına rağmen sizin bu atışları yaparken,"
    } ]
  }, {
    "tStartMs": 641380,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "özellikle pivot atışını yaparken kaliteli"
    } ]
  }, {
    "tStartMs": 644680,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "kararlar vermeniz, kaliteli değerlendirmeler"
    } ]
  }, {
    "tStartMs": 646840,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "yapmanız gerekiyor. Bunun için sürekli"
    } ]
  }, {
    "tStartMs": 649660,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "fikirleri pivot edip vazgeçmek yerine, iş"
    } ]
  }, {
    "tStartMs": 652210,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "modeli kanvasının her adımıyla düşünülmüş ve"
    } ]
  }, {
    "tStartMs": 655210,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "ürün anlamında tamamlanmış müşteriyle"
    } ]
  }, {
    "tStartMs": 657880,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "buluşturulmuş, geri bildirimler alınmış ve"
    } ]
  }, {
    "tStartMs": 660460,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "hatta en kritik ürün pazar uyumu mantalitesi"
    } ]
  }, {
    "tStartMs": 663220,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "ile kısa vadeli hareket edilen yani"
    } ]
  }, {
    "tStartMs": 665470,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "sprintler ile hareket edilen bir pivot"
    } ]
  }, {
    "tStartMs": 668440,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "aslında kaliteli bir atış yerine geçebilir."
    } ]
  }, {
    "tStartMs": 670720,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "Yani bütün bu dinamikleri tutturmak"
    } ]
  }, {
    "tStartMs": 672340,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "gerekiyor. Burada ürün pazar uyumuna biraz"
    } ]
  }, {
    "tStartMs": 674590,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "değinelim istersen. Evet, ürün pazar uyumu,"
    } ]
  }, {
    "tStartMs": 678820,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "yani bağlamı tanımlamak adına hani şey"
    } ]
  }, {
    "tStartMs": 681790,
    "dDurationMs": 2990,
    "segs": [ {
      "utf8": "diyorduk ya biz değer önerimizin, kimin"
    } ]
  }, {
    "tStartMs": 684780,
    "dDurationMs": 1330,
    "segs": [ {
      "utf8": "hangi problemini çözüyorsun?"
    } ]
  }, {
    "tStartMs": 687040,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "Problemi çözüyorsan yoluna devam ediyorsun"
    } ]
  }, {
    "tStartMs": 690490,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "ama gelir elde etmeye başladığın zaman olay"
    } ]
  }, {
    "tStartMs": 694030,
    "dDurationMs": 6510,
    "segs": [ {
      "utf8": "artık sorun çözüm uyumundan, ürün pazar"
    } ]
  }, {
    "tStartMs": 700540,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "uyumuna dönüyor. Ürün pazar uyumu aslında"
    } ]
  }, {
    "tStartMs": 702760,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "çok kullanılan bir terim ama tanımlamaya"
    } ]
  }, {
    "tStartMs": 705850,
    "dDurationMs": 4340,
    "segs": [ {
      "utf8": "gelince baya zorlayan bir terim."
    } ]
  }, {
    "tStartMs": 710200,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "Benim en beğendiğim tanım şu çok işlevsel"
    } ]
  }, {
    "tStartMs": 712780,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "bir tanım bu. Eğer yapabiliyorsan biraz da"
    } ]
  }, {
    "tStartMs": 715240,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "tabi bu şey kurgusal bir şey."
    } ]
  }, {
    "tStartMs": 717190,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Eğer yapabiliyorsan ürününü kapat."
    } ]
  }, {
    "tStartMs": 720570,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "Bakalım kaç tane müşteri panik içinde seni"
    } ]
  }, {
    "tStartMs": 723060,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "arıyor tamam mı?"
    } ]
  }, {
    "tStartMs": 725400,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "Eğer kimse aramıyor olsa ürün pazar uyumu"
    } ]
  }, {
    "tStartMs": 727380,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "yoktur. Eğer çok sayıda müşteri arıyorsa"
    } ]
  }, {
    "tStartMs": 731170,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "ürün pazarı uyumu vardır."
    } ]
  }, {
    "tStartMs": 733660,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "Bunu böyle bu arada kısa denemelerle, küçük"
    } ]
  }, {
    "tStartMs": 737410,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "denemelerle de yapabilirsiniz."
    } ]
  }, {
    "tStartMs": 739300,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "Bunu ben pratik öneri tabii değil bu."
    } ]
  }, {
    "tStartMs": 741340,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Ama en azından senin anlaman için yaptığın"
    } ]
  }, {
    "tStartMs": 744340,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "işi değerlendirmek adına ben değerli"
    } ]
  }, {
    "tStartMs": 746200,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "olduğunu düşünüyorum. Bunu dediğin gibi"
    } ]
  }, {
    "tStartMs": 747640,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "herkese yapmayacaksın tabi."
    } ]
  }, {
    "tStartMs": 748690,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "Atıyorum işte 1000 tane müşterinin varsa 10"
    } ]
  }, {
    "tStartMs": 752560,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "tanesini seçeceksin, onlarda deneyeceğim"
    } ]
  }, {
    "tStartMs": 754390,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "ondan da ses çıkmıyorsa hım diyeceksin."
    } ]
  }, {
    "tStartMs": 757540,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "Ama 8'de 9'da arıyorsa o bir dakika deyip"
    } ]
  }, {
    "tStartMs": 761950,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "devam etmen lazım. Birilerinin problemini"
    } ]
  }, {
    "tStartMs": 764350,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "çözerek işe başlamak zaten bu işin ilk adımı"
    } ]
  }, {
    "tStartMs": 767380,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "olduğu için ürününüzü kapattığınızda"
    } ]
  }, {
    "tStartMs": 770050,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "durdurduğunuzda veya yavaşlattığınızda"
    } ]
  }, {
    "tStartMs": 772870,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "birilerinin bundan rahatsız olduğunu bilmek"
    } ]
  }, {
    "tStartMs": 775510,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "kanıtlamak ürün pazar uyumunun ilk"
    } ]
  }, {
    "tStartMs": 777610,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "işaretlerinden biridir diyebiliriz."
    } ]
  }, {
    "tStartMs": 780610,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "Burada kendini de aslında ikna etmek, ekip"
    } ]
  }, {
    "tStartMs": 783220,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "arkadaşlarını ve kendini ikna etmek çok"
    } ]
  }, {
    "tStartMs": 785080,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "önemli. Kendini bir değer önerisini ve"
    } ]
  }, {
    "tStartMs": 789010,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "problem çözdüğünü ikna edemiyorsan, bunun"
    } ]
  }, {
    "tStartMs": 791200,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "gerçekten işe yaramadığını biliyorsan bu"
    } ]
  }, {
    "tStartMs": 793990,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "pivot için iyi bir zaman olabilir."
    } ]
  }, {
    "tStartMs": 796660,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "İstersen bu dersi burada noktalayalım."
    } ]
  }, {
    "tStartMs": 799090,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "Birazdan validasyon, iterasyon ve pivot iş"
    } ]
  }, {
    "tStartMs": 802000,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "modeli kanvası ve yalın kanvasın"
    } ]
  }, {
    "tStartMs": 803680,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "örnekleriyle konuşalım."
    } ]
  }, {
    "tStartMs": 805750,
    "dDurationMs": 480,
    "segs": [ {
      "utf8": "Uygundur."
    } ]
  } ]
}
