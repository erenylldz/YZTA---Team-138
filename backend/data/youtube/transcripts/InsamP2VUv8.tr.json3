  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 90,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "Tekrar merhaba. Bu dersimizde artık pitch'in"
    } ]
  }, {
    "tStartMs": 3780,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "detaylarına gireceğiz."
    } ]
  }, {
    "tStartMs": 5040,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "Sayfa sayfa ne olmalı, hangi sırada olmalı,"
    } ]
  }, {
    "tStartMs": 7740,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "nasıl ilerlemeli biraz bundan bahsedeceğiz."
    } ]
  }, {
    "tStartMs": 10710,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "Bir demo day'de olduğumuzu varsayalım."
    } ]
  }, {
    "tStartMs": 13200,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "Önümüzde yatırımcılar oturuyor, potansiyel"
    } ]
  }, {
    "tStartMs": 15810,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "iş ortaklarımız oturuyor."
    } ]
  }, {
    "tStartMs": 17680,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "Biz aslında şeyi öğrendik."
    } ]
  }, {
    "tStartMs": 19770,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "Kısa sürede bu işi toparlanmamız gerekiyor."
    } ]
  }, {
    "tStartMs": 23610,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "Tek font kullanmamız, büyük fontlar, az yazı"
    } ]
  }, {
    "tStartMs": 26670,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "bol görselle kendimizi en iyi şekilde ifade"
    } ]
  }, {
    "tStartMs": 29160,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "etmemiz gerekiyor. Tabii ki bizi dinleyen"
    } ]
  }, {
    "tStartMs": 31620,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "kitleye göre de içeriğimizi ona göre"
    } ]
  }, {
    "tStartMs": 35310,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "özelleştirmemiz gerekiyor."
    } ]
  }, {
    "tStartMs": 37080,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "Peki nasıl başlıyoruz? Şöyle ben Şöyle"
    } ]
  }, {
    "tStartMs": 41640,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "anlatmaya çalışıyorum iyice basite indirgeme"
    } ]
  }, {
    "tStartMs": 43890,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "adına, indirgemek adına."
    } ]
  }, {
    "tStartMs": 45840,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "Hani dedin ya demo day."
    } ]
  }, {
    "tStartMs": 47190,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "Şimdi demo day dediğin herhangi bir programın"
    } ]
  }, {
    "tStartMs": 51090,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "ne programı ise artık sonunda yapılan"
    } ]
  }, {
    "tStartMs": 54090,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "genellikle ve çok değişik insanların"
    } ]
  }, {
    "tStartMs": 58350,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "katıldığı, izlediği bir etkinlik bu aslında."
    } ]
  }, {
    "tStartMs": 61410,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "Dolayısıyla burada olabildiğince herkesin"
    } ]
  }, {
    "tStartMs": 64230,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "anlayabileceği dilden konuşmak, basit olmak,"
    } ]
  }, {
    "tStartMs": 66630,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "akılda kalmak, ilgi çekmek gibi temel şeyler"
    } ]
  }, {
    "tStartMs": 68940,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "var. Ben bunu şöyle özet diliyorum."
    } ]
  }, {
    "tStartMs": 71220,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Diyelim ki 3 slayttan oluşan bir sunum"
    } ]
  }, {
    "tStartMs": 73560,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "yapacaksın. Kurgusal bir durum bu."
    } ]
  }, {
    "tStartMs": 76840,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "Birinci slaytta ikinci ve üçüncü slaytı"
    } ]
  }, {
    "tStartMs": 80020,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "görmek isteyecek bir mesaj vermen lazım."
    } ]
  }, {
    "tStartMs": 82150,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "Orada izleyen herkesin ikinci ya da üçüncü"
    } ]
  }, {
    "tStartMs": 84760,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "de ne diyecek bu dedirtecek bir mesaj vermen"
    } ]
  }, {
    "tStartMs": 87490,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "lazım. İkincide çok basit bir şekilde bu"
    } ]
  }, {
    "tStartMs": 91210,
    "dDurationMs": 4050,
    "segs": [ {
      "utf8": "elevator pitch, asansör sunumu tadında 30"
    } ]
  }, {
    "tStartMs": 95260,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "saniyede ne yaptığını, ne yapmak istediğini,"
    } ]
  }, {
    "tStartMs": 98080,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "hangi problemi çözmek istediğini en basit,"
    } ]
  }, {
    "tStartMs": 100570,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "en üst kavramsal seviyede anlatabilmen"
    } ]
  }, {
    "tStartMs": 103340,
    "dDurationMs": 3710,
    "segs": [ {
      "utf8": "lazım. Son slaytta da akılda kalmak ve ilgi"
    } ]
  }, {
    "tStartMs": 107050,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "çekmek lazım. Ne demek bu?"
    } ]
  }, {
    "tStartMs": 109360,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "İlkinde bu gördü seni, söylediğine baktı."
    } ]
  }, {
    "tStartMs": 111460,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "Ne diyecek bu acaba dedi."
    } ]
  }, {
    "tStartMs": 113820,
    "dDurationMs": 4750,
    "segs": [ {
      "utf8": "Dedin, tamam dedi ama soru işareti var."
    } ]
  }, {
    "tStartMs": 118570,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "Öyle bir şey söylüyorsun ki ya bir dakika"
    } ]
  }, {
    "tStartMs": 120190,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "benim bununla konuşmam lazım."
    } ]
  }, {
    "tStartMs": 122950,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "Bu kadar, ilgi çekmek ve dediğin gibi"
    } ]
  }, {
    "tStartMs": 125440,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "aslında bir sonraki toplantıya almak."
    } ]
  }, {
    "tStartMs": 127790,
    "dDurationMs": 4790,
    "segs": [ {
      "utf8": "Burada yine 3'e bölmek ilginçti bence."
    } ]
  }, {
    "tStartMs": 132730,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "Başlangıç, detaylar ve sonuç gibi."
    } ]
  }, {
    "tStartMs": 137080,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "Giriş, gelişme, sonuç gibi."
    } ]
  }, {
    "tStartMs": 139090,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "Bu arada yine bir önceki derste verdiğimiz"
    } ]
  }, {
    "tStartMs": 141340,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "örneğe de aslında bir atıfta bulunalım."
    } ]
  }, {
    "tStartMs": 143740,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "Bir diziyi izlerken ya da bir film izlerken"
    } ]
  }, {
    "tStartMs": 145780,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "de bir sonraki sahneyi merak ettirmek veya o"
    } ]
  }, {
    "tStartMs": 148750,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "geçişte izleyiciyi kaybetmemek gerekiyor."
    } ]
  }, {
    "tStartMs": 153820,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "Biz de hani o konuda bilirkişi değiliz ama"
    } ]
  }, {
    "tStartMs": 155680,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "izleyici olarak böyle yorumlar yapabiliriz."
    } ]
  }, {
    "tStartMs": 158890,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "Madem pitching film dünyasından geliyor,"
    } ]
  }, {
    "tStartMs": 161050,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "madem oradan geliyor, oraya da yine atıfta"
    } ]
  }, {
    "tStartMs": 163000,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "bulunalım. Burada ilk sayfada artık izleyici"
    } ]
  }, {
    "tStartMs": 167080,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "sizi ilk gördüğünde akılda kalmak, sunumun"
    } ]
  }, {
    "tStartMs": 171220,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "geri kalanını detaylı dinletmek için aslında"
    } ]
  }, {
    "tStartMs": 174100,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "bir açılış sayfanız olacak."
    } ]
  }, {
    "tStartMs": 176610,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "Daha sonra da kişinin ilgisini çektikten"
    } ]
  }, {
    "tStartMs": 179020,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "sonra aslında pazar büyüyor mu, gerçekten"
    } ]
  }, {
    "tStartMs": 182540,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "fırsat var mı? Hani dikkati çektik ama acaba"
    } ]
  }, {
    "tStartMs": 187600,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "şeyde çekebilecek miyiz, parayı da"
    } ]
  }, {
    "tStartMs": 189280,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "çekebilecek miyiz günün sonunda demek için"
    } ]
  }, {
    "tStartMs": 192490,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "pazarı anlatmamız gerekiyor."
    } ]
  }, {
    "tStartMs": 193750,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "Nasıl anlatacağız? Şöyle şimdi bu fırsat"
    } ]
  }, {
    "tStartMs": 195940,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "bence çok kritik bir kelime burada."
    } ]
  }, {
    "tStartMs": 197950,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "Çünkü sen, hani biz her modül veya derste"
    } ]
  }, {
    "tStartMs": 201640,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "şunu diyoruz işte birisinin bir problemini"
    } ]
  }, {
    "tStartMs": 204010,
    "dDurationMs": 5940,
    "segs": [ {
      "utf8": "söz işte ölçerek yap, geri bildirim al falan"
    } ]
  }, {
    "tStartMs": 209950,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "filan. Ama yatırımcıyı çok ilgilendirmiyor"
    } ]
  }, {
    "tStartMs": 212590,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "bunlar. Eğer yatırımcı senin hedef kitlende"
    } ]
  }, {
    "tStartMs": 214420,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "değilse çok umurunda değil."
    } ]
  }, {
    "tStartMs": 216740,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "O ne onun umurunda, ben buna yatırım"
    } ]
  }, {
    "tStartMs": 218900,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "yaptığımda ki bu arada yatırım sadece para"
    } ]
  }, {
    "tStartMs": 220790,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "değil, onu da ayrıca söyleyeceğiz."
    } ]
  }, {
    "tStartMs": 222590,
    "dDurationMs": 4860,
    "segs": [ {
      "utf8": "Ama temel olarak para, yatırım yaptığımda ne"
    } ]
  }, {
    "tStartMs": 227450,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "zaman ne alacağım dolayısıyla fırsat, fırsat"
    } ]
  }, {
    "tStartMs": 230780,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "o yüzden en önemli kelime."
    } ]
  }, {
    "tStartMs": 232160,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Fırsat da tabii pazarla ilgili bir şey."
    } ]
  }, {
    "tStartMs": 235010,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "Ne kadar büyük bir pazar ya da ne kadar"
    } ]
  }, {
    "tStartMs": 237020,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "gelişmiş bir pazar ya da ne kadar yeni ama"
    } ]
  }, {
    "tStartMs": 240590,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "hızlı büyüyen bir pazar."
    } ]
  }, {
    "tStartMs": 241670,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "Bütün bunlar hepsi fırsatın en önemli"
    } ]
  }, {
    "tStartMs": 244850,
    "dDurationMs": 4410,
    "segs": [ {
      "utf8": "bileşenleri diyelim. Burada eğer sizle aynı"
    } ]
  }, {
    "tStartMs": 249260,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "sektörden çalışan bir yatırımcı ise bazı"
    } ]
  }, {
    "tStartMs": 252320,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "noktaları biliyor olabilir."
    } ]
  }, {
    "tStartMs": 254240,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "Ama bu her zaman karşılaşılan bir durum"
    } ]
  }, {
    "tStartMs": 256490,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "değil. Özellikle böyle daha kalabalık bir"
    } ]
  }, {
    "tStartMs": 259160,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "ortamda sunum yapılıyorsa herkesin aslında"
    } ]
  }, {
    "tStartMs": 261770,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "en az bilgi seviyesinde olduğunu varsayarak"
    } ]
  }, {
    "tStartMs": 264320,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "çok basit bir şekilde anlatmak gerekir."
    } ]
  }, {
    "tStartMs": 266930,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "Özellikle bu fırsat diye burada ne fırsat"
    } ]
  }, {
    "tStartMs": 269090,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "var? Niye siz bu fırsatı görüyorsunuz?"
    } ]
  }, {
    "tStartMs": 271250,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Pazar ne kadar büyük büyüme potansiyeli ne?"
    } ]
  }, {
    "tStartMs": 273980,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "Bir önceki derslerde modüllerde konuştuğumuz"
    } ]
  }, {
    "tStartMs": 276980,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "haftalık yüzde 1 büyümeyle 7 büyüme"
    } ]
  }, {
    "tStartMs": 279020,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "arasındaki farkı o üssel büyüme var mı yok"
    } ]
  }, {
    "tStartMs": 282770,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "mu yoksa lineer büyüyen bir pazar mı bu?"
    } ]
  }, {
    "tStartMs": 286200,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "Bu çok önemli."
    } ]
  }, {
    "tStartMs": 287660,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "Burada ev ödevinizi yapmış olmanız"
    } ]
  }, {
    "tStartMs": 289520,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "gerekiyor. Size bir soru geldiğinde pazarla"
    } ]
  }, {
    "tStartMs": 292070,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "ilgili en çok şeyi bilen kişi siz olmanız"
    } ]
  }, {
    "tStartMs": 294710,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "gerekiyor ki size aslında güvenelim."
    } ]
  }, {
    "tStartMs": 297680,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Güven konusu da önemli."
    } ]
  }, {
    "tStartMs": 300170,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Ne diyorsun bu startup pitch'in amaçları"
    } ]
  }, {
    "tStartMs": 302450,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "arasında güven var mı?"
    } ]
  }, {
    "tStartMs": 305330,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "Evet, aslında öyle bir laf vardı."
    } ]
  }, {
    "tStartMs": 306890,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "Nasıldı? Sunumlar para kazanmak ya da para"
    } ]
  }, {
    "tStartMs": 310100,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "almak için değil, güven kazanmak için"
    } ]
  }, {
    "tStartMs": 311930,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "yapılır diye değil mi? Aynen öyle."
    } ]
  }, {
    "tStartMs": 313580,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "O yüzden sordum."
    } ]
  }, {
    "tStartMs": 315420,
    "dDurationMs": 3650,
    "segs": [ {
      "utf8": "Burada sizin amacınız para toplamak olursa"
    } ]
  }, {
    "tStartMs": 319070,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "çok belli edersiniz bunu."
    } ]
  }, {
    "tStartMs": 320750,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "Ve aslında biraz asıl amacınız güven"
    } ]
  }, {
    "tStartMs": 323000,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "tazelemek ve güven kurmak, güven altyapısını"
    } ]
  }, {
    "tStartMs": 325640,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "kurmak olmalı burada verdiğiniz bütün"
    } ]
  }, {
    "tStartMs": 327620,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "bilgilerde. İlgi çektik, sunumun geri kalanı"
    } ]
  }, {
    "tStartMs": 330410,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "için bir heves oluştu izleyicide."
    } ]
  }, {
    "tStartMs": 333710,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "Daha sonra fırsatı gösterdik, pazar da"
    } ]
  }, {
    "tStartMs": 336200,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "büyüyor dedik. Bak dinliyorsun, pazar da"
    } ]
  }, {
    "tStartMs": 338180,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "büyüyor. Peki burada biz asıl diğer"
    } ]
  }, {
    "tStartMs": 341930,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "modüllerde konuştuğumuz üçüncü slayta"
    } ]
  }, {
    "tStartMs": 344000,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "geliyoruz. Problem, kimin hangi problemini"
    } ]
  }, {
    "tStartMs": 346700,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "çözüyoruz? Bunun zaten artık bu seviyede çok"
    } ]
  }, {
    "tStartMs": 350270,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "net bir şekilde biliyor olmanız lazım."
    } ]
  }, {
    "tStartMs": 352340,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Probleminiz çok popüler bir problem"
    } ]
  }, {
    "tStartMs": 354680,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "olabilir. Çok hızlı büyüyen bir problem"
    } ]
  }, {
    "tStartMs": 357020,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "olabilir. Acil çözülmesi gereken bir problem"
    } ]
  }, {
    "tStartMs": 360170,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "olabilir. Herkesin çok fazla para harcayarak"
    } ]
  }, {
    "tStartMs": 362510,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "çözmek zorunda kaldığı pahalı bir problem"
    } ]
  }, {
    "tStartMs": 365120,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "olabilir veya çok sık karşılaşılan bir"
    } ]
  }, {
    "tStartMs": 367550,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "problem olabilir. Zaten bunun hakkında"
    } ]
  }, {
    "tStartMs": 370520,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "koskoca bir ders ve modül var."
    } ]
  }, {
    "tStartMs": 374360,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "Bunu sadece kullanıcıya iyi bir şekilde"
    } ]
  }, {
    "tStartMs": 376070,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "göstermek gerekiyor herhalde."
    } ]
  }, {
    "tStartMs": 377250,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "Aslında bu söylediğin ile destekleyici bir"
    } ]
  }, {
    "tStartMs": 380090,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "iki konu ekleyeyim ben."
    } ]
  }, {
    "tStartMs": 382670,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "Bu çok duyulan bir şey."
    } ]
  }, {
    "tStartMs": 384920,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "Kırmızı okyanus, mavi okyanus falan gibi"
    } ]
  }, {
    "tStartMs": 387380,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "laflar var biliyorsun. Kırmızı Okyanus ne"
    } ]
  }, {
    "tStartMs": 389120,
    "dDurationMs": 4230,
    "segs": [ {
      "utf8": "demek? Zaten uzun zamandır varolan büyümüş,"
    } ]
  }, {
    "tStartMs": 393350,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "rekabetin yüksek olduğu pazar demek."
    } ]
  }, {
    "tStartMs": 396770,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "Ama sen demin ne dedin?"
    } ]
  }, {
    "tStartMs": 398390,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "Pahalı çözümler vardır mesela."
    } ]
  }, {
    "tStartMs": 400250,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "Pazar kırmızıdır ama pahalıdır bütün çözümler"
    } ]
  }, {
    "tStartMs": 403070,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": ". Rekabette de birbirine yakındır çözümlerin"
    } ]
  }, {
    "tStartMs": 405600,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "maliyetleri. O zaman senin gelip burada bir"
    } ]
  }, {
    "tStartMs": 408680,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "şeyleri değiştirip, optimize edip öne çıkma"
    } ]
  }, {
    "tStartMs": 411440,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "şansını vardır. Onun için kırmızı okyanus"
    } ]
  }, {
    "tStartMs": 413390,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "girilmez değildir."
    } ]
  }, {
    "tStartMs": 415190,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "Ama öyle bir anlatman lazım ki buna girilir"
    } ]
  }, {
    "tStartMs": 418340,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "ama şöyle girilir yani örnek ünlü daha önce"
    } ]
  }, {
    "tStartMs": 422480,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "de başka modüllerde konuştuğumuz ürün"
    } ]
  }, {
    "tStartMs": 426140,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "teslimatı, yemek teslimatı yapıyorum."
    } ]
  }, {
    "tStartMs": 428030,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "Tamam herkes yapıyor. Çok büyümüş Kırmızı"
    } ]
  }, {
    "tStartMs": 430130,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "Okyanus. Ama ben bir şeyi çok farklı"
    } ]
  }, {
    "tStartMs": 432230,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "yapıyorum ya sadece belli bir alanda"
    } ]
  }, {
    "tStartMs": 435800,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "yapıyorum, çok spesifik herkeste olmayan"
    } ]
  }, {
    "tStartMs": 440060,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "alanda yapıyorum ya da çok hızlı yapıyorum."
    } ]
  }, {
    "tStartMs": 442560,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Yani böyle bir fark yarattığın anda kırmızı"
    } ]
  }, {
    "tStartMs": 444560,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "okyanusta kendine mavi bir alan açabilirsin."
    } ]
  }, {
    "tStartMs": 447350,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "Onu da unutmamak lazım."
    } ]
  }, {
    "tStartMs": 448760,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Çok doğru dediğin, mavi okyanusun, mavi"
    } ]
  }, {
    "tStartMs": 451400,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "okyanus stratejisinin tekniğinde aslında"
    } ]
  }, {
    "tStartMs": 453650,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "dediğin var. Rakiplerle aramdaki fark"
    } ]
  }, {
    "tStartMs": 457790,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "yaratabileceğin bir noktayı buluyorsun."
    } ]
  }, {
    "tStartMs": 459740,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Bu biraz önce söylediğin fiyat olabilir, hız"
    } ]
  }, {
    "tStartMs": 461660,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "olabilir, alan olabilir."
    } ]
  }, {
    "tStartMs": 463970,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "Sadece Asya mutfağı ya da sadece hamburger"
    } ]
  }, {
    "tStartMs": 467180,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "getiriyor olabilirsin, o alana odaklanmış"
    } ]
  }, {
    "tStartMs": 469430,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "olabilirsin. Bu alanlardan birinde inanılmaz"
    } ]
  }, {
    "tStartMs": 473240,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "iyi olmak ama o diğer rakiplerin yaptığı"
    } ]
  }, {
    "tStartMs": 476150,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "bazı şeylerden de feragat etmek gerekiyor."
    } ]
  }, {
    "tStartMs": 479070,
    "dDurationMs": 4910,
    "segs": [ {
      "utf8": "Siz motorcularınıza çok şık kasklar veya"
    } ]
  }, {
    "tStartMs": 483980,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "renkli üstler veremeyebilirsiniz."
    } ]
  }, {
    "tStartMs": 486140,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "Bu sizin feragat ettiğiniz şeylerden bir"
    } ]
  }, {
    "tStartMs": 488810,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "tanesi olabilir veya daha yavaş"
    } ]
  }, {
    "tStartMs": 490850,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "getirebilirsiniz. On dakikada değil ama bir"
    } ]
  }, {
    "tStartMs": 493220,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "saatte getirirsiniz, bundan da feragat"
    } ]
  }, {
    "tStartMs": 495380,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "edebilirsiniz. Feragat ettiğiniz şeyler, ama"
    } ]
  }, {
    "tStartMs": 498590,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "bir noktayı da en iyi herkesten, en iyi"
    } ]
  }, {
    "tStartMs": 501020,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "şekilde yapmak zaten."
    } ]
  }, {
    "tStartMs": 502190,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "Aslında Kırmızı Okyanusu senin dediğin gibi"
    } ]
  }, {
    "tStartMs": 504800,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "mavi bir alan açıyor içinde ve mavi okyanusa"
    } ]
  }, {
    "tStartMs": 506960,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "çeviriyor. Bu analoji de şuradan geliyor"
    } ]
  }, {
    "tStartMs": 510800,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "eğer çok fazla köpekbalığının olduğu bir yer"
    } ]
  }, {
    "tStartMs": 513440,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "varsa okyanus kırmızılaşır, çok fazla orada"
    } ]
  }, {
    "tStartMs": 516960,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "avlanma olur vesaire mantığından geliyor."
    } ]
  }, {
    "tStartMs": 520260,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "Diğer taraftan mavi temiz bir okyanus."
    } ]
  }, {
    "tStartMs": 522210,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "Bomboş girmek için hevesleneceğimiz."
    } ]
  }, {
    "tStartMs": 526500,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "O yüzden Mavi Okyanus bulmak için çaba"
    } ]
  }, {
    "tStartMs": 528690,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "göstermek her zaman keyifli olacaktır."
    } ]
  }, {
    "tStartMs": 531700,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "Üç slayt geçtik, önümüzdeki slaytlarla bir"
    } ]
  }, {
    "tStartMs": 534390,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "sonraki derste girelim istersen."
    } ]
  } ]
}
