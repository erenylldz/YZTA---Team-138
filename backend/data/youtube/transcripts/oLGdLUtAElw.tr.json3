  }, {
    "tStartMs": 747540,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "müdürü olabilir veya onun holdinginden bir"
    } ]
  }, {
    "tStartMs": 751200,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "şirkettir. Tanıştırmak isteriz."
    } ]
  }, {
    "tStartMs": 753690,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "Yani direkt müşteri olmayı o sağlamayabilir."
    } ]
  }, {
    "tStartMs": 755730,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "Ama en azından iyi anlarsa bizim hangi"
    } ]
  }, {
    "tStartMs": 759210,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "problemi çözdüğümüzü, ne yetkinlikle"
