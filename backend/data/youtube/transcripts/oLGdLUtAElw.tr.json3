  }, {
    "tStartMs": 730410,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "toplantı olabilir."
    } ]
  }, {
    "tStartMs": 731910,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "Ama neler isteyebiliriz?"
    } ]
  }, {
    "tStartMs": 734460,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "Bir kere en standart para istiyoruz."
    } ]
  }, {
    "tStartMs": 736710,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "İkincisi müşteri ilişkisi isteyebiliriz."
    } ]
  }, {
    "tStartMs": 739830,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "Karşımızdaki yatırımcı aynı zamanda büyük"
