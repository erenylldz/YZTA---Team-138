  }, {
    "tStartMs": 897260,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "trendi görüyoruz."
    } ]
  }, {
    "tStartMs": 899480,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "Bu kadar sayfaya gerek olmayan ama hakikaten"
    } ]
  }, {
    "tStartMs": 902750,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "takımımızla yaptığınız işle problemi"
