  }, {
    "tStartMs": 767130,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "sermayesini bize verebilir bu noktada."
    } ]
  }, {
    "tStartMs": 770730,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "Burada parayı istediğimizde parayı nasıl"
    } ]
  }, {
    "tStartMs": 772740,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "kullanacağımızı ne detayda vermemiz"
    } ]
  }, {
    "tStartMs": 774570,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "gerekiyor?"
    } ]
  }, {
    "tStartMs": 775720,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "Detaydan ziyade nasıl ifade ettiğin önemli."
