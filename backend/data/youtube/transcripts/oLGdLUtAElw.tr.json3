  }, {
    "tStartMs": 853520,
    "dDurationMs": 4860,
    "segs": [ {
      "utf8": "var. Burada eğer yatırımcı size kısa vadede,"
    } ]
  }, {
    "tStartMs": 858530,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "hemen yani belki sunumdan sonra, belki bir"
