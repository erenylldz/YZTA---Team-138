  }, {
    "tStartMs": 904850,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "anlamanızla geliştirdiğiniz çözümle aslında"
    } ]
  }, {
    "tStartMs": 907850,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "üç dakikada bile fonlanabiliyorsunuz, tek"
    } ]
  }, {
    "tStartMs": 911000,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "sayfada ve üç dakikada bile"
    } ]
  }, {
    "tStartMs": 912200,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "fonlanabiliyorsunuz. Aslında pitching"
    } ]
  }, {
    "tStartMs": 914870,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "trendleri nereye gidiyor, onunla bir"
    } ]
  }, {
    "tStartMs": 916340,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "kapatalım. Şimdi bir kere dediğin gibi kimin"
    } ]
  }, {
    "tStartMs": 918980,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "dinlediğine göre ve bu, bu kimin ne kadar bu"
    } ]
  }, {
    "tStartMs": 921980,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "konuda deneyimli ve yatırım yapmış olduğuna"
    } ]
  }, {
    "tStartMs": 925100,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "göre belli standartları var ve belli görmek"
    } ]
  }, {
    "tStartMs": 928670,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "istedikleri slaytlar var."
    } ]
  }, {
    "tStartMs": 929900,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "Bununla ilgili kaynak Google'da var oldukça"
    } ]
  }, {
    "tStartMs": 932480,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "geniş bir şekilde. Ama genel şeyi söyleyeyim"
    } ]
  }, {
    "tStartMs": 934910,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "10 ila 15 slayt yani 20 sayfalık bir pitch"
    } ]
  }, {
    "tStartMs": 938840,
    "dDurationMs": 4740,
    "segs": [ {
      "utf8": "bence daha başından kaybeder net."
    } ]
  }, {
    "tStartMs": 943580,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "3 sayfalık bir pitch benim kurgusal ve"
    } ]
  }, {
    "tStartMs": 945560,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "kavramsal bir örneğim de öyle bir şey"
    } ]
  }, {
    "tStartMs": 947450,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "olamaz. 10 minimum, 15 maksimum."
    } ]
  }, {
    "tStartMs": 950570,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Buna hazır olmak lazım."
    } ]
  }, {
    "tStartMs": 951920,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "Bu bir. İki kim olduğuna göre olmazsa olmaz"
    } ]
  }, {
    "tStartMs": 956590,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "slaytları koymak lazım."
    } ]
  }, {
    "tStartMs": 959920,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "Mesela işte iş modeli gelir modeli illaki"
    } ]
  }, {
    "tStartMs": 962830,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "sizinde görmek isteyip istemiyor"
    } ]
  }, {
    "tStartMs": 964450,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "olabilirler. Parayı nasıl kullanacağım"
    } ]
  }, {
    "tStartMs": 966730,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "bazılarının hiç umurunda değil."
    } ]
  }, {
    "tStartMs": 968590,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "Takıma bakıyor ne kadar para lazım, tamam al"
    } ]
  }, {
    "tStartMs": 971830,
    "dDurationMs": 3050,
    "segs": [ {
      "utf8": "devam et diyor. Bu son derece kritik."
    } ]
  }, {
    "tStartMs": 974880,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "Bu seninle birlikte izlediğimiz o örnek, tek"
    } ]
  }, {
    "tStartMs": 978460,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "sayfa ve üç dakika çok ilginç bir örnekti ve"
    } ]
  }, {
    "tStartMs": 982000,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "hızla yatırım aldıklarını da gözlerimizle"
    } ]
  }, {
    "tStartMs": 983980,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "gördük. Burada one pager denen kavramdan"
    } ]
  }, {
    "tStartMs": 986920,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "bahsetmekte yarar var."
    } ]
  }, {
    "tStartMs": 988330,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "One pager biliyorsun bir şirketin o andaki"
    } ]
  }, {
    "tStartMs": 991060,
    "dDurationMs": 3380,
    "segs": [ {
      "utf8": "fotoğrafı. O andakiden kastım aylık update,"
    } ]
  }, {
    "tStartMs": 994500,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "aylık güncelleme yapıp bence yatırımcılara"
    } ]
  }, {
    "tStartMs": 997500,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "da yollamak lazım. Bu güncelleme yollama da"
    } ]
  }, {
    "tStartMs": 1000080,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "kritik bir davranış ve bunu mutlaka yapmak"
    } ]
  }, {
    "tStartMs": 1003350,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "lazım. Yani sana hayır bile dese izin alıp"
    } ]
  }, {
    "tStartMs": 1006800,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "ondan gönderebilir miyim deyip aylık"
    } ]
  }, {
    "tStartMs": 1009140,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "güncelleme yollamak lazım."
    } ]
  }, {
    "tStartMs": 1010430,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Orada da genellikle bu tek sayfa"
    } ]
  }, {
    "tStartMs": 1012230,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "kullanılıyor. Tek sayfada bütünü 10 15"
    } ]
  }, {
    "tStartMs": 1014690,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "sayfada anlattığın şeyleri kutucuklar"
    } ]
  }, {
    "tStartMs": 1017000,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "halinde, tıpkı şey gibi, kanvas gibi, kalın"
    } ]
  }, {
    "tStartMs": 1019310,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "kanvas gibi ya da iş modeli kanvası gibi tek"
    } ]
  }, {
    "tStartMs": 1021380,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "sayfada şirketin durumunu anlatıyorsun."
    } ]
  }, {
    "tStartMs": 1023960,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "Yatırımcılara daha sonra bu kullandığınız"
    } ]
  }, {
    "tStartMs": 1026780,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "pitch'den sonra aldığınız yatırımdan sonra"
    } ]
  }, {
    "tStartMs": 1028550,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "aslında bunun bir özetini aylık olarak"
    } ]
  }, {
    "tStartMs": 1030800,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "güncelleme vermek aslında yararlı olacaktır"
    } ]
  }, {
    "tStartMs": 1032900,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "dedik. Dediğin gibi trendlerde her ne kadar"
    } ]
  }, {
    "tStartMs": 1036230,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "değişse bile aslında en baz sürekli"
    } ]
  }, {
    "tStartMs": 1038900,
    "dDurationMs": 4470,
    "segs": [ {
      "utf8": "kullanılan 10 sayfalık metodu bir kenara"
    } ]
  }, {
    "tStartMs": 1043370,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "koymak önemli ve aslında şirketiniz"
    } ]
  }, {
    "tStartMs": 1045800,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "geliştikçe bunu da düzeltmek ve güncellemek"
    } ]
  }, {
    "tStartMs": 1048320,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "kesinlikle önemli olacaktır."
    } ]
  }, {
    "tStartMs": 1049880,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "Ve bu modülü burada bitirelim ama siz de"
    } ]
  }, {
    "tStartMs": 1053030,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "şirketlerinizi, uygulamalarınızı,"
    } ]
  }, {
    "tStartMs": 1054440,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "oyunlarınızı geliştirdikçe bu dökümanları"
    } ]
  }, {
    "tStartMs": 1057980,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "aslında akademideki arkadaşlarınızla"
    } ]
  }, {
    "tStartMs": 1059630,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "paylaşıp geribildirim alabilirsiniz ve"
    } ]
  }, {
    "tStartMs": 1062810,
    "dDurationMs": 2450,
    "segs": [ {
      "utf8": "iyileştirmeye doğru ilerleyebilirsiniz."
    } ]
  }, {
    "tStartMs": 1065260,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "Evet, prova yapmak lazım."
    } ]
  }, {
    "tStartMs": 1066650,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "Prova yapmak lazım. Teşekkürler."
    } ]
  } ]
}
