  }, {
    "tStartMs": 674690,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "ayrım yapıyorum. Küçük bir demek ki daha"
    } ]
  }, {
    "tStartMs": 676250,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "küçük şirketlere satıyorsun ürününü ve"
    } ]
  }, {
    "tStartMs": 679520,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "mesela Store'dan alıyorsun paranı veya kredi"
    } ]
  }, {
    "tStartMs": 683090,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "kartından çekiyorsun ya da büyüklere"
    } ]
  }, {
    "tStartMs": 685130,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "satıyorsun. Fatura kesip belli bir"
    } ]
  }, {
    "tStartMs": 687320,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "gecikmeyle tahsilat yapıyorsun."
    } ]
  }, {
    "tStartMs": 689510,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "Bunu belirtmek lazım bunu soracaklar çünkü"
    } ]
  }, {
    "tStartMs": 691970,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "mesela müşterileri koyacaksın oraya."
    } ]
  }, {
    "tStartMs": 693290,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "Sen işte şundan bu kadar gelir elde ettim."
    } ]
  }, {
    "tStartMs": 696200,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "Ettin de ne kadar zamanda tahsil ettin?"
    } ]
  }, {
    "tStartMs": 698330,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "Niye o senin biraz sonra konuşacağımız"
    } ]
  }, {
    "tStartMs": 700940,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "parayı nasıl kullanacağındaki bazı soruların"
    } ]
  }, {
    "tStartMs": 704030,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "cevabı olacak. Nakit akışıyla çok alakalı"
    } ]
  }, {
    "tStartMs": 706730,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "olacak. Yani operasyonel sermaye ihtiyacı ve"
    } ]
  }, {
    "tStartMs": 709340,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "nakit akışı, kime sattın, ne sattın, ne"
