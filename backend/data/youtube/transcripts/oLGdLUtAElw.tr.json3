  }, {
    "tStartMs": 868160,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "için iyi bir bilgi olacaktır."
    } ]
  }, {
    "tStartMs": 870260,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "Aslında biraz sonra bu bu modülü bitirelim"
    } ]
  }, {
    "tStartMs": 874790,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "ama senden çok kısa bir özet isteyelim."
    } ]
  }, {
    "tStartMs": 876620,
    "dDurationMs": 4920,
    "segs": [ {
      "utf8": "Bu pitch'lerde sayfa sayfa aslında anlattık"
