{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 300,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "Tekrar merhaba. Bu dersimizde, bir önceki"
    } ]
  }, {
    "tStartMs": 3030,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "dersimizde de belirttiğimiz gibi rekabet, iş"
    } ]
  }, {
    "tStartMs": 5700,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "modeli, takım ve aslında yatırımı ne için"
    } ]
  }, {
    "tStartMs": 8280,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "istediğinizi kullanma sayfalarına biraz"
    } ]
  }, {
    "tStartMs": 10560,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "derinlemesine inceleyeceğiz."
    } ]
  }, {
    "tStartMs": 12630,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "İstersen rekabetten başlayalım."
    } ]
  }, {
    "tStartMs": 14100,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "Nasıl anlatmak gerekiyor rekabeti?"
    } ]
  }, {
    "tStartMs": 17760,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "Şimdi ben çok sayıda dinliyorum biliyorsun."
    } ]
  }, {
    "tStartMs": 23160,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "Ve ne kadar deneyimsiz ise girişimci o kadar"
    } ]
  }, {
    "tStartMs": 26370,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "şu cümleyi kullanıyor başka hiç bunu yapan"
    } ]
  }, {
    "tStartMs": 29940,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "yok, rakibimiz yok diyor."
    } ]
  }, {
    "tStartMs": 32820,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "Nereden biliyorsunuz diye sorduklarında da"
    } ]
  }, {
    "tStartMs": 35880,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "Google'ladım, bulamadım diyor."
    } ]
  }, {
    "tStartMs": 38880,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Şimdi öyle değil."
    } ]
  }, {
    "tStartMs": 41700,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "Rekabet mutlaka bahsedilmesi gereken bir"
    } ]
  }, {
    "tStartMs": 43950,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "şey. Hatta bizim hatırlıyorsan kanvasımızın"
    } ]
  }, {
    "tStartMs": 46320,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "ilk kutucuğunun alt tarafı yani problem"
    } ]
  }, {
    "tStartMs": 48540,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "tanımının alt tarafında bir bölüm vardı."
    } ]
  }, {
    "tStartMs": 50460,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "Neydi o alternatif çözümler?"
    } ]
  }, {
    "tStartMs": 53100,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "Rekabetin olmayabilir, itirazım olmaz."
    } ]
  }, {
    "tStartMs": 55710,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "Ama alternatif çözümden mutlaka bahsetmek"
    } ]
  }, {
    "tStartMs": 57900,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "gerekiyor. Yani rekabetin yoksa, tamamen"
    } ]
  }, {
    "tStartMs": 60480,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "yeni ve inovatif bir şey yapıyorsan da o"
    } ]
  }, {
    "tStartMs": 63600,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "zamana kadar nasıl çözüldüğünü mutlaka"
    } ]
  }, {
    "tStartMs": 66180,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "anlatmak gerekiyor. Kimler çözdüğünü manuel"
    } ]
  }, {
    "tStartMs": 69480,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "mi yapılıyor, bu hizmet olarak mı alınıyor"
    } ]
  }, {
    "tStartMs": 72750,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "ya da kendileri mi çözüyorlar?"
    } ]
  }, {
    "tStartMs": 74400,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "Bunu mesela yürüyorlar mı?"
    } ]
  }, {
    "tStartMs": 76050,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "Ulaşım aracı kullanmak yerine gibi."
    } ]
  }, {
    "tStartMs": 78510,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "Burada ikinci sayfamızda bahsettiğimiz"
    } ]
  }, {
    "tStartMs": 81090,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "aslında pazarın büyüklüğünden biraz farklı"
    } ]
  }, {
    "tStartMs": 83910,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "bir sayfa. O yüzden ayrıca değiniyoruz."
    } ]
  }, {
    "tStartMs": 86880,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "Çünkü atıyorum rekabetin dediğin gibi veya"
    } ]
  }, {
    "tStartMs": 90600,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "alternatif çözümlerin ne denli olduğunu,"
    } ]
  }, {
    "tStartMs": 93270,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "nerelerde kimle karşılaşacağınızı, hangi"
    } ]
  }, {
    "tStartMs": 95790,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "kurumla karşılaşacağınızı, hangi start upla"
    } ]
  }, {
    "tStartMs": 97680,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "karşılaşacağınızı dinleyiciye de anlatmak,"
    } ]
  }, {
    "tStartMs": 100680,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "hatta aslında bir karşılaştırma yöntemi"
    } ]
  }, {
    "tStartMs": 103800,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "sunmak için de iyi. O zaman bu bu şirketin"
    } ]
  }, {
    "tStartMs": 108060,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "şurası da işini yapıyor ya da şu problemi"
    } ]
  }, {
    "tStartMs": 110580,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "çözüyor, şunun çözmediğini çözüyor gibi."
    } ]
  }, {
    "tStartMs": 113040,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "Aslında bir karşılaştırma yapmak da"
    } ]
  }, {
    "tStartMs": 114510,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "sağlıyor. Eğer rakipler iyiyse ve sen de o"
    } ]
  }, {
    "tStartMs": 117810,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "rakiplerle aslında aynı işi yapabilecek,"
    } ]
  }, {
    "tStartMs": 120300,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "benzer işi yapabilecek güveni veriyorsan"
    } ]
  }, {
    "tStartMs": 122890,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "yatırımcıya aslında bir yerde kazanmış"
    } ]
  }, {
    "tStartMs": 124770,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "oluyorsun. Burada bir noktada var o da"
    } ]
  }, {
    "tStartMs": 126580,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "aslında bir defans yapmamız gerekiyor."
    } ]
  }, {
    "tStartMs": 128680,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "Rekabette defansı da burada anlatmamız"
    } ]
  }, {
    "tStartMs": 131400,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "gerekiyor. Onu nasıl anlatacağız?"
    } ]
  }, {
    "tStartMs": 133680,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "Nasıl bir rekabetten bahsettiğine göre"
    } ]
  }, {
    "tStartMs": 135930,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "değişir. Örneğin Kırmızı Okyanus örneğine"
    } ]
  }, {
    "tStartMs": 138180,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "dönelim. Öyle bir pazarda isen defansı"
    } ]
  }, {
    "tStartMs": 141210,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "yarattığın fark üzerinden yapacaksın."
    } ]
  }, {
    "tStartMs": 143940,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Yani benim takımım çok iyiydi."
    } ]
  }, {
    "tStartMs": 145140,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Ben daha çok para aldım."
    } ]
  }, {
    "tStartMs": 146940,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "Çalışmaz burada ama yeni oluşmakta olan bir"
    } ]
  }, {
    "tStartMs": 149880,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "pazar Mavi Okyanus ise o zaman takım ve"
    } ]
  }, {
    "tStartMs": 154890,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "takımdaki deneyim veya ürünün gerçekten bir"
    } ]
  }, {
    "tStartMs": 158580,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "çarpı on ürün olması fark yaratabilir."
    } ]
  }, {
    "tStartMs": 162450,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "Onun için pozisyon alıp ona göre defans"
    } ]
  }, {
    "tStartMs": 165570,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "yapman lazım. Aynen öyle."
    } ]
  }, {
    "tStartMs": 168960,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "Rekabetten sonra aslında sunumun kimilerine"
    } ]
  }, {
    "tStartMs": 172680,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "göre en kritik, yine dinleyiciye göre, bazen"
    } ]
  }, {
    "tStartMs": 176010,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "en kritik olmayan konusuna geliyoruz."
    } ]
  }, {
    "tStartMs": 178170,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "O da takım. Takımı nasıl anlatmak gerekiyor"
    } ]
  }, {
    "tStartMs": 181740,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "pitch dokümanında?"
    } ]
  }, {
    "tStartMs": 183030,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "Orada da bir böyle 2 farklı eğilim var."
    } ]
  }, {
    "tStartMs": 186780,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "Bazıları bunu en başta koymayı tercih"
    } ]
  }, {
    "tStartMs": 189330,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "ediyor, bazıları en sonda koyuyor."
    } ]
  }, {
    "tStartMs": 192480,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "Benim tercihim kendi adıma en sonda olması"
    } ]
  }, {
    "tStartMs": 196080,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "ama kime sunduğuna göre değişir."
    } ]
  }, {
    "tStartMs": 199140,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "Örneğin kitlesel fonlama yapıyorsan başa"
    } ]
  }, {
    "tStartMs": 201360,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "koymak lazım ve özellikle eğer böyle iyi"
    } ]
  }, {
    "tStartMs": 204930,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "üniversitelerden mezun olmuş belli"
    } ]
  }, {
    "tStartMs": 206730,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "deneyimleri olan kişilerse takımdakiler o"
    } ]
  }, {
    "tStartMs": 209400,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "zaman başa koymak lazım ama bir VC'ye bir"
    } ]
  }, {
    "tStartMs": 213150,
    "dDurationMs": 2630,
    "segs": [ {
      "utf8": "fona sunum yapıyorsan başa koymamak lazım."
    } ]
  }, {
    "tStartMs": 215790,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "Sadece bir koşulla başa koyabilirsiniz."
    } ]
  }, {
    "tStartMs": 217920,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "Zaten daha önceden bilinen bir insandır."
    } ]
  }, {
    "tStartMs": 220800,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Çıkışları olmuştur."
    } ]
  }, {
    "tStartMs": 222600,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "Farklı pazarda olsa bile farklı dikeyde"
    } ]
  }, {
    "tStartMs": 225420,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "farklı problemi çözüyor olsa bile artık bir"
    } ]
  }, {
    "tStartMs": 227910,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "doğrulaması, bir validasyonu vardır, kendini"
    } ]
  }, {
    "tStartMs": 230460,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "ispatlamıştır, rüştünü ispatlamıştır."
    } ]
  }, {
    "tStartMs": 232290,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "O zaman başa koyabilirsiniz."
    } ]
  }, {
    "tStartMs": 234060,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "Yani aslında nasıl dinleyicilerine göre"
    } ]
  }, {
    "tStartMs": 237510,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "değişiyor. Dinleyicinin sunumu nasıl bir"
    } ]
  }, {
    "tStartMs": 240300,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "sırada dinlemesi gerek istediğine göre bu"
    } ]
  }, {
    "tStartMs": 243870,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "sayfaların sırasını değiştirebiliyorsunuz."
    } ]
  }, {
    "tStartMs": 246720,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "Peki takım sayfasının içinde üniversiteler"
    } ]
  }, {
    "tStartMs": 249810,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "veya geçmiş işlerden başka ne yazabiliriz?"
    } ]
  }, {
    "tStartMs": 253200,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "İşte burada kritik olan şey şu aslında ne"
    } ]
  }, {
    "tStartMs": 256140,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "katkı sağlayacak, ne fayda sağlayacak?"
    } ]
  }, {
    "tStartMs": 257910,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "Orada o bilginin var olması mesela."
    } ]
  }, {
    "tStartMs": 259500,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "İşte dünyanın en iyi birkaç üniversitesinden"
    } ]
  }, {
    "tStartMs": 262470,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "birinden mezun olmuş ve diyelim ki"
    } ]
  }, {
    "tStartMs": 264810,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "mühendislikte mezun olmuş."
    } ]
  }, {
    "tStartMs": 266130,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Ama yaptığı iş, sosyal girişim mesela."
    } ]
  }, {
    "tStartMs": 269830,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "Ne kadar ilgili bilmiyorum."
    } ]
  }, {
    "tStartMs": 271990,
    "dDurationMs": 2570,
    "segs": [ {
      "utf8": "Yazmayabilirsin. Yani ilişkisi önemli ya."
    } ]
  }, {
    "tStartMs": 274660,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "Mesela diyelim biyomedikal bir çözüm var ve"
    } ]
  }, {
    "tStartMs": 278830,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "medikal doktor tabii ki yazman lazım gibi."
    } ]
  }, {
    "tStartMs": 281770,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "Yani relevance İngilizcesi ne kadar ilişkili"
    } ]
  }, {
    "tStartMs": 284590,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "ve ona ne kadar katkıda bulunur onun"
    } ]
  }, {
    "tStartMs": 287170,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "gösterilmesi bence çok daha önemli."
    } ]
  }, {
    "tStartMs": 289450,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "Ya da mesela diyelim ki işte büyük dünyanın"
    } ]
  }, {
    "tStartMs": 291910,
    "dDurationMs": 5490,
    "segs": [ {
      "utf8": "en büyük FMCG şirketlerinden birinde uzun"
    } ]
  }, {
    "tStartMs": 297400,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "süre çalışmış ve yaptığı iş o dünyaya bir"
    } ]
  }, {
    "tStartMs": 300310,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "çözüm getiriyor. O zaman tabii ki anlamlı,"
    } ]
  }, {
    "tStartMs": 302770,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "tecrübe, o dünyada tecrübeli olduğunu"
    } ]
  }, {
    "tStartMs": 305290,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "göstermek yine fayda yaratacaktır."
    } ]
  }, {
    "tStartMs": 307630,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "Bu bizim başka modüllerde konuştuğumuz"
    } ]
  }, {
    "tStartMs": 310360,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "aslında rekabet avantajı kutucuğumuzda da"
    } ]
  }, {
    "tStartMs": 313810,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "çok alakalı, neden biz."
    } ]
  }, {
    "tStartMs": 315130,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "Neden biz asla takımda neden biz, neden bize"
    } ]
  }, {
    "tStartMs": 319330,
    "dDurationMs": 6420,
    "segs": [ {
      "utf8": "uygun bir şekilde işte resimler, title'lar,"
    } ]
  }, {
    "tStartMs": 326500,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "okullar, geçmiş deneyim, hangi şirketlerde"
    } ]
  }, {
    "tStartMs": 329740,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "çalıştığı falan tamamen buna uygun şekilde"
    } ]
  }, {
    "tStartMs": 333040,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "bahsedilmeli. Burada biraz takımınızın"
    } ]
  }, {
    "tStartMs": 335980,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "aslında şirket kültürünü de burada biraz"
    } ]
  }, {
    "tStartMs": 338380,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "verebiliyorsunuz dediğin gibi burada"
    } ]
  }, {
    "tStartMs": 340540,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "resimleri, fotoğrafları nasıl koyduğunuz"
    } ]
  }, {
    "tStartMs": 342340,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "bile değiştiriyor bunu."
    } ]
  }, {
    "tStartMs": 343750,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "Atıyorum ofiste bir köpeğiniz varsa onu"
    } ]
  }, {
    "tStartMs": 346000,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "koyan start uplar oluyor."
    } ]
  }, {
    "tStartMs": 347620,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "Bu biraz da işte nasıl bir ofis dinamiğinin"
    } ]
  }, {
    "tStartMs": 350530,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "olduğunu güzel gösterebiliyor."
    } ]
  }, {
    "tStartMs": 352180,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Toplu bir fotoğraf koyup tek tek koymayanlar"
    } ]
  }, {
    "tStartMs": 354460,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "olabiliyor. Toplu fotoğraf bence değerli"
    } ]
  }, {
    "tStartMs": 357340,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "birlikteliği gösteriyor."
    } ]
  }, {
    "tStartMs": 358570,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "Birlikteliği, takımınızı gösteriyor."
    } ]
  }, {
    "tStartMs": 361040,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "O yüzden bu yani küçük bir detay olsa da"
    } ]
  }, {
    "tStartMs": 364000,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "aslında fark yarattığını görüyoruz."
    } ]
  }, {
    "tStartMs": 366430,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "Takımla ilgili çok önemli bir konu var."
    } ]
  }, {
    "tStartMs": 370380,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "O da takım elemanlarının full time olup"
    } ]
  }, {
    "tStartMs": 373770,
    "dDurationMs": 4750,
    "segs": [ {
      "utf8": "olmadıkları. Bu kritik erken aşamanın en"
    } ]
  }, {
    "tStartMs": 378880,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "büyük açmazı bu. Oraya isimleri, kişileri"
    } ]
  }, {
    "tStartMs": 381880,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "koyuyorlar ve genellikle toplu fotoğraf"
    } ]
  }, {
    "tStartMs": 384100,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "koyamıyorlar. Çünkü bir araya gelmiyor onlar"
    } ]
  }, {
    "tStartMs": 386650,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "uzaktan ya da işte ne bileyim arada sırada"
    } ]
  }, {
    "tStartMs": 389980,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "buluşarak fotoğraf çekmeden bir araya"
    } ]
  }, {
    "tStartMs": 392290,
    "dDurationMs": 4220,
    "segs": [ {
      "utf8": "geliyorlar. Okulları, şirketleri falan filan"
    } ]
  }, {
    "tStartMs": 396520,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "koyup güçlü göstermeye çalışıyorlar ama full"
    } ]
  }, {
    "tStartMs": 399130,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "time değil. Yani kendi işine devam ediyor."
    } ]
  }, {
    "tStartMs": 402760,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "Parayı alınca gelecek."
    } ]
  }, {
    "tStartMs": 404680,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "Bu çok çok zayıf bir şey."
    } ]
  }, {
    "tStartMs": 407530,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "Hatta kırmızı bayraklardan bir tanesi"
    } ]
  }, {
    "tStartMs": 410770,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "kesinlikle. Çünkü aslında siz daha o riski"
    } ]
  }, {
    "tStartMs": 413860,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "alamamış iken neden yatırımcı veya dinleyen"
    } ]
  }, {
    "tStartMs": 417490,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "kişi o riski alsın?"
    } ]
  }, {
    "tStartMs": 419010,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "Cevabı bu. Yani siz daha işinizi bırakmaya"
    } ]
  }, {
    "tStartMs": 421690,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "veya bu işe tam zamanlı vakit ayırmaya"
    } ]
  }, {
    "tStartMs": 424060,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "başladığınızı söylüyorsunuz ama başka"
    } ]
  }, {
    "tStartMs": 426940,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "birinden bu iş için risk almasını"
    } ]
  }, {
    "tStartMs": 429220,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "bekliyorsunuz. O yüzden önemli kırmızı"
    } ]
  }, {
    "tStartMs": 431980,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "bayraklardan bir tanesi."
    } ]
  }, {
    "tStartMs": 433420,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "Burada işte yatırım sadece para değil"
    } ]
  }, {
    "tStartMs": 435550,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "diyoruz ya. Aslında kurucu da bir yatırım"
    } ]
  }, {
    "tStartMs": 438400,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "yapıyor. Ne yatırımı yapıyor?"
    } ]
  }, {
    "tStartMs": 441200,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "Entelektüel yatırım bilgisini kullanıyor."
    } ]
  }, {
    "tStartMs": 443690,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "Sosyal yatırım yapıyor, çevresini"
    } ]
  }, {
    "tStartMs": 445220,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "kullanıyor, kültürel yatırım yapıyor,"
    } ]
  }, {
    "tStartMs": 446630,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "bulunduğu ortamın kültürel kodlarını"
    } ]
  }, {
    "tStartMs": 449780,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "kullanıyor ve en önemlisi fırsat maliyeti"
    } ]
  }, {
    "tStartMs": 452750,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "yatırımı yapıyor. Yani başka bir işte"
    } ]
  }, {
    "tStartMs": 454250,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "çalışacağına burada çalışıyor."
    } ]
  }, {
    "tStartMs": 456500,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "Şimdi diğer takım elemanı başka bir işte"
    } ]
  }, {
    "tStartMs": 459170,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "çalışıyorsa o yatırım yapmıyor demektir."
    } ]
  }, {
    "tStartMs": 461600,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "O zaman onun takımda olmaması lazım."
    } ]
  }, {
    "tStartMs": 463580,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "Ha ne zaman o da gelir o zaman olur."
    } ]
  }, {
    "tStartMs": 466220,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "Onun için bu bence çok kırmızı bayrak yani"
    } ]
  }, {
    "tStartMs": 469880,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "gerçekten. Kesinlikle öyle."
    } ]
  }, {
    "tStartMs": 471560,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "İki konuyu daha konuşalım."
    } ]
  }, {
    "tStartMs": 472760,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "Burada biri iş modeli aslında zaten hani bir"
    } ]
  }, {
    "tStartMs": 475820,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "önceki modelde iş modelini nasıl"
    } ]
  }, {
    "tStartMs": 478280,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "şekillendirme gerektiğini konuşmuştuk ama"
    } ]
  }, {
    "tStartMs": 481430,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "burada da nasıl vermek gerekiyor iş"
    } ]
  }, {
    "tStartMs": 483380,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "modelini, ne detayda vermek gerekiyor bir"
    } ]
  }, {
    "tStartMs": 485540,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "onu konuşalım. Kritik bir başlık ya da slayt"
    } ]
  }, {
    "tStartMs": 488660,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "ya da belki slaytlar, iş modeli, gelir"
    } ]
  }, {
    "tStartMs": 491630,
    "dDurationMs": 4530,
    "segs": [ {
      "utf8": "modeli karıştırmamak, birlikte anlatmak ya"
    } ]
  }, {
    "tStartMs": 496160,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "da daha sonra anlatmak kaydıyla şunları"
    } ]
  }, {
    "tStartMs": 499220,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "söyleyebiliriz bazı klişeler var iş"
    } ]
  }, {
    "tStartMs": 502310,
    "dDurationMs": 4290,
    "segs": [ {
      "utf8": "modelinde. Örneğin işte yaptığın ürünü ya da"
    } ]
  }, {
    "tStartMs": 506600,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "hizmeti kime satıyorsun?"
    } ]
  }, {
    "tStartMs": 507860,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "Bireye mi, şirkete mi?"
    } ]
  }, {
    "tStartMs": 510200,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "Şirketse B2B diyoruz, işte bireyse B2C"
    } ]
  }, {
    "tStartMs": 512750,
    "dDurationMs": 6280,
    "segs": [ {
      "utf8": "diyoruz. Ama B2B olup da abonelik yazılım"
    } ]
  }, {
    "tStartMs": 519030,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "aboneliği satıyor olabilirsin SaaS dediğimiz"
    } ]
  }, {
    "tStartMs": 521310,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "software as a service, ya da lisans satıyor"
    } ]
  }, {
    "tStartMs": 523620,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "olabiliriz. Dolasıyla gelir modelinde"
    } ]
  }, {
    "tStartMs": 526050,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "değişecek bu durumda mesela saas ise aylık"
    } ]
  }, {
    "tStartMs": 528930,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "gelir ne olacak MRR'a bakacağız."
    } ]
  }, {
    "tStartMs": 531030,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "Lisans satıyorsa yıllık geliri ne olacak?"
    } ]
  }, {
    "tStartMs": 533070,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "ARR'a bakacağız. Yıllık yenileme satıyor"
    } ]
  }, {
    "tStartMs": 535590,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "olacaksın. Yani saas'a göre biraz daha zayıf"
    } ]
  }, {
    "tStartMs": 539220,
    "dDurationMs": 4680,
    "segs": [ {
      "utf8": "bir model ama en azından bir garantisi var"
    } ]
  }, {
    "tStartMs": 543900,
    "dDurationMs": 4350,
    "segs": [ {
      "utf8": "gibi. Bunların her neyse bunlar o jargonu, o"
    } ]
  }, {
    "tStartMs": 548280,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "klişeleri kullanarak ifade etmek şart."
    } ]
  }, {
    "tStartMs": 550950,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Çünkü bunu herkes biliyor."
    } ]
  }, {
    "tStartMs": 552630,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "Ama tabii yeni bazı şeyler de var."
    } ]
  }, {
    "tStartMs": 554460,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "Bu iyi tarafı işin daha az iyi olan tarafı"
    } ]
  }, {
    "tStartMs": 557220,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "da yeni olan şeyler."
    } ]
  }, {
    "tStartMs": 559350,
    "dDurationMs": 4660,
    "segs": [ {
      "utf8": "Mesela B2B ya da çok taraflı multisided."
    } ]
  }, {
    "tStartMs": 564930,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "Ne demek bu, sen oyun yaptın oyunun içinde"
    } ]
  }, {
    "tStartMs": 568050,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "reklam gösterdin."
    } ]
  }, {
    "tStartMs": 569160,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "Kullanıcı kim, oynayan müşteri kim, reklam"
    } ]
  }, {
    "tStartMs": 572310,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "veren. Bu multisided ya da B2B2C."
    } ]
  }, {
    "tStartMs": 575710,
    "dDurationMs": 3530,
    "segs": [ {
      "utf8": "Şimdi dolayısıyla bunu iyi ifade etmek lazım."
    } ]
  }, {
    "tStartMs": 581430,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "Oyun B2C midir?"
    } ]
  }, {
    "tStartMs": 583560,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "Oyununa bağlı. Onun için bunu net bir"
    } ]
  }, {
    "tStartMs": 585750,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "şekilde ifade etmek gerekiyor."
    } ]
  }, {
    "tStartMs": 587100,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "Çünkü büyük bir olasılıkla bunlar klişe ve"
    } ]
  }, {
    "tStartMs": 590040,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "çok bilinen yaygın şeyler olduğu için yanlış"
    } ]
  }, {
    "tStartMs": 592170,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "anlaşılacaktır. Onun için en önemli şey"
    } ]
  }, {
    "tStartMs": 594000,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "yanlış anlaşılmaya engel olmak için B2C"
    } ]
  }, {
    "tStartMs": 597140,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "deyip geçmemek B2C çünkü ya da B2B2C çünkü"
    } ]
  }, {
    "tStartMs": 601760,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "burada parayı veren, kullanan müşteri, gelir"
    } ]
  }, {
    "tStartMs": 605870,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "modeli, lisans, aylık ödeme gibi şeyleri çok"
    } ]
  }, {
    "tStartMs": 609500,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "net bir veya iki slaytta ifade edip"
    } ]
  }, {
    "tStartMs": 612890,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "vurgulayarak anlatmak, hatta mümkünse örnek"
    } ]
  }, {
    "tStartMs": 615170,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "vererek anlatmak lazım."
    } ]
  }, {
    "tStartMs": 617060,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "Evet, burada klişe demek burada kötü bir şey"
    } ]
  }, {
    "tStartMs": 619670,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "değil aslında. Sadece biraz detaylı durmak"
    } ]
  }, {
    "tStartMs": 622520,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "gerektiğinden bahsediyoruz."
    } ]
  }, {
    "tStartMs": 624320,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "Çözümünüzde nasıl detaydan biraz kaçmak"
    } ]
  }, {
    "tStartMs": 626390,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "gerektiğini söylediysek aslında burada"
    } ]
  }, {
    "tStartMs": 629630,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "detaya iyice girmeniz gerektiğini"
    } ]
  }, {
    "tStartMs": 631880,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "öneriyoruz. Aslında sona doğru geldik."
    } ]
  }, {
    "tStartMs": 635510,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "Artık bir istek kısmına geldik."
    } ]
  }, {
    "tStartMs": 638360,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "İzleyicilerden bir şey isteyeceğiz."
    } ]
  }, {
    "tStartMs": 641570,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "Neler isteyebiliriz?"
    } ]
  }, {
    "tStartMs": 643490,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "Bir şey daha eklemek istiyorum B2B ile"
    } ]
  }, {
    "tStartMs": 646790,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "ilgili önemli bir nokta var hani B2B'de"
    } ]
  }, {
    "tStartMs": 651980,
    "dDurationMs": 3010,
    "segs": [ {
      "utf8": "müşterinin şirket ama şirketin büyüklüğü de"
    } ]
  }, {
    "tStartMs": 654990,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "önemli ve ne sattığı da önemli."
    } ]
  }, {
    "tStartMs": 657170,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "Neden önemli? Çünkü diyelim ki online"
    } ]
  }, {
    "tStartMs": 660020,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "satmıyorsun, fatura kesiyorsun tahsilat"
    } ]
  }, {
    "tStartMs": 662150,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "yapıyorsun. Şirket ne kadar büyükse karşıda,"
    } ]
  }, {
    "tStartMs": 664370,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "o tahsilatı alma süren o kadar artıyor."
    } ]
  }, {
    "tStartMs": 667520,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "Ya da tutar ne kadar büyükse."
    } ]
  }, {
    "tStartMs": 668900,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "Onun için ben orada böyle B2B ve B2B ve B2b"
