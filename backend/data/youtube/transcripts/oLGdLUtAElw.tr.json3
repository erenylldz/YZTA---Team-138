  }, {
    "tStartMs": 881540,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "neler olması gerektiğini."
    } ]
  }, {
    "tStartMs": 883230,
    "dDurationMs": 5180,
    "segs": [ {
      "utf8": "Burada farklı aslında kitlelere göre farklı"
