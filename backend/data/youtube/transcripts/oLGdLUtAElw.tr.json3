  }, {
    "tStartMs": 712190,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "büyüklükte sattın ve nasıl tahsil ettiğine"
    } ]
  }, {
    "tStartMs": 714230,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "çok bağlı. Bu zaten nakit akışıyla da o"
    } ]
  }, {
    "tStartMs": 718590,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "zaman oraya göz kırpmış olalım."
    } ]
  }, {
    "tStartMs": 721100,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "Son sayfamızda biraz önce söylediğimiz gibi"
    } ]
  }, {
    "tStartMs": 723420,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "bir şeyler isteyeceğiz dinleyenlerden bu"
