  }, {
    "tStartMs": 890270,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "koyulabilir, bazıları çıkarılabilir."
    } ]
  }, {
    "tStartMs": 892610,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "Yeni bizim senle dinlediğimiz online"
    } ]
  }, {
    "tStartMs": 894380,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "sunumlarda artık bir sayfa ve üç dakika"
