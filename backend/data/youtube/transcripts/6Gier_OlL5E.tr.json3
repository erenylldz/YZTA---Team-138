  }, {
    "tStartMs": 186520,
    "dDurationMs": 630,
    "segs": [ {
      "utf8": "şeyiyle. Evet."
    } ]
  }, {
    "tStartMs": 187870,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "Peki ürünün kendisinden yola çıkarak aslında"
