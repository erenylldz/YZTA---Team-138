  }, {
    "tStartMs": 162010,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "sistemi sen çok basit bir şekilde oradaki"
    } ]
  }, {
    "tStartMs": 164500,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "varlıkları hızla değiştirerek yeni bir oyun"
