  }, {
    "tStartMs": 127630,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "ekosistemi çok da yaşayamıyor."
    } ]
  }, {
    "tStartMs": 129100,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "Yaşayamıyor maalesef yeni yeni yaşamaya"
    } ]
  }, {
    "tStartMs": 131530,
    "dDurationMs": 690,
    "segs": [ {
      "utf8": "başladı diyelim."
    } ]
  }, {
    "tStartMs": 132700,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "Tecrübelerini iyi, ölçeklenebilir ve yeni"
    } ]
  }, {
    "tStartMs": 136330,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "nesil girişim perspektifinden bir ürünle"
    } ]
  }, {
    "tStartMs": 138670,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "sahaya çıkaran insanların başarılı olma"
