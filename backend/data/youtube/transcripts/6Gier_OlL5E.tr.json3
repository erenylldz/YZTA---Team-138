  }, {
    "tStartMs": 166840,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "yapabiliyorsun. Mesela bir oyun stüdyosunun"
    } ]
  }, {
    "tStartMs": 169060,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "bence unfair advantages'ı ya da neden biz"
