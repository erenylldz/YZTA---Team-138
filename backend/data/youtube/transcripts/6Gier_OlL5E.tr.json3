  }, {
    "tStartMs": 109660,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "hakkında bir uygulama, bir oyun veya bir"
    } ]
  }, {
    "tStartMs": 113050,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "çözümle bir problem çözümüyle gelmesi"
    } ]
  }, {
    "tStartMs": 115270,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "aslında ekosistemi girişim ekosistemin"
