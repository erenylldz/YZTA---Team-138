  }, {
    "tStartMs": 191140,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "bir konsept var çarpı on diye."
    } ]
  }, {
    "tStartMs": 193450,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "Senin ürünün aslında biraz önce konuştuğumuz"
    } ]
  }, {
    "tStartMs": 196030,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "problem, kutucuğunun altındaki alternatif"
    } ]
  }, {
    "tStartMs": 198400,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "çözümlerin, yani insanların o problemi"
    } ]
  }, {
    "tStartMs": 200710,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "çözmek için kullandığı farklı yolları on kat"
    } ]
  }, {
    "tStartMs": 204070,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "daha iyi çözüyorsa Senin çözümün aslında"
    } ]
  }, {
    "tStartMs": 207370,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "zaten unfair advantages'ın var."
    } ]
  }, {
    "tStartMs": 209360,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "Yani haksız bir rekabet avantajın oluyor."
    } ]
  }, {
    "tStartMs": 211600,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "Mesela burada şey örneğini verebiliriz belki."
    } ]
  }, {
    "tStartMs": 214180,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "Hani ulaşımdan gidiyoruz da sürekli evet"
    } ]
  }, {
    "tStartMs": 217540,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "işte yağmur yağdı, sen yine araç buldun ama"
    } ]
  }, {
    "tStartMs": 219400,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "trafik tıkalı ise yine çözülmedi problemi"
    } ]
  }, {
    "tStartMs": 221800,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "burada. Mesela alternatif olacak bir şey de"
    } ]
  }, {
    "tStartMs": 224380,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "nedir? Misal scooter elektrikli scooter."
    } ]
  }, {
    "tStartMs": 227140,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "Trafiğe takılmıyorsun."
    } ]
  }, {
    "tStartMs": 229230,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "Yağmura takılabilir ama..."
    } ]
  }, {
    "tStartMs": 230260,
    "dDurationMs": 1790,
    "segs": [ {
      "utf8": "Yağmura takılabilir ama trafiğe takılmaz."
    } ]
  }, {
    "tStartMs": 232060,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "Dolayısıyla 10x bir çözüm."
    } ]
  }, {
    "tStartMs": 234850,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "O koşullar ve o hedef kitle için çözüm"
    } ]
  }, {
    "tStartMs": 236860,
    "dDurationMs": 450,
    "segs": [ {
      "utf8": "olabilir örnek olarak."
    } ]
  }, {
    "tStartMs": 237610,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "Belki yine farklı yurt dışında gördüğümüz"
    } ]
  }, {
    "tStartMs": 241390,
    "dDurationMs": 4050,
    "segs": [ {
      "utf8": "örneklerden, yer altından hızlı tüplerle,"
    } ]
  }, {
    "tStartMs": 245830,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "ulaşımda 10x belki 100 X olacak, o olacak"
    } ]
  }, {
    "tStartMs": 249190,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "ama üründe farklılaşmak ve çarpı on on kat"
    } ]
  }, {
    "tStartMs": 252460,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "daha iyi çözmek, on kat daha hızlı çözmek."
    } ]
  }, {
    "tStartMs": 255070,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "10 kat daha ucuz çözmek."
    } ]
  }, {
    "tStartMs": 256870,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "Aslında sizin çözümünüzü farklılaştıran ve"
    } ]
  }, {
    "tStartMs": 259660,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "haksız rekabet avantajı elde edilen bir şey."
    } ]
  }, {
    "tStartMs": 261850,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "Burada pazar konusu var."
    } ]
  }, {
    "tStartMs": 263200,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "Pazarın ne kadar hızlı büyümesi lazım ki bir"
    } ]
  }, {
    "tStartMs": 265870,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "haksız rekabet avantajı oluştursun."
    } ]
  }, {
    "tStartMs": 268480,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "En az yüzde yirmi yılda büyümesi lazım ki"
    } ]
  }, {
    "tStartMs": 271930,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "böyle bir avantajı olsun. Aslında yine ben"
    } ]
  }, {
    "tStartMs": 274930,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "oyundan bir örnek vereceğim ve üç tane iki"
    } ]
  }, {
    "tStartMs": 277330,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "tane daha şeyi işin içine sokacağım."
    } ]
  }, {
    "tStartMs": 278920,
    "dDurationMs": 5280,
    "segs": [ {
      "utf8": "Bir tanesi zaten var olan kullanıcıların."
    } ]
  }, {
    "tStartMs": 284890,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": ".. Bu da neden bizim cevabı?"
    } ]
  }, {
    "tStartMs": 287350,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "Sen oyun konusunda iyi bir stüdyosun."
    } ]
  }, {
    "tStartMs": 289930,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "Bir oyununda tutmuş bir sürü oyuncun var ve"
    } ]
  }, {
    "tStartMs": 294220,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "kullanmaya devam ediyorlar."
    } ]
  }, {
    "tStartMs": 295600,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "Sen yeni bir oyun yaptığın da aslında bu"
    } ]
  }, {
    "tStartMs": 297370,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "senin için neden biz sorusunun cevabı."
    } ]
  }, {
    "tStartMs": 299140,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "Niye? Çünkü o yeni oyunu onlara"
    } ]
  }, {
    "tStartMs": 300550,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "sunabilirsin, oyunun içinden onları"
    } ]
  }, {
    "tStartMs": 303340,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "tanıtabilirsin. Mesela bu ne oldu bir, neden"
    } ]
  }, {
    "tStartMs": 306550,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "biz sorusunun cevabı oldu."
    } ]
  }, {
    "tStartMs": 309160,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "Aynı şekilde bu yine ürünün hani demin onla"
    } ]
  }, {
    "tStartMs": 311830,
    "dDurationMs": 2930,
    "segs": [ {
      "utf8": "konuşmuştuk, 10x avantajı da sağlıyor çünkü"
    } ]
  }, {
    "tStartMs": 314760,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "teknoloji alt yapın var, onu kullanıyorsun."
    } ]
  }, {
    "tStartMs": 319150,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "Bir de edinme maliyetin çok düşük."
    } ]
  }, {
    "tStartMs": 322300,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "Yani kullanıcı."
    } ]
  }, {
    "tStartMs": 323530,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "Çünkü öbür türlü hiç yoksan reklam"
    } ]
  }, {
    "tStartMs": 325420,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "vereceksin. Ya da içerik üreteceğim ki"
    } ]
  }, {
    "tStartMs": 327070,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "birileri gelsin kullansın."
    } ]
  }, {
    "tStartMs": 328240,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "Eğer ki zaten kullanıyor."
    } ]
  }, {
    "tStartMs": 329740,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "Belki sıkılmaya başladı."
    } ]
  }, {
    "tStartMs": 330910,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "Bir oyunundan yeni oyunu gösterdin ona"
    } ]
  }, {
    "tStartMs": 333460,
    "dDurationMs": 820,
    "segs": [ {
      "utf8": "hızlıca edindi oyunu."
    } ]
  }, {
    "tStartMs": 334280,
    "dDurationMs": 4610,
    "segs": [ {
      "utf8": "Burada dediğin gibi kullanıcı edinme maliyeti"
    } ]
  }, {
    "tStartMs": 338890,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "çok kritik. Bir de biraz önce verdiğin oyun"
    } ]
  }, {
    "tStartMs": 341500,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "örneği aslında çok iyi bir örnek oldu."
    } ]
  }, {
    "tStartMs": 342940,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "Neden? Farklı haksız rekabet avantajlarını"
    } ]
  }, {
    "tStartMs": 345850,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "tek potada erittin. Eee daha önce iyi bir"
    } ]
  }, {
    "tStartMs": 348550,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "oyun yapmış kurucu ekip hali hazırda oyunun"
    } ]
  }, {
    "tStartMs": 351640,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "içinden edinme maliyetini azaltacak  ürün."
    } ]
  }, {
    "tStartMs": 355770,
    "dDurationMs": 3010,
    "segs": [ {
      "utf8": "Hali hazırdaki performans, pazarlama, oyun"
    } ]
  }, {
    "tStartMs": 358780,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "içi dinamikleri, tasarım vesaire gibi"
    } ]
  }, {
    "tStartMs": 361450,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "konularda 10x nasıl daha iyi bir ürün"
    } ]
  }, {
    "tStartMs": 364450,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "geliştirebileceği de dair bilgi birikimi."
    } ]
  }, {
    "tStartMs": 366910,
    "dDurationMs": 720,
    "segs": [ {
      "utf8": "Altyapı..."
    } ]
  }, {
    "tStartMs": 367630,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "Teknolojik altyapı ve aslında hızlı büyüyen"
    } ]
  }, {
    "tStartMs": 369900,
    "dDurationMs": 130,
    "segs": [ {
      "utf8": "pazar."
    } ]
  }, {
    "tStartMs": 370030,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "Evet, hızlı büyüyen pazarı da evet eklemek"
    } ]
  }, {
    "tStartMs": 373930,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "lazım. O da kritik. Çünkü oyun pazarı hızlı"
    } ]
  }, {
    "tStartMs": 375880,
    "dDurationMs": 300,
    "segs": [ {
      "utf8": "büyüyor."
    } ]
  }, {
    "tStartMs": 376180,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Bu kutucukların aslında, hepsini konuştuk."
    } ]
  }, {
    "tStartMs": 378280,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "Senin biraz önce verdiğin örnek de gayet"
    } ]
  }, {
    "tStartMs": 380320,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "hepsini kapsayıcı bir örnekti."
    } ]
  }, {
    "tStartMs": 382390,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "Haksız rekabet avantajı neden biz sorusunu"
    } ]
  }, {
    "tStartMs": 385990,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "cevaplıyor. Bununla beraber hangi problemi"
    } ]
  }, {
    "tStartMs": 389470,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "çözüyoruz? Kimin hangi problemini çözüyoruz?"
    } ]
  }, {
    "tStartMs": 392230,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Hangi metriklere bakarak çözüyoruz?"
    } ]
  }, {
    "tStartMs": 394360,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "İşin duygusal tarafı ve aslında çözümümüzün"
    } ]
  }, {
    "tStartMs": 398620,
    "dDurationMs": 4350,
    "segs": [ {
      "utf8": "tek cümleyle albenisi yüksek yaklaşımı var."
    } ]
  }, {
    "tStartMs": 403720,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "Konuşmadığımız aslında kanallar kaldı."
    } ]
  }, {
    "tStartMs": 406660,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "Kanallara da değinelim."
    } ]
  }, {
    "tStartMs": 408550,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "Kanallar nedir abi ?."
    } ]
  }, {
    "tStartMs": 409450,
    "dDurationMs": 2570,
    "segs": [ {
      "utf8": "Kanallar bu hedef kitleye nereden"
    } ]
  }, {
    "tStartMs": 412020,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "ulaşacaksın ?"
    } ]
  }, {
    "tStartMs": 413670,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "İçerik pazarlamasıyla mı ulaşacaksın?"
    } ]
  }, {
    "tStartMs": 416470,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "Para harcayıp, Google'da reklam verip mi"
    } ]
  }, {
    "tStartMs": 419500,
    "dDurationMs": 4050,
    "segs": [ {
      "utf8": "ulaşacaksınız? Sokağa çıkıp broşürü mü daha"
    } ]
  }, {
    "tStartMs": 423550,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "atacaksın? Yahut da alışveriş merkezlerinde"
    } ]
  }, {
    "tStartMs": 426880,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "stand mı açacaksın?"
    } ]
  }, {
    "tStartMs": 428620,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Kanal bunlar. Ya da e-posta pazarlaması mı"
    } ]
  }, {
    "tStartMs": 431620,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "yapacaksın. Hepsi kanal bunlar."
    } ]
  }, {
    "tStartMs": 432940,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "Buradaki kritik nokta şu tanımladığınız"
    } ]
  }, {
    "tStartMs": 436030,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "personalar veya kitleler hedef kitlelerle en"
    } ]
  }, {
    "tStartMs": 440290,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "uygun kanalı seçmek önemli."
    } ]
  }, {
    "tStartMs": 443260,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "Eğer sizin kanalınızın, sizin kanalınız da o"
    } ]
  }, {
    "tStartMs": 447280,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "hedef kitle yoksa, sıkça kullandığı bir"
    } ]
  }, {
    "tStartMs": 449320,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "kanal değilse aslında boş yere zaman, efor"
    } ]
  }, {
    "tStartMs": 451900,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "veya para harcıyor olabilirsiniz."
    } ]
  }, {
    "tStartMs": 453820,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "O yüzden eee o personal'larla yaptığınız"
    } ]
  }, {
    "tStartMs": 456040,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "birebir görüşmelerde veya detaylı"
    } ]
  }, {
    "tStartMs": 457780,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "incelemelerde onların en çok kullandığı"
    } ]
  }, {
    "tStartMs": 460300,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "kanalları sayfaları, ürünleri"
    } ]
  }, {
    "tStartMs": 464440,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "inceleyebilirsiniz, not alabilirsiniz,"
    } ]
  }, {
    "tStartMs": 466570,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "kanallarınızı test edebilirsiniz bu şekilde."
    } ]
  }, {
    "tStartMs": 469330,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "Evet zaten bunun ayrıntısına gireceğimiz"
    } ]
  }, {
    "tStartMs": 472930,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "modül ve dersler de var zaten."
    } ]
  }, {
    "tStartMs": 475150,
    "dDurationMs": 5130,
    "segs": [ {
      "utf8": "Aynen öyle. O zaman bu dersin ve bu modülün"
    } ]
  }, {
    "tStartMs": 480280,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "aslında sonuna geldik."
    } ]
  }, {
    "tStartMs": 481690,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "Eee bu modülde neler konuştuğumuzu hızlıca"
    } ]
  }, {
    "tStartMs": 483730,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "bir özetleyelim. Problem tanımından problem"
    } ]
  }, {
    "tStartMs": 488620,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "doğrulamasına. Çözüm tanımından aslında"
    } ]
  }, {
    "tStartMs": 491560,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "çözümü kim tanımlayacaktan ekibe, mvp'ye  ve"
    } ]
  }, {
    "tStartMs": 494510,
    "dDurationMs": 3290,
    "segs": [ {
      "utf8": "mtp'ye daha sonra da çözüm doğrulamaya ve"
    } ]
  }, {
    "tStartMs": 497800,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "bunların en kritik olduğu nokta bunların"
    } ]
  }, {
    "tStartMs": 500140,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "uyumuna baktık."
    } ]
  }, {
    "tStartMs": 501700,
    "dDurationMs": 4130,
    "segs": [ {
      "utf8": "Daha sonra yalın kanvas bu uyum, uyumunu"
    } ]
  }, {
    "tStartMs": 505830,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "bulduğumuz çözümü, uygulamayı, oyunu veya"
    } ]
  }, {
    "tStartMs": 509590,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "girişimi biz nasıl anlatırız insanlara veya"
    } ]
  }, {
    "tStartMs": 512920,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "biz nasıl anlarız kısa bir sürede dedik ve"
    } ]
  }, {
    "tStartMs": 515470,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "yalın kanvas konuşmaya başladık."
    } ]
  }, {
    "tStartMs": 517240,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "Yalın kanvas kutucuklarında detaylı konuştuk"
    } ]
  }, {
    "tStartMs": 520180,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "ve ekibimizde  sürekli kurucu ortakların"
    } ]
  }, {
    "tStartMs": 523390,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "sürekli gözünün önünde olması gereken bir"
    } ]
  }, {
    "tStartMs": 525580,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "döküman, bir belge olduğunu da belirttik."
    } ]
  }, {
    "tStartMs": 528580,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "Eee bundan sonraki modülümüzde yine detaylı."
    } ]
  }, {
    "tStartMs": 532450,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "Bunların altındaki bazı konseptleri"
    } ]
  }, {
    "tStartMs": 534580,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "anlatmaya devam edeceğiz."
    } ]
  } ]
}
