  }, {
    "tStartMs": 178000,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "tane yapıyorsun deniyorsun."
    } ]
  }, {
    "tStartMs": 179090,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "Bunun maliyeti çok düşük."
    } ]
  }, {
    "tStartMs": 180820,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "Bu altyapı örneği de teknoloji."
    } ]
  }, {
    "tStartMs": 182110,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "Ürünün kendisi."
    } ]
  }, {
    "tStartMs": 183640,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "Teknoloji ve bütün her şey, süreçleri ve her"
