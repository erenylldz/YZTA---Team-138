  }, {
    "tStartMs": 174130,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "önce denenmiş, çalışmış oyunlar var."
    } ]
  }, {
    "tStartMs": 176200,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Oradaki şeyi altyapıyı kullanarak yeni bir"
