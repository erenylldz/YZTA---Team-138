  }, {
    "tStartMs": 100420,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "leşmiş ve tecrübe edinmiş insanların, yani"
    } ]
  }, {
    "tStartMs": 103780,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "sıkça çuvallamış insanların veya bir konu"
    } ]
  }, {
    "tStartMs": 106900,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "hakkında derinleşmiş insanların, o konu"
