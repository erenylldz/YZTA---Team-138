  }, {
    "tStartMs": 141160,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "oranı biraz daha artıyor."
    } ]
  }, {
    "tStartMs": 142630,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "O yüzden ilk konumuz kurucu ortaklar dedik."
    } ]
  }, {
    "tStartMs": 145150,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "Kurucu ortakların geçmişleri sayesinde"
    } ]
  }, {
    "tStartMs": 148780,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "haksız rekabet elde edilebilir dedik, ikinci"
    } ]
  }, {
    "tStartMs": 151000,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "konu ne ?"
    } ]
  }, {
    "tStartMs": 151930,
    "dDurationMs": 3130,
    "segs": [ {
      "utf8": "Bu mesela tekrar oyuna gitti aklım şu anda."
    } ]
  }, {
    "tStartMs": 155060,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "Oyunda mesela ürün dediğimiz şey oyunun"
