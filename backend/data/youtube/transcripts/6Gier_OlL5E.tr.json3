  "events": [ {
    "tStartMs": 90,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "Tekrar merhaba. Bu dersimizde haksız rekabet"
    } ]
  }, {
    "tStartMs": 3210,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "avantajının detaylarına ineceğiz."
    } ]
  }, {
    "tStartMs": 6030,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "Asıl soru burada. Neden bizde?"
    } ]
  }, {
    "tStartMs": 8190,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "Evet aslında neden biz belki de neden biz"
    } ]
  }, {
    "tStartMs": 10710,
    "dDurationMs": 420,
    "segs": [ {
      "utf8": "olmayalım ?"
    } ]
  }, {
    "tStartMs": 11490,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "Kaç oldu ve neden biz?"
    } ]
  }, {
    "tStartMs": 14130,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "Neden biz?"
    } ]
  }, {
    "tStartMs": 15790,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "Neden biz? Çünkü belli bir şeylerde o kadar"
    } ]
  }, {
    "tStartMs": 18670,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "iyiyizdir ki bu işi bizden daha iyi kimse"
    } ]
  }, {
    "tStartMs": 21070,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "yapamayacaktır. Bu aslında bizim yola çıkış"
    } ]
  }, {
    "tStartMs": 24700,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "sebeplerinden birisi olması gereken bir"
    } ]
  }, {
    "tStartMs": 27940,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "konu. Bir kutucuk kendimize güveni arttıran,"
    } ]
  }, {
    "tStartMs": 31300,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "yatırımcılara veya bazı müşterilere"
    } ]
  }, {
    "tStartMs": 35740,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "güvenilirliğimizi arttıran bir kutucuk bu."
    } ]
  }, {
    "tStartMs": 37960,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "Evet, mesela geçmişte bir örnek hatırlıyorum"
    } ]
  }, {
    "tStartMs": 39940,
    "dDurationMs": 4250,
    "segs": [ {
      "utf8": "ben senin de kurucusu olduğun bir girişimde"
    } ]
  }, {
    "tStartMs": 44190,
    "dDurationMs": 3070,
    "segs": [ {
      "utf8": "diğer ortağın 400 yıldır tarımla uğraşıyordu"
    } ]
  }, {
    "tStartMs": 47260,
    "dDurationMs": 300,
    "segs": [ {
      "utf8": "değil mi?"
    } ]
  }, {
    "tStartMs": 47740,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "Evet, bir tarım girişimimde ortağımın ailesi"
    } ]
  }, {
    "tStartMs": 52420,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "sülalelerce aslında geçmişe dayanan bir tarım"
    } ]
  }, {
    "tStartMs": 55450,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "geçmişi vardı. O gerçekten haksız bir"
    } ]
  }, {
    "tStartMs": 58150,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "rekabet avantajı."
    } ]
  }, {
    "tStartMs": 59740,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "O dört yüzyılı biriktirmek kolay değil"
    } ]
  }, {
    "tStartMs": 61480,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "gerçekten. Burada aslında sen ilk maddeyi"
    } ]
  }, {
    "tStartMs": 65740,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "söylemiş oldun. Kurucular..."
    } ]
  }, {
    "tStartMs": 68470,
    "dDurationMs": 4860,
    "segs": [ {
      "utf8": "Kurucuların geçmişi aslında CV'si."
    } ]
  }, {
    "tStartMs": 73330,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "Daha önce çalıştıkları yerler."
    } ]
  }, {
    "tStartMs": 74710,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "Tecrübeleri bir haksız rekabet avantajı"
    } ]
  }, {
    "tStartMs": 77530,
    "dDurationMs": 480,
    "segs": [ {
      "utf8": "yaratır mı?"
    } ]
  }, {
    "tStartMs": 78490,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "Kesinlikle yaratır. Hatta sadece başarıları,"
    } ]
  }, {
    "tStartMs": 81760,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "bilgileri değil, başarısızlıkları da"
    } ]
  }, {
    "tStartMs": 83410,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "yaratır. Çünkü o zaman neyi yapmayacaklarını"
    } ]
  }, {
    "tStartMs": 86290,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "öğrenmiş olurlar ve onları başkaları"
    } ]
  }, {
    "tStartMs": 89260,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "denerken kendileri onları atlayıp öne"
    } ]
  }, {
    "tStartMs": 91810,
    "dDurationMs": 660,
    "segs": [ {
      "utf8": "geçebilirler."
    } ]
  }, {
    "tStartMs": 92590,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "Büyük bir zaman kazanacaklar aslında."
    } ]
  }, {
    "tStartMs": 95290,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "Burada aslında minik bir dipnot düşelim."
    } ]
  }, {
    "tStartMs": 97420,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "Yine bu yüzden belli bir konuda spesifik"
