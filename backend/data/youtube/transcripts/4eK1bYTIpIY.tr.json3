  "events": [ {
    "tStartMs": 180,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "Tekrar merhaba. Bu dersimizde bir önceki"
    } ]
  }, {
    "tStartMs": 3660,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "dersimizde konuştuğumuz aslında teknoloji"
    } ]
  }, {
    "tStartMs": 6000,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "benimseme eğrisinin bölümlerini detaylı"
    } ]
  }, {
    "tStartMs": 8970,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "konuşmaya devam edeceğiz."
    } ]
  }, {
    "tStartMs": 11310,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Bir önceki seferde erken uyananlar, erken"
    } ]
  }, {
    "tStartMs": 13650,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "benimseyenler ve erken çoğunluk erken"
    } ]
  }, {
    "tStartMs": 16170,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "çoğunluğun içindeki aslında inovasyon"
    } ]
  }, {
    "tStartMs": 18420,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "uçurumu ve fırsat penceresi yakalama"
    } ]
  }, {
    "tStartMs": 23130,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "taktiklerinden biraz bahsetmiştik."
    } ]
  }, {
    "tStartMs": 25140,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "Şimdi artık aslında ürünümüzü belli bir"
    } ]
  }, {
    "tStartMs": 27690,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "seviyeye getirdik. Belki erken benimseyenler"
    } ]
  }, {
    "tStartMs": 31140,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "ve erken uyananlar gitti ama erken çoğunluğu"
    } ]
  }, {
    "tStartMs": 33960,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "da biz iki taktikle içerde tuttuk veya"
    } ]
  }, {
    "tStartMs": 36480,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "kasırga metoduyla içerde tuttuk."
    } ]
  }, {
    "tStartMs": 38370,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "Bir sürü fonksiyonu erken çoğunluğa vererek"
    } ]
  }, {
    "tStartMs": 41520,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "ya da bowling topu efekti ile içerde tuttuk."
    } ]
  }, {
    "tStartMs": 44400,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "En çok çalışan, en çok ilgi gören"
    } ]
  }, {
    "tStartMs": 47040,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "fonksiyonumuzu ön plana çıkararak erken"
    } ]
  }, {
    "tStartMs": 50010,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "çoğunluğu içeride tuttuk."
    } ]
  }, {
    "tStartMs": 51600,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "Artık kullanım arttı."
    } ]
  }, {
    "tStartMs": 54570,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "Belki para kazanmaya başladık."
    } ]
  }, {
    "tStartMs": 56730,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "Peki geç çoğunluk?"
    } ]
  }, {
    "tStartMs": 58410,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "O çoğunluğun sonuçta büyük bir kısmını,"
    } ]
  }, {
    "tStartMs": 60450,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "yarısını oluşturuyor. Onlar kimdir?"
    } ]
  }, {
    "tStartMs": 63960,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "Geç çoğunluğun tanımı aslında çok basit."
    } ]
  }, {
    "tStartMs": 66450,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "Artık şu soruyu sormuyor."
    } ]
  }, {
    "tStartMs": 68490,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "Başka kim kullanıyor? Çünkü görüyor."
    } ]
  }, {
    "tStartMs": 70530,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "Senin web sitene ya da uygulamana baktığı"
    } ]
  }, {
    "tStartMs": 72300,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "zaman sayılardan ya da referanslardan tamam"
    } ]
  }, {
    "tStartMs": 74850,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "bunlar olmuş diyor."
    } ]
  }, {
    "tStartMs": 76800,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "Senle pazarlık etmeye başlıyor, indirim"
    } ]
  }, {
    "tStartMs": 78960,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "yapar mısın diyor, işte vade yapar mısın"
    } ]
  }, {
    "tStartMs": 81060,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "diyor. Ben sonra ödeyeyim diyor bana işte"
    } ]
  }, {
    "tStartMs": 83970,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "ücretsiz kullanıcı ver diyor vesaire"
    } ]
  }, {
    "tStartMs": 85800,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "vesaire. Bu tamamen bir geç çoğunluk"
    } ]
  }, {
    "tStartMs": 88080,
    "dDurationMs": 540,
    "segs": [ {
      "utf8": "tavrıdır."
    } ]
  }, {
    "tStartMs": 88980,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "Fırsatçılar diyebilir miyiz?"
    } ]
  }, {
    "tStartMs": 91530,
    "dDurationMs": 4530,
    "segs": [ {
      "utf8": "Yok, geç kaldıkları için yakalayabilmek adına"
    } ]
  }, {
    "tStartMs": 96060,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "kendilerini ikna için bence onu kullanıyor."
    } ]
  }, {
    "tStartMs": 98100,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "Başka bir nedeni olamaz yani."
    } ]
  }, {
    "tStartMs": 99750,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "Çünkü zaten geç kalmış. Aslında bedelini"
    } ]
  }, {
    "tStartMs": 101880,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "ödemiş onun o."
    } ]
  }, {
    "tStartMs": 103070,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "Rakipleri kullanmış."
    } ]
  }, {
    "tStartMs": 104370,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "Geç kalarak ödemiş ya da alternatif"
    } ]
  }, {
    "tStartMs": 106320,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "çözümler ilerlemiş."
    } ]
  }, {
    "tStartMs": 109220,
    "dDurationMs": 2890,
    "segs": [ {
      "utf8": "Orada sen bu kampanyaları, işte indirim"
    } ]
  }, {
    "tStartMs": 112110,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "kodlarını veya işte dediği gibi vade"
    } ]
  }, {
    "tStartMs": 115110,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "tanımlamalarını geç, ödeme imkanlarını geç"
    } ]
  }, {
    "tStartMs": 118450,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "çoğunluğa vermezsen ne tepki veriyorlar?"
    } ]
  }, {
    "tStartMs": 120450,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "Rakibinden alıyorlar çünkü artık rakibin var."
    } ]
  }, {
    "tStartMs": 123000,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "Yani dedim ya, fırsat penceresinin temel"
    } ]
  }, {
    "tStartMs": 125850,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "nedeni rakiplerinin yokluğu ya da azlığı."
    } ]
  }, {
    "tStartMs": 128760,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "Bu da artık alternatif çözümlerden geçtik."
    } ]
  }, {
    "tStartMs": 130830,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "Gerçek rakipler çıkmaya başladı."
    } ]
  }, {
    "tStartMs": 132990,
    "dDurationMs": 4220,
    "segs": [ {
      "utf8": "Alternatif çözümler daha çok önceki işte"
    } ]
  }, {
    "tStartMs": 137210,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "innovator early adopter'ların dünyasının"
    } ]
  }, {
    "tStartMs": 140820,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "gerçekleri."
    } ]
  }, {
    "tStartMs": 141990,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Burada rakipler var, farklar olabilir, fiyat"
    } ]
  }, {
    "tStartMs": 144990,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "farklı olabilir, özellik farklı olabilir ama"
    } ]
  }, {
    "tStartMs": 146520,
    "dDurationMs": 4290,
    "segs": [ {
      "utf8": "var. Dolayısıyla artık seni almazsa rakibine"
    } ]
  }, {
    "tStartMs": 150810,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "alacak problem mi?"
    } ]
  }, {
    "tStartMs": 153450,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "Bence değil. AAARRR'yi şimdi konuştuğumuzda"
    } ]
  }, {
    "tStartMs": 158070,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "neden problem olmayabileceğini de"
    } ]
  }, {
    "tStartMs": 159900,
    "dDurationMs": 810,
    "segs": [ {
      "utf8": "konuşacağız zaten."
    } ]
  }, {
    "tStartMs": 160800,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "Tamam o zaman yine de zaten siz de aslında"
    } ]
  }, {
    "tStartMs": 164070,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "bazı uygulamaları veya bazı ürünleri geç"
    } ]
  }, {
    "tStartMs": 167310,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "çoğunluk olarak kullandığınızı şu an"
    } ]
  }, {
    "tStartMs": 169290,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "farketmiş olmanız lazım."
    } ]
  }, {
    "tStartMs": 171240,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "İndirim geldikçe kullandığımız, kampanya"
    } ]
  }, {
    "tStartMs": 173610,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "geldikçe kullandığımız."
    } ]
  }, {
    "tStartMs": 175320,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "Bazen hani uygulamayı sildiğimiz ama oradaki"
    } ]
  }, {
    "tStartMs": 179640,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "fırsatı kaçırmamak için tekrar indirdiğimiz"
    } ]
  }, {
    "tStartMs": 181620,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "bir sürü uygulama oluyor."
    } ]
  }, {
    "tStartMs": 183870,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "Eminim ki o uygulamayı geliştirenler kurucu"
    } ]
  }, {
    "tStartMs": 187050,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "ekipleri de sizin farkınızda ve çok"
    } ]
  }, {
    "tStartMs": 189210,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "üzülüyorlar. Keşke uygulamamızı silmeseler"
    } ]
  }, {
    "tStartMs": 192150,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "hep tutsalar, keşke erken çoğunluğa"
    } ]
  }, {
    "tStartMs": 194700,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "kaydırabilsek diyorlar aslında bizim"
    } ]
  }, {
    "tStartMs": 197280,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "gibileri bu tarz uygulamaları bu tarz"
    } ]
  }, {
    "tStartMs": 200070,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "şekilde kullananlara."
    } ]
  }, {
    "tStartMs": 201270,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "Şimdi aslında gelenekselcilere geçelim,"
    } ]
  }, {
    "tStartMs": 203430,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "herkesin aslında göz ardı ettiği bir kitle."
    } ]
  }, {
    "tStartMs": 205530,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "Sen biraz önce çok güzel, tanımladın yüz"
    } ]
  }, {
    "tStartMs": 207270,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "milyon kişilik bir hedef kitlem varsa"
    } ]
  }, {
    "tStartMs": 210570,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "aslında on beş milyon kişiyi aslında baştan"
    } ]
  }, {
    "tStartMs": 215160,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "gelenekselci olarak kabul etmek gerekir."
    } ]
  }, {
    "tStartMs": 217350,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Yani onlarla uğraşmamak gerekir."
    } ]
  }, {
    "tStartMs": 219480,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "Hatta şu örneği veriyorum ben özellikle B2B"
    } ]
  }, {
    "tStartMs": 222630,
    "dDurationMs": 5190,
    "segs": [ {
      "utf8": "iş yapanlarda, bu eğrinin farkında olmayan"
    } ]
  }, {
    "tStartMs": 228690,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "girişimler ya da girişimciler her müşteriye"
    } ]
  }, {
    "tStartMs": 231360,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "aynı muameleyi, her müşteri için aynı çabayı"
    } ]
  }, {
    "tStartMs": 233700,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "harcıyor. Ben de bunun için çok basit bazı"
    } ]
  }, {
    "tStartMs": 236550,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "kurallar koyduğum zamanında."
    } ]
  }, {
    "tStartMs": 237780,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "Yani benim kuralım değil ama uyulması"
    } ]
  }, {
    "tStartMs": 241320,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "gereken bir kural bu."
    } ]
  }, {
    "tStartMs": 242730,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "O da şu. Sen belli büyüklükte bir kuruma bir"
    } ]
  }, {
    "tStartMs": 245670,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "yazılım çözümünü b2b olarak satacaksınız."
    } ]
  }, {
    "tStartMs": 249000,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "Randevu aldın gittin."
    } ]
  }, {
    "tStartMs": 250890,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "Dediler ki ha güzel tamam biz filancalarla"
    } ]
  }, {
    "tStartMs": 254340,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "görüşelim. Tekrar bir görüşmek istiyoruz."
    } ]
  }, {
    "tStartMs": 255870,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "Tamam okay bir daha gittin bir daha görüşün"
    } ]
  }, {
    "tStartMs": 257490,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "güzel... Biz bir toplantı daha yapalım."
    } ]
  }, {
    "tStartMs": 259830,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "Bu sinyal."
    } ]
  }, {
    "tStartMs": 261220,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "Hemen kaçacaksın oradan. Çünkü o almayacak."
    } ]
  }, {
    "tStartMs": 263520,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "Tamam o büyük ihtimalle zaten gelenekselci"
    } ]
  }, {
    "tStartMs": 268410,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "ya da geç çoğunluğun sonlarında."
    } ]
  }, {
    "tStartMs": 271500,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "Yani bunlardan var."
    } ]
  }, {
    "tStartMs": 273390,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "Az var ama var. Yani 100 milyon da 15 20"
    } ]
  }, {
    "tStartMs": 276570,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "milyon var mesela.  Onun için bundan kaçman"
    } ]
  }, {
    "tStartMs": 279210,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "lazım. Çünkü oraya harcadığın çaba sana"
    } ]
  }, {
    "tStartMs": 281340,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "maliyet ve getirisi olmayacak."
    } ]
  }, {
    "tStartMs": 283890,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "Onun için oradaki kural şu İkinci toplantıda"
    } ]
  }, {
    "tStartMs": 287190,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "almıyor ya da teklif istemiyorsa senden."
    } ]
  }, {
    "tStartMs": 289800,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "O gelenekselcidir büyük olasılıkla."
    } ]
  }, {
    "tStartMs": 293070,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "Bazı tabii ki alarm mekanizmaları kurup"
    } ]
  }, {
    "tStartMs": 295290,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "kendinizce onların erken çoğunluk veya geç"
    } ]
  }, {
    "tStartMs": 298590,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "çoğunluk olabilme ihtimallerini unutmamak"
    } ]
  }, {
    "tStartMs": 300690,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "gerekiyor. Bu b2b çalışan için, b2b çalışan"
    } ]
  }, {
    "tStartMs": 304050,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "girişimler için ,uygulamalar için veya yeni"
    } ]
  }, {
    "tStartMs": 307390,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "nesil girişimler için geçerli olabilir."
    } ]
  }, {
    "tStartMs": 309540,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "B2C çalışan direkt kullanıcıya giden"
    } ]
  }, {
    "tStartMs": 312480,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "ürünlerde bu nasıl hitap buluyor?"
    } ]
  }, {
    "tStartMs": 315330,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "Bu da uygulamayı silmek."
    } ]
  }, {
    "tStartMs": 317100,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "Mesela uygulamaysa ya da oyunsa oyunu silmek"
    } ]
  }, {
    "tStartMs": 320010,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "şeklinde görünüyor."
    } ]
  }, {
    "tStartMs": 323700,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "Çünkü yükletmek çok kolay."
    } ]
  }, {
    "tStartMs": 325030,
    "dDurationMs": 4010,
    "segs": [ {
      "utf8": "Aslında bugünkü dijital pazarlama yöntemleri"
    } ]
  }, {
    "tStartMs": 329390,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "ilgili ilgisiz herkese yükletebiliyor."
    } ]
  }, {
    "tStartMs": 331470,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Şu veya bu nedenle hiç kullanmadan"
    } ]
  }, {
    "tStartMs": 333270,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "siliyorsa, ihtimal ki o zaten yanlışlıkla"
    } ]
  }, {
    "tStartMs": 336570,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "yüklemiştir. Büyük ihtimalle"
    } ]
  }, {
    "tStartMs": 338580,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "gelenekselcidir ya da geç çoğunluğun"
    } ]
  }, {
    "tStartMs": 341220,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "sonlarındadır."
    } ]
  }, {
    "tStartMs": 342480,
    "dDurationMs": 780,
    "segs": [ {
      "utf8": "Ya da hiç indirmeyebilir."
    } ]
  }, {
    "tStartMs": 343860,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "Hiç indirmiyorsa haberin olmayacağı için"
    } ]
  }, {
    "tStartMs": 345600,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "yapacak bir şey yok orada."
    } ]
  }, {
    "tStartMs": 347850,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "Yani orada."
    } ]
  }, {
    "tStartMs": 349050,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Onu da şöyle anlıyorsun."
    } ]
  }, {
    "tStartMs": 350850,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "100 milyon iddiam var."
    } ]
  }, {
    "tStartMs": 352050,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "Bir şekilde de doğrulamışsın bunu."
    } ]
  }, {
    "tStartMs": 354540,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "Yüz milyona hedeflemek için reklam"
    } ]
  }, {
    "tStartMs": 356280,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "yapıyorsun ama bir türlü atıyorum 60 milyonu"
    } ]
  }, {
    "tStartMs": 359040,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "geçmiyor. Senin dokunduğumuz şey sayısı,"
    } ]
  }, {
    "tStartMs": 361830,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "kullanıcı sayısı."
    } ]
  }, {
    "tStartMs": 362890,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "Gerçi şimdi kullanıcıyı da tanımak çok mümkün"
    } ]
  }, {
    "tStartMs": 365130,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "değil. Biliyorsunuz sildiği zaman şey"
    } ]
  }, {
    "tStartMs": 366990,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "değişiyor ya id'si değişiyor ya o da ayrı"
    } ]
  }, {
    "tStartMs": 369390,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "bir konu başlı başına."
    } ]
  }, {
    "tStartMs": 371940,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "Diyelim ki o yok."
    } ]
  }, {
    "tStartMs": 373470,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "O zaman ulaşamıyorsan dert etme."
    } ]
  }, {
    "tStartMs": 376260,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "Çünkü zaten ulaşamayacaksın."
    } ]
  }, {
    "tStartMs": 378360,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "O aslında aralığı vermek, kendine tanımlamak"
    } ]
  }, {
    "tStartMs": 381840,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "önemli. Şimdi aslında o ikinci bölüme"
    } ]
  }, {
    "tStartMs": 384120,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "geçelim. Bu modülün önemli ikinci bölümüne o"
    } ]
  }, {
    "tStartMs": 387150,
    "dDurationMs": 4670,
    "segs": [ {
      "utf8": "da AAARRR gibi bir tezahürat tanımladık"
    } ]
  }, {
    "tStartMs": 391820,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "burada.  İlk üç A'dan"
    } ]
  }, {
    "tStartMs": 394820,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "bahsetmiştik.Awareness,Acquisition,Activation."
    } ]
  }, {
    "tStartMs": 398030,
    "dDurationMs": 4690,
    "segs": [ {
      "utf8": "Farkındalık, müşteriyi edinme ve aktive etme."
    } ]
  }, {
    "tStartMs": 403170,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "Ben kullandırtmadan bahsetmiştik biraz"
    } ]
  }, {
    "tStartMs": 405870,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "bunları deşelim istersen."
    } ]
  }, {
    "tStartMs": 409590,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "Farkındalık aşamasında bir ayrım var hep"
    } ]
  }, {
    "tStartMs": 412770,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "tartıştığımız aslında bu aslında marka,"
    } ]
  }, {
    "tStartMs": 416010,
    "dDurationMs": 3770,
    "segs": [ {
      "utf8": "marka görünürlüğü ve aslında tanıtım farkı."
    } ]
  }, {
    "tStartMs": 420390,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "Bir ondan bahsedelim istersen."
    } ]
  }, {
    "tStartMs": 422800,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Mesela Awareness iki türlü algılanabilir bir"
    } ]
  }, {
    "tStartMs": 424800,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "tanesi zaten var olan, rekabeti olan"
    } ]
  }, {
    "tStartMs": 427740,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "ürünlerde ben de bu işi yapıyorum"
    } ]
  }, {
    "tStartMs": 431940,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "farkındalığını yaratmak."
    } ]
  }, {
    "tStartMs": 433650,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "Ama yeni olan ürünlerde yine bizim ulaşım"
    } ]
  }, {
    "tStartMs": 435720,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "örneğine dönersek, bu elektrikli"
    } ]
  }, {
    "tStartMs": 438480,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "scooter'larda mesela bu yeni bir şey."
    } ]
  }, {
    "tStartMs": 440310,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Türkiye'de de iki sene oldu ama iki sene"
    } ]
  }, {
    "tStartMs": 442650,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "önceye geri dön. Çoğu insan bunu, ne"
    } ]
  }, {
    "tStartMs": 444420,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "olduğunu anlamıyordu bile."
    } ]
  }, {
    "tStartMs": 445740,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "Böyle bir uzaylı gibi birisi geçiyordu"
    } ]
  }, {
    "tStartMs": 447930,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "yanımdan. İşte orada farkındalık yaratman"
    } ]
  }, {
    "tStartMs": 450600,
    "dDurationMs": 4050,
    "segs": [ {
      "utf8": "lazım ki bu bir alternatif taşıma aracıdır"
    } ]
  }, {
    "tStartMs": 454650,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "ve kiralanabilir satın alman gerekmiyor."
    } ]
  }, {
    "tStartMs": 457680,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "Mesela bisikletlerin kiralanabilirliği bir"
    } ]
  }, {
    "tStartMs": 460890,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "zaman önce insan içine çıktı ve insanlar"
    } ]
  }, {
    "tStartMs": 464280,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "biliyor artık. Yani o bisikletleri görünce"
    } ]
  }, {
    "tStartMs": 466680,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "renklerinden, şeylerinden tanıyor."
    } ]
  }, {
    "tStartMs": 468720,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Ama bu scooter'lar ilk çıktığında kimse"
    } ]
  }, {
    "tStartMs": 470520,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "anlamıyordu. Onun için işte ne yapman lazım?"
    } ]
  }, {
    "tStartMs": 473460,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Farkındalık yaratmak lazım ki bu bir ulaşım"
    } ]
  }, {
    "tStartMs": 475740,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "aracıdır. Kiralanabilir ve makul fiyatla"
    } ]
  }, {
    "tStartMs": 478560,
    "dDurationMs": 750,
    "segs": [ {
      "utf8": "kiralanabilir."
    } ]
  }, {
    "tStartMs": 479820,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "Burada tabii ki tanıtımı yani ürünün"
    } ]
  }, {
    "tStartMs": 482340,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "kullanımını, çözdüğü problemi tanıtmak ve"
    } ]
  }, {
    "tStartMs": 485910,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "onu kendi markam ile bağlamak aslında"
    } ]
  }, {
    "tStartMs": 488430,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "farkındalığın tümünü oluşturuyor."
    } ]
  }, {
    "tStartMs": 492420,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "Burada ikincisini de konuşalım."
    } ]
  }, {
    "tStartMs": 494430,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "Daha sonraki derste devam edelim kalanına."
    } ]
  }, {
    "tStartMs": 497460,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "İkincisi de Acquisition burası aslında büyük"
    } ]
  }, {
    "tStartMs": 499530,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "bir kalem. Acquisition, müşteriyi edinme."
    } ]
  }, {
    "tStartMs": 502620,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "Nasıl ediniyoruz müşteriyi."
    } ]
  }, {
    "tStartMs": 504120,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "Müşteriyi hani yalın kanvasımızda şey vardı"
    } ]
  }, {
    "tStartMs": 507780,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "ya. Kanallar hemen şeyin altında."
    } ]
  }, {
    "tStartMs": 511110,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Unfair advantages yani neden bizin altında"
    } ]
  }, {
    "tStartMs": 515910,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "oradaki kanallara bakıyoruz?"
    } ]
  }, {
    "tStartMs": 517260,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "Yani eğer planlarımızı doğru yaptıysak, iyi"
    } ]
  }, {
    "tStartMs": 519690,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "analiz ettiysek, işte personalar'ı"
    } ]
  }, {
    "tStartMs": 522000,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "belirledik falan vesaire."
    } ]
  }, {
    "tStartMs": 523710,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "Onlar iyi doğru yaptıysak zaten kanallar"
    } ]
  }, {
    "tStartMs": 525720,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "bellidir. Ya içerik pazarlama, ya bedelli,"
    } ]
  }, {
    "tStartMs": 529170,
    "dDurationMs": 3370,
    "segs": [ {
      "utf8": "paralı pazarlama, paid marketing ya da işte"
    } ]
  }, {
    "tStartMs": 533160,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "influencer marketing denen sosyal medya"
    } ]
  }, {
    "tStartMs": 535830,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "üzerinden pazarlama ya da fiziksel ise işte"
    } ]
  }, {
    "tStartMs": 538830,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "broşür falan filan gibi bir şeyler onlardan."
    } ]
  }, {
    "tStartMs": 544380,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "Doğru mesajla, yani uygun mesajla, hedef"
    } ]
  }, {
    "tStartMs": 546870,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "kitleye uygun mesajla mesajı yollaman lazım."
    } ]
  }, {
    "tStartMs": 549720,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Broşürün ilgi çekici olması lazım."
    } ]
  }, {
    "tStartMs": 552000,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "Reklamın video mu görsel mi text metin mi"
    } ]
  }, {
    "tStartMs": 555540,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "olduğuna göre şey yapılması lazım,"
    } ]
  }, {
    "tStartMs": 558630,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "tanımlanması lazım."
    } ]
  }, {
    "tStartMs": 560130,
    "dDurationMs": 4470,
    "segs": [ {
      "utf8": "Bunlar eğer uyarsa şeye hedef kitle zaten"
    } ]
  }, {
    "tStartMs": 565050,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "geri bildirim alıyoruz. Ne demek geri"
    } ]
  }, {
    "tStartMs": 566460,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "bildirim? Tıklıyor mesela, tıklıyor,"
    } ]
  }, {
    "tStartMs": 569340,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "yüklüyor, kayıt ediyor kendini."
    } ]
  }, {
    "tStartMs": 573600,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "Sonra da kullanmaya başlıyor."
    } ]
  }, {
    "tStartMs": 575220,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "O zaten Activation kısmı aktive etme kısmı"
    } ]
  }, {
    "tStartMs": 578370,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "oluyor kullandırmaya geçtiğin zaman."
    } ]
  }, {
    "tStartMs": 580290,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "Ama Acquisition da müşteri edinmede aslında"
    } ]
  }, {
    "tStartMs": 583680,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "birkaç tane taktik var."
    } ]
  }, {
    "tStartMs": 584760,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "Yine bi taktiklere girelim."
    } ]
  }, {
    "tStartMs": 586170,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "Müşteri edinme maliyetinden biraz önce"
    } ]
  }, {
    "tStartMs": 588120,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "bahsettiğin gibi paid marketing yani"
    } ]
  }, {
    "tStartMs": 590580,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "reklamla müşteri kazanma ve de içerikle"
    } ]
  }, {
    "tStartMs": 593430,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "müşteri kazanma var. Bunun farkı nedir?"
    } ]
  }, {
    "tStartMs": 595320,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "Biraz bahsedebilir misin?"
    } ]
  }, {
    "tStartMs": 596340,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "Oldukça önemli bir nokta."
    } ]
  }, {
    "tStartMs": 597900,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "Çok temel bir fark var."
    } ]
  }, {
    "tStartMs": 599250,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "Reklamla, paralı reklamla edinmenin"
    } ]
  }, {
    "tStartMs": 602220,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "maliyeti. Parayı harcadığın sürece var."
    } ]
  }, {
    "tStartMs": 604830,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "Karşılığı da parayı harcadığın sürece var."
    } ]
  }, {
    "tStartMs": 606780,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "Dur durduğun zaman bitiyor, maliyet de"
    } ]
  }, {
    "tStartMs": 609150,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "bitiyor, kullanıcıda bitiyor."
    } ]
  }, {
    "tStartMs": 610530,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Halbuki içerik pazarlaması yaptığın zaman,"
    } ]
  }, {
    "tStartMs": 612480,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "örneğin işte, videolarla, YouTube'da,"
    } ]
  }, {
    "tStartMs": 615690,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "videolarla, ya başka sosyal medyalarda,"
    } ]
  }, {
    "tStartMs": 618120,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "görseller veya videolarla veya bloglarda"
    } ]
  }, {
    "tStartMs": 620580,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "yazılarla kendini tanıttığın ürününü"
    } ]
  }, {
    "tStartMs": 623640,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "tanıttığın zaman, o bir kere harcanıp sonra"
    } ]
  }, {
    "tStartMs": 626730,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "her zaman kullanılan, her zaman yeşil bitki"
    } ]
  }, {
    "tStartMs": 629700,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "gibi yani. Dolayısıyla orada harcadığın para"
    } ]
  }, {
    "tStartMs": 631890,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "bir kere harcıyorsun, her zaman geliyor,"
    } ]
  }, {
    "tStartMs": 634110,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "diğerinde parayı harcadığın sürece geliyor,"
    } ]
  }, {
    "tStartMs": 636030,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "yoksa duruyor. Bu farkı unutmamak lazım."
    } ]
  }, {
    "tStartMs": 638220,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "İçerik pazarlamasına aslında erken yapılan"
    } ]
  }, {
    "tStartMs": 641850,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "yatırımlar yani atıyorum."
    } ]
  }, {
    "tStartMs": 643470,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "Ürününüzün, girişiminizin, uygulamanızın ilk"
    } ]
  }, {
    "tStartMs": 647010,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "zamanlarında yaptığınız yatırımlar uzun"
    } ]
  }, {
    "tStartMs": 649350,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "vadede çok iyi geri dönüş verecektir."
    } ]
  }, {
    "tStartMs": 651870,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "Çünkü yazdığınız belki elli tane blog"
    } ]
  }, {
    "tStartMs": 653970,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "yazısı. Sizin üçüncü yılınızda, dördüncü"
    } ]
  }, {
    "tStartMs": 656190,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "yılınızda bile size kullanıcı müşteri"
    } ]
  }, {
    "tStartMs": 657810,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "getirecektir. O yüzden orayı iyi optimize"
    } ]
  }, {
    "tStartMs": 660420,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "etmek gerekiyor. Eğer sizin 1 lira"
    } ]
  }, {
    "tStartMs": 663270,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "harcayarak da 1 liralık eforla zamanınız da"
    } ]
  }, {
    "tStartMs": 666030,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "bir masraf sonuçta bir liralık eforla"
    } ]
  }, {
    "tStartMs": 668970,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "getirdiğiniz, acquire ettiğiniz yani size"
    } ]
  }, {
    "tStartMs": 671400,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "kayıt olan müşteri eğer size bir noktada"
    } ]
  }, {
    "tStartMs": 675090,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "birazdan bahsedeceğimiz revenue kısmında"
    } ]
  }, {
    "tStartMs": 676890,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "gelir kısmında 3 lira kazandırıyorsa aslında"
    } ]
  }, {
    "tStartMs": 681450,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "o bir lira 3 liraya çıkana kadar sizin o"
    } ]
  }, {
    "tStartMs": 684390,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "kanalı aslında en derinine kadar"
    } ]
  }, {
    "tStartMs": 688230,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "arşınlamanız gerekiyor."
    } ]
  }, {
    "tStartMs": 689610,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "Varınızı yoğunuzu yatırabilirsiniz oraya."
    } ]
  }, {
    "tStartMs": 692490,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "Arşınlamak ve varınızı yoğunuzu yatırmak"
    } ]
  }, {
    "tStartMs": 694590,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "önemli kilit noktalar burada."
    } ]
  }, {
    "tStartMs": 697410,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "Diğerlerine birazdan devam edelim."
    } ]
  }, {
    "tStartMs": 699540,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "Önemli noktalar artık aktive ettiğimiz"
    } ]
  }, {
    "tStartMs": 702330,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "kullanıcıdan gelir elde etmeyi konuşacağız"
    } ]
  }, {
