  }, {
    "tStartMs": 271520,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "O zaman problem tanımı, ilk aşamayla"
    } ]
  }, {
    "tStartMs": 273620,
    "dDurationMs": 3240,
    "segs": [ {
