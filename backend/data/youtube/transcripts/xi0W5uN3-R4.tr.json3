  }, {
    "tStartMs": 332820,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "O uygulamada kendini duyursun, biz onu"
    } ]
  }, {
    "tStartMs": 335100,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "doğrulayalım gerçekten bu işi yapabilir"
    } ]
  }, {
    "tStartMs": 336990,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "diye. Birileri de o uygulamayı indirip"
    } ]
  }, {
    "tStartMs": 339870,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "bulunduğu yere taksi gibi özel araç"
    } ]
  }, {
    "tStartMs": 342720,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "çağırsın. Özel aracın kullanıcısı da ödemeyi"
    } ]
  }, {
    "tStartMs": 346650,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "biz uygulamadan alalım."
    } ]
  }, {
    "tStartMs": 348060,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "Komisyonumuz alıp parasını ona verelim."
    } ]
  }, {
    "tStartMs": 349980,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Ne oldu? Şimdi ben taksi büyük metropollerde"
    } ]
  }, {
    "tStartMs": 352620,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "büyük şehirlerdeki taksi bulamama özellikle"
    } ]
  }, {
    "tStartMs": 355500,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "kötü havalardaki taksi sorununa bir çözüm"
    } ]
  }, {
    "tStartMs": 359250,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "oluşturmuş oldum. Bunun örnekleri dünyada"
    } ]
  }, {
    "tStartMs": 361170,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "çok var biliyorsun zaten."
    } ]
  }, {
    "tStartMs": 363270,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "Ve iki tarafın problemini çözdüm."
    } ]
  }, {
    "tStartMs": 365130,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "Yani hem boş duran araçlar, boşta bekleyen"
    } ]
  }, {
    "tStartMs": 368100,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "bireylerin hem de zor koşullarda taksi"
    } ]
  }, {
    "tStartMs": 371550,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "arayanların problemini çözdük."
    } ]
  }, {
    "tStartMs": 373590,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Aslında problem tanımının bir örneğini"
    } ]
  }, {
    "tStartMs": 375690,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "yapmış oldum. Bu şekilde yani öyle bir cümle"
    } ]
  }, {
    "tStartMs": 377820,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "olmalı ki bu birkaç cümle hem hedef kitleyi"
    } ]
  }, {
    "tStartMs": 381180,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "içermeli hem de problemin ne olduğunu"
    } ]
  }, {
    "tStartMs": 383850,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "içermeli. Sen daha demin iki taraf için de"
    } ]
  }, {
    "tStartMs": 386340,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "problem tanımını şu şekilde yaptın."
    } ]
  }, {
    "tStartMs": 388080,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "Özetleyelim gelir elde edemeyen veya aracı"
    } ]
  }, {
    "tStartMs": 392040,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "boş boş duran bireylerin, gelir elde edememe"
    } ]
  }, {
    "tStartMs": 396480,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "problemi. Böyle bir problem tanımı yaptın."
    } ]
  }, {
    "tStartMs": 399810,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Diğer tarafta da büyük metropollerde yaşayan"
    } ]
  }, {
    "tStartMs": 403170,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "veya işte özellikle yağmurlu havalarda ve"
    } ]
  }, {
    "tStartMs": 407460,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "önemli saatlerde araç bulamayan, taksi"
    } ]
  }, {
    "tStartMs": 410160,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "bulamayan kişilerin ulaşım problemi."
    } ]
  }, {
    "tStartMs": 413190,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "İki tane problem tanımı yaptın."
    } ]
  }, {
    "tStartMs": 415560,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "Birincisinde dediğin gibi asla araçları boş"
    } ]
  }, {
    "tStartMs": 418950,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "boş duran ve gelir elde etmek isteyen"
    } ]
  }, {
    "tStartMs": 421920,
    "dDurationMs": 3110,
    "segs": [ {
      "utf8": "bireylerin gelir elde edememe problemini"
    } ]
  }, {
    "tStartMs": 425130,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "aslında tanımladın, diğer tarafta da büyük"
    } ]
  }, {
    "tStartMs": 428310,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "metropollerde yaşayan ve önemli saatlerde,"
    } ]
  }, {
    "tStartMs": 431280,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "yağışlı havalarda vesaire taksi bulamayan,"
    } ]
  }, {
    "tStartMs": 434190,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "araç bulamayan insanların ulaşım problemini"
    } ]
  }, {
    "tStartMs": 436350,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "tanımladık. Şimdi hepimizin bildiği örnekler"
    } ]
  }, {
    "tStartMs": 439650,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "bunlar. Bu tanımladığımız problemler"
    } ]
  }, {
    "tStartMs": 442500,
    "dDurationMs": 2630,
    "segs": [ {
      "utf8": "gerçekten var mıyı nasıl doğrulacağız."
    } ]
  }, {
    "tStartMs": 445130,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "Güzel nokta. Doğrulama son derece kritik."
    } ]
  }, {
    "tStartMs": 446940,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "Çünkü çoğu zaman insan kendi probleminin"
    } ]
  }, {
    "tStartMs": 449700,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "herkeste olduğunu düşünüyor, hatta buna"
    } ]
  }, {
    "tStartMs": 452130,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "inanıyor çılgıncasına ve hiçbir zaman da"
    } ]
  }, {
    "tStartMs": 455490,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "acaba var mı bu başkalarında diye sormuyor."
    } ]
  }, {
    "tStartMs": 457920,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Onun için bence önemli bir nokta doğrulama"
    } ]
  }, {
    "tStartMs": 459720,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "problemi. Bunun birkaç yöntemi var."
    } ]
  }, {
    "tStartMs": 463890,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "Bir tanesi en kolay yöntemi saha yöntemi."
    } ]
  }, {
    "tStartMs": 466950,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Yani yeterince insan gücün varsa çıkarsın"
    } ]
  }, {
    "tStartMs": 469350,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "sahaya. Söz ettiğimiz saatlerde taksi"
    } ]
  }, {
    "tStartMs": 472380,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "bulmaya çalışırsın. Ne kadar sürdüğünü,"
    } ]
  }, {
    "tStartMs": 474990,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "hangi koşullarda bulduğunu ya da"
    } ]
  }, {
    "tStartMs": 477150,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "bulamadığını, ne kadar yürüme gerektiğini,"
    } ]
  }, {
    "tStartMs": 479520,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "ne kadar vakit kaybettiğine bakarsın."
    } ]
  }, {
    "tStartMs": 481860,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "Sonra bunların notunu alırsın."
    } ]
  }, {
    "tStartMs": 483180,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "Sonra bunu belki bir miktar birilerine"
    } ]
  }, {
    "tStartMs": 486320,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "mesela indirim kuponu falan vererek onların"
    } ]
  }, {
    "tStartMs": 488520,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "da deneyimlemesini ve sana bildirmesini"
    } ]
  }, {
    "tStartMs": 492330,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "istersin. Böylece saha çalışması ya da anket"
    } ]
  }, {
    "tStartMs": 494880,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "dediğimiz yöntemi kullanabilirsin bir yöntem"
    } ]
  }, {
    "tStartMs": 498000,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "olarak. Bir önceki modülde kullanıcı içgörü"
    } ]
  }, {
    "tStartMs": 500850,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "toplama ve sentezleme modülünde aslında bunu"
    } ]
  }, {
    "tStartMs": 503460,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "ne tarz aktivitelerle yapabileceğinizden"
    } ]
  }, {
    "tStartMs": 505620,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "bahsetmiştik. Oraya dönüp aslında tekrar bu"
    } ]
  }, {
    "tStartMs": 509370,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "adımdaki aktiviteleri"
    } ]
  }, {
    "tStartMs": 511020,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "derinleştirebilirsiniz. Problem tanımlama ve"
    } ]
  }, {
    "tStartMs": 514770,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "problem doğrulamadan sonra artık en"
    } ]
  }, {
    "tStartMs": 517170,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "sevdiğimiz yer olan çözüme geçeceğiz ama onu"
    } ]
  }, {
    "tStartMs": 519930,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "bir sonraki derste konuşalım."
    } ]
  }, {
    "tStartMs": 521310,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "Daha detaylı çözüm tanımlama, çözüm"
    } ]
  }, {
    "tStartMs": 523260,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "doğrulamadan devam edelim."
    } ]
  }, {
    "tStartMs": 524910,
    "dDurationMs": 630,
    "segs": [ {
      "utf8": "Anlaştık."
    } ]
  } ]
}
