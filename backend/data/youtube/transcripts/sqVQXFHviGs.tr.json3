  }, {
    "tStartMs": 467950,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "eleştirip tanıtabilirsin."
    } ]
  }, {
    "tStartMs": 469990,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "Iznini verdikten sonra yine onu da belli bir"
    } ]
  }, {
    "tStartMs": 472930,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "sene veya ay içe için veriyorsunuz."
    } ]
  }, {
    "tStartMs": 475610,
    "dDurationMs": 2150,
    "segs": [ {
      "utf8": "Ee oradan sonra kullanım daha kolaylaşıyor."
    } ]
  }, {
    "tStartMs": 478060,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "Biraz istersen şeye değinelim."
    } ]
  }, {
    "tStartMs": 479230,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Yani erken aşamada bu ne kadar kritik,"
    } ]
  }, {
    "tStartMs": 482590,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "ileriki aşamalarda bu ne kadar kritik?"
    } ]
  }, {
    "tStartMs": 484330,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "Şöyle aslında bir nokta daha var."
    } ]
  }, {
    "tStartMs": 485770,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "Demin sen onu söyledin ama mesela bir Google"
    } ]
  }, {
    "tStartMs": 488200,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "Doc tuttuğun zaman Google Doc'un serverı"
    } ]
  }, {
    "tStartMs": 491890,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "Türkiye dışında ya."
