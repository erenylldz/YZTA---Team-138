  }, {
    "tStartMs": 252240,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "gerektiği konularında legal-dizayn dediğimiz"
    } ]
  }, {
    "tStartMs": 254670,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "hukuksal dizayn konuları ön plana çıkmaya"
    } ]
  }, {
    "tStartMs": 256950,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "başladı. Eee, bazı çok büyük markalar"
    } ]
  }, {
    "tStartMs": 259950,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "aslında güvenliği, kişisel veriyi"
    } ]
  }, {
    "tStartMs": 262020,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "kullanmamayı, bir pazarlama unsuru olarak da"
    } ]
  }, {
    "tStartMs": 264330,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "kullanmaya başladı. E o yüzden bunlara da"
