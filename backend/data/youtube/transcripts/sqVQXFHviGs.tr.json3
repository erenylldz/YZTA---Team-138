  }, {
    "tStartMs": 266790,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "dikkat ederek, bunları da"
    } ]
  }, {
    "tStartMs": 268230,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "kullanılabilirliğini de göz önünde"
