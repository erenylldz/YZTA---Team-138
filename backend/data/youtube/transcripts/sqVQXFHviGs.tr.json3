  }, {
    "tStartMs": 133020,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "girişimin şirket olduktan sonra neye dikkat"
    } ]
  }, {
    "tStartMs": 135960,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "edeceği, tanımların ne olduğu."
    } ]
  }, {
    "tStartMs": 140070,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "Tabii bütün bunlar da güncellenebilir"
