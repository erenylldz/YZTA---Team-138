  }, {
    "tStartMs": 415720,
    "dDurationMs": 480,
    "segs": [ {
      "utf8": "gerekiyor."
    } ]
  }, {
    "tStartMs": 416500,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "O zaten kullanıcı ne derse yapmamız gerekiyor"
