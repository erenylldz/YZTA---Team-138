  }, {
    "tStartMs": 228900,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "endişelenmeye başladı bu konuda."
    } ]
  }, {
    "tStartMs": 231280,
    "dDurationMs": 3350,
    "segs": [ {
      "utf8": "Hatta legal-dizayn dediğimiz aslında hukuki"
