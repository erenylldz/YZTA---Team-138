  }, {
    "tStartMs": 234630,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "dizayn konuları da işin içine girmeye"
    } ]
  }, {
    "tStartMs": 237840,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "başladı. Eee KVKK metinlerinin kısa"
    } ]
  }, {
    "tStartMs": 240360,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "hallerinin özetlenebilir bir şekilde"
