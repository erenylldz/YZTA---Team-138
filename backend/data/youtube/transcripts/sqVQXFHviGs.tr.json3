  }, {
    "tStartMs": 141990,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "bununla ilgili. Türkiye'de de yurtdışında da"
    } ]
  }, {
    "tStartMs": 145680,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "web siteleri var. Burada bu tanımlar çok net"
    } ]
  }, {
    "tStartMs": 147750,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "yapılıyor ama yine biz deneyim aktarımı ile"
