  }, {
    "tStartMs": 407550,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "Yine incelemeniz gerekiyor."
    } ]
  }, {
    "tStartMs": 409790,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "Eee ülke bazlı ııı hareket ederken."
    } ]
  }, {
    "tStartMs": 413410,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "Bir de galiba kullanıcı isterse silmen"
