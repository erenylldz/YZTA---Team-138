  }, {
    "tStartMs": 214830,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "bundan sonra zaten kurumsallaşma aşamasında"
    } ]
  }, {
    "tStartMs": 216990,
    "dDurationMs": 2100,
