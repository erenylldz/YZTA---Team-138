  }, {
    "tStartMs": 272580,
    "dDurationMs": 450,
    "segs": [ {
      "utf8": "gerekir."
    } ]
  }, {
    "tStartMs": 273120,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "Evet, kesinlikle şeyi biraz tanımla istersen"
