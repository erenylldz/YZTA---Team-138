  }, {
    "tStartMs": 92130,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "veri olarak sayılıyor."
    } ]
  }, {
    "tStartMs": 93420,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "Mesela göz, rengin, fotoğrafın."
    } ]
  }, {
    "tStartMs": 97320,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "Bütün bunlar kişisel veri."
    } ]
  }, {
    "tStartMs": 101010,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "Tabii fotoğrafın açık alanda çekilmiş ise"
    } ]
  }, {
    "tStartMs": 105000,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "nasıl kullanılacağı. Onlar biraz daha böyle"
    } ]
  }, {
    "tStartMs": 107460,
    "dDurationMs": 4230,
    "segs": [ {
      "utf8": "gri alanlar. Ama senin bir yere bir şeye"
    } ]
  }, {
    "tStartMs": 111690,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "başvururken sana sorulduğunda girdiğin"
