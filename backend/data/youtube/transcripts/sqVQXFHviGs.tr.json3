  }, {
    "tStartMs": 291930,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "da düşünebilirsiniz. Eee sizin bu biraz önce"
    } ]
  }, {
    "tStartMs": 295500,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "bahsettiğimiz bilgisayarınızda veya"
    } ]
  }, {
    "tStartMs": 299490,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "defterinizde veya offline da tuttuğunuz bazı"
    } ]
  }, {
    "tStartMs": 301570,
    "dDurationMs": 3410,
    "segs": [ {
      "utf8": "bilgileri şu şekilde tutmanız iyi olacaktır"
    } ]
  }, {
    "tStartMs": 304990,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "Sizi bir şekilde güvenli tarafa çekebilir."
    } ]
  }, {
    "tStartMs": 307840,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "Kolay ulaşabilir olmamak, olmaması, bu"
