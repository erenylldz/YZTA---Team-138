  }, {
    "tStartMs": 115770,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "şeyler kişisel veri kabul ediliyor."
    } ]
  }, {
    "tStartMs": 118740,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "Eee dediğim gibi yani ikincisine girecek"
