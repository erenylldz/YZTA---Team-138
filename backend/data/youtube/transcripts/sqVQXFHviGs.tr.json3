  }, {
    "tStartMs": 428710,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "olmasını isteme hakkı var."
    } ]
  }, {
    "tStartMs": 430270,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "Hatta bu talep edildikten sonra herhangi bir"
