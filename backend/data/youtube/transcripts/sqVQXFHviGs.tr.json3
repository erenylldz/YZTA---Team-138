  }, {
    "tStartMs": 150360,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "devam edelim isterseniz."
    } ]
  }, {
    "tStartMs": 151680,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "Çok kısa bir şey değinmek gerekiyor burada."
