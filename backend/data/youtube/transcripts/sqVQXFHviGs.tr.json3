  }, {
    "tStartMs": 439960,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "yaşanabilir."
    } ]
  }, {
    "tStartMs": 440770,
    "dDurationMs": 750,
    "segs": [ {
      "utf8": "Büyük cezalar var."
    } ]
  }, {
    "tStartMs": 441520,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Büyük cezalar yenilebilir girişimler"
    } ]
  }, {
    "tStartMs": 443920,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "açısından çok kolay altından kaldırılabilir"
    } ]
  }, {
    "tStartMs": 447100,
    "dDurationMs": 390,
    "segs": [ {
      "utf8": "olmaz o durumda."
    } ]
  }, {
    "tStartMs": 447490,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "Bİr de şey dedin ya sen?"
    } ]
  }, {
    "tStartMs": 449860,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "Bu izin meselesi aslında en kritik yer orası"
    } ]
  }, {
    "tStartMs": 452050,
    "dDurationMs": 330,
    "segs": [ {
      "utf8": "değil mi?"
    } ]
  }, {
    "tStartMs": 453250,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "Tabii ki izinli."
    } ]
  }, {
    "tStartMs": 454330,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "Yani kullanıcı eğer bilgilerini kullanmaya,"
    } ]
  }, {
    "tStartMs": 456880,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "yani seni tanımlamayı kabul ederse, yani sen"
    } ]
  }, {
    "tStartMs": 459520,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "benim adımı Ö yıldız yıldız e Yıldız Yıldız"
    } ]
  }, {
    "tStartMs": 462220,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "değil, Ömer Erkmen olarak kullanabilirsin."
    } ]
  }, {
    "tStartMs": 464980,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "Benim gri gömleğimi ve gözlüğümü benle eş"
