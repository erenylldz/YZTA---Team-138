    } ]
  }, {
    "tStartMs": 6610,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "Avrupa Birliği'nde kullanılan yurt dışında"
    } ]
  }, {
    "tStartMs": 8640,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "kullanılan GDPR konularına değineceğiz."
    } ]
  }, {
    "tStartMs": 12660,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Yine burada bir açıklama yapmakta fayda var."
    } ]
  }, {
    "tStartMs": 15430,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Eee biz bu konunun uzmanları değil ama"
    } ]
  }, {
    "tStartMs": 17790,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "farklı aşamalarda ki startuplarda KVK ile"
    } ]
  }, {
    "tStartMs": 21150,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "nasıl etkileşime girilir, kişisel verilerle"
    } ]
  }, {
    "tStartMs": 23400,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "nasıl etkileşime girilir?"
    } ]
  }, {
    "tStartMs": 24750,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "Biraz bundan bahsedeceğiz."
    } ]
  }, {
    "tStartMs": 26070,
    "dDurationMs": 720,
    "segs": [ {
      "utf8": "Deneyim aktarımı."
    } ]
  }, {
    "tStartMs": 27150,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "Deneyim aktarımı yapacağız."
    } ]
  }, {
    "tStartMs": 28260,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "Kişisel veri nedir? Bir bizim"
    } ]
  }, {
    "tStartMs": 29670,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "perspektifimizden sen açıkla istersen."
    } ]
  }, {
    "tStartMs": 31920,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "Valla bu KVKK konusu,CDPR konusu aslında"
    } ]
  }, {
    "tStartMs": 34980,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "hızla yayılıyor. Dünyada sadece Avrupa'da"
    } ]
  }, {
    "tStartMs": 37500,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "başladı. CDPR Avrupada geçerli."
    } ]
  }, {
    "tStartMs": 40710,
    "dDurationMs": 5100,
    "segs": [ {
      "utf8": "Eee KVKK Türkiye'de geçerli ancak bu başka"
    } ]
  }, {
    "tStartMs": 45810,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "ülkelerde de başladı."
    } ]
  }, {
    "tStartMs": 47100,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Hatta Amerika'da bile önce Kaliforniya'da"
    } ]
  }, {
    "tStartMs": 49740,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "sonra başka bazı eyaletlerde, eyalet bazlı"
    } ]
  }, {
    "tStartMs": 53340,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "kişisel veri koruma kanunları çıkmaya"
    } ]
  }, {
    "tStartMs": 56130,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "başladı. Kişisel verinin tanımı tabi o"
