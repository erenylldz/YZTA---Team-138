  }, {
    "tStartMs": 376330,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "tanımlayamayacağı bir noktada aslında senin"
    } ]
  }, {
    "tStartMs": 378730,
    "dDurationMs": 2310,
    "segs": [ {
