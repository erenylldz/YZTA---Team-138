  }, {
    "tStartMs": 242160,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "kullanıcıya verilmesi."
    } ]
  }, {
    "tStartMs": 243810,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "Eee o eski reklamlarda alttan geçen siyah"
    } ]
  }, {
    "tStartMs": 246480,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "bantların kolay okuyabilmesi ve hangi"
    } ]
  }, {
    "tStartMs": 250470,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "bilgilerin aslında kullanıcıya sunulması"
