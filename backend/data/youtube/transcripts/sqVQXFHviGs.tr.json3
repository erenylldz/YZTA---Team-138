  }, {
    "tStartMs": 68310,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "taraflarını söyleyeyim hemen."
    } ]
  }, {
    "tStartMs": 69990,
    "dDurationMs": 4370,
    "segs": [ {
      "utf8": "Mesela İsmin, adın, soyadın, doğum tarihin,"
    } ]
  }, {
    "tStartMs": 74360,
    "dDurationMs": 3820,
    "segs": [ {
      "utf8": "net tartışmasız bir şekilde işte TC kimlik"
