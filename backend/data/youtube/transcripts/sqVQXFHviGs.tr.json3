  }, {
    "tStartMs": 522190,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "konunun önemini ve farkındalığını belki"
    } ]
  }, {
    "tStartMs": 527050,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "ortaya koyuyor. Ama gerçekten diğer"
    } ]
  }, {
    "tStartMs": 529720,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "modüllerden öğrenip, hatta onunla bile"
    } ]
  }, {
    "tStartMs": 531520,
    "dDurationMs": 6210,
    "segs": [ {
      "utf8": "yetinmeyip bunun işte hukuki tarafta veya bu"
    } ]
  }, {
    "tStartMs": 537730,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "konunun uzmanları tarafında da mentorluğunu"
    } ]
  }, {
    "tStartMs": 541090,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "önce sonra da danışmanlığını almalarında"
    } ]
  }, {
    "tStartMs": 543190,
    "dDurationMs": 5370,
    "segs": [ {
      "utf8": "büyük fayda var ki, o anormal cezalara ki"
    } ]
  }, {
    "tStartMs": 548560,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "örneklerini gördük, bunun haberlerde maruz"
    } ]
  }, {
    "tStartMs": 551710,
    "dDurationMs": 5610,
    "segs": [ {
      "utf8": "kalmasınlar. Ha genellikle şu uygulanıyor"
    } ]
  }, {
    "tStartMs": 557330,
    "dDurationMs": 3050,
    "segs": [ {
      "utf8": "yani bir yeni girişim, yeni kurulmuş yeni"
    } ]
  }, {
    "tStartMs": 560380,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "bir şey yapıyor, ufak bir hata yapıyor, ona"
    } ]
  }, {
    "tStartMs": 563050,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "çok büyük bir ceza vermiyorlar."
    } ]
  }, {
    "tStartMs": 564400,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "Belki bir uyarı veriyorlar ama yine de"
    } ]
  }, {
    "tStartMs": 566170,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "burada birinci senin sorunun cevabı"
    } ]
  }, {
    "tStartMs": 568900,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "farkındalık. Bunun farkında olup neyle"
    } ]
  }, {
    "tStartMs": 571900,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "karşılaşabileceğini, hangi riski aldığımı"
    } ]
  }, {
    "tStartMs": 575170,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "bilmesi lazım. Ondan sonraki adımlar işin"
    } ]
  }, {
    "tStartMs": 579190,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "daha sonraki büyüme aşamalarında bu"
    } ]
  }, {
    "tStartMs": 581380,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "önlemlerin gerçekten onaylı kabul edilen"
    } ]
  }, {
    "tStartMs": 585190,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "uzmanlar tarafından imzalanmış bir şekilde"
    } ]
  }, {
    "tStartMs": 588550,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "korunmuş olması. Bu da yetmeyebilir."
    } ]
  }, {
    "tStartMs": 590890,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "Mesela en çok ceza benim duyduğum veri"
    } ]
  }, {
    "tStartMs": 594580,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "güvenliğinden geliyor."
    } ]
  }, {
    "tStartMs": 596790,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Mesela küçük bir şirket ya da büyük bir"
    } ]
  }, {
    "tStartMs": 598710,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "şirket hiç fark etmez."
    } ]
  }, {
    "tStartMs": 601080,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "Senin izin verdiğin, kullanılma, izin"
    } ]
  }, {
    "tStartMs": 603870,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "verdiğin bir veriyi bile mesela bir hacker"
    } ]
  }, {
    "tStartMs": 606180,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "da kaptırır ise gene ceza yer."
    } ]
  }, {
    "tStartMs": 609570,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "Ya da yurt dışında tutarsa gene ceza yiyor."
    } ]
  }, {
    "tStartMs": 612870,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "Bu aslında hukuksal taraftan biraz siber"
    } ]
  }, {
    "tStartMs": 614970,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "güvenlik tarafına geçtiğimiz bir şey."
    } ]
  }, {
    "tStartMs": 618660,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "Burada çok kolay ulaşılabilir siber güvenlik"
    } ]
  }, {
    "tStartMs": 622410,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "ürünleri olmakla birlikte çok büyük"
    } ]
  }, {
    "tStartMs": 624510,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "şirketlerin ve altyapılarını kullanmak"
    } ]
  }, {
    "tStartMs": 627600,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "aslında biraz daha bu işin riskini"
    } ]
  }, {
    "tStartMs": 629370,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "azaltıyor, hacklenebilirliğini azaltıyor."
    } ]
  }, {
    "tStartMs": 632790,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "İstersen bu dersi burada noktalayalım."
    } ]
  }, {
    "tStartMs": 634380,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Bir sonraki derste yeni nesil girişimlerin"
    } ]
  }, {
    "tStartMs": 636720,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "aşaması fark etmeksizin aslında en çok"
    } ]
  }, {
    "tStartMs": 638880,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "ilgilendiği konu bu kişisel verilerin"
    } ]
  }, {
    "tStartMs": 641610,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "pazarlamada kullanılabilirliği konusu."
