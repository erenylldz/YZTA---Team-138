  }, {
    "tStartMs": 495850,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "Aslında Türkiye dışına çıkmaması gereken"
    } ]
  }, {
    "tStartMs": 497680,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "veriyi alıp orada tutmamak lazım ya."
    } ]
  }, {
    "tStartMs": 499540,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "Mesela finansal veriler, banka falan ona da"
