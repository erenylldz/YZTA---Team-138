      "utf8": "gözlüklü ve gri gömlekli kişi."
    } ]
  }, {
    "tStartMs": 166740,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "Eeee dediğimizde anlayabileceğimiz aslında"
