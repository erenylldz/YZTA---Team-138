  "events": [ {
    "tStartMs": 390,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "Tekrar merhaba bu dersimizde, kişisel"
    } ]
  }, {
    "tStartMs": 3090,
    "dDurationMs": 3520,
    "segs": [ {
