  }, {
    "tStartMs": 78180,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "numaranı ya da vergi numaramı ya da başka"
    } ]
  }, {
    "tStartMs": 80850,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "ülkelerde. İşte social security number"
    } ]
  }, {
    "tStartMs": 83190,
    "dDurationMs": 480,
    "segs": [ {
      "utf8": "dediğimiz bu."
    } ]
  }, {
    "tStartMs": 83680,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "Sosyal.Güvenlik numarası."
    } ]
  }, {
    "tStartMs": 84990,
    "dDurationMs": 4860,
    "segs": [ {
      "utf8": "Güvenli mi mesela? Bu tür şeyler kişisel veri"
    } ]
  }, {
    "tStartMs": 89850,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "olarak sayılıyor. Başka şeyler de kişisel"
