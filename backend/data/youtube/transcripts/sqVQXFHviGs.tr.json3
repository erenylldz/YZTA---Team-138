    "tStartMs": 62160,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "olduğuna göre değişebiliyor."
    } ]
  }, {
    "tStartMs": 64530,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "Yine uzmanlık konusu olduğu için çok iyi"
