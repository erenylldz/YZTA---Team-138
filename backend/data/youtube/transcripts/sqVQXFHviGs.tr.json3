  }, {
    "tStartMs": 191220,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "Saklamak demek, deftere yazmak demek de"
    } ]
  }, {
    "tStartMs": 193530,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "olabilir. Saklamak demek, Google'da da"
