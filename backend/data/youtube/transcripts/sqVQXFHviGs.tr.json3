  }, {
    "tStartMs": 502750,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "dikkat etmek gerekiyor."
    } ]
  }, {
    "tStartMs": 503980,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "Verinin yurt dışına çıkmaması, güvenli"
    } ]
  }, {
    "tStartMs": 506590,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "olması, izinli olması yani 3 tane temel."
    } ]
  }, {
    "tStartMs": 509650,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "Benim bildiğim, anladığım şey var."
    } ]
  }, {
    "tStartMs": 511420,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "Bunun boyutu var."
    } ]
  }, {
    "tStartMs": 512830,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "Erken aşamada ekipler burada güvenli tarafta"
    } ]
  }, {
    "tStartMs": 515500,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "kalmak için ne yapabilir?"
    } ]
  }, {
    "tStartMs": 517330,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "Birinci kural farkındalık."
    } ]
  }, {
    "tStartMs": 519370,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "Yani bizim burada söylediklerimiz sadece"
