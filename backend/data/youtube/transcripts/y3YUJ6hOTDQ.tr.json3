  "events": [ {
    "tStartMs": 3890,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "Herkese merhaba. Bu modülüzde Fikri Haklar,"
    } ]
  }, {
    "tStartMs": 7550,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "KVKK ve Şirket Kurulumları tiplerinden"
    } ]
  }, {
    "tStartMs": 10640,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "bahsedeceğiz. Bunun tabii ki çok regülatif"
    } ]
  }, {
    "tStartMs": 13100,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "ve teknik tarafından değil, biraz daha"
    } ]
  }, {
    "tStartMs": 15590,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "kurucu ortakların ve girişimlerin yapması"
    } ]
  }, {
    "tStartMs": 18230,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "gerekenleri, önlem alması gerekenleri veya"
    } ]
  }, {
    "tStartMs": 21920,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "önden düşünmesi gerektiği konulara biraz"
    } ]
  }, {
    "tStartMs": 23810,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "değineceğiz. İstersen Ömer abi fikri haklar"
    } ]
  }, {
    "tStartMs": 26630,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "ve hani en sevdiğimiz konu fikir ve"
    } ]
  }, {
    "tStartMs": 29030,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "patentten devam edelim."
    } ]
  }, {
    "tStartMs": 30590,
    "dDurationMs": 2030,
    "segs": [ {
      "utf8": "Burada bir açıklama yapmak gerekli olabilir."
    } ]
  }, {
    "tStartMs": 32720,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "Evet açıklama yapalım."
    } ]
  }, {
    "tStartMs": 34100,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "Yani İngilizce disclaimer denen şeyi"
    } ]
  }, {
    "tStartMs": 36110,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "yapmamız lazım. Bizim söylediklerimiz,"
    } ]
  }, {
    "tStartMs": 38690,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "söyleyeceklerimiz burada bir uzman bilgisine"
    } ]
  }, {
    "tStartMs": 41750,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "ya da görüşüne dayanmıyor."
    } ]
  }, {
    "tStartMs": 43400,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "Tamamen deneyime dayanıyor."
    } ]
  }, {
    "tStartMs": 45260,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "Daha önce yaşadığımız başka girişimlerde ya"
    } ]
  }, {
    "tStartMs": 48530,
    "dDurationMs": 4230,
    "segs": [ {
      "utf8": "da bizle ilgisi olmasa bile okuduğumuz"
    } ]
  }, {
    "tStartMs": 53270,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "bilgilere dayanıyor."
    } ]
  }, {
    "tStartMs": 55160,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "O yüzden doğru kabul etmeyin."
    } ]
  }, {
    "tStartMs": 58400,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "Sadece biz size yaşadığımız şeylerden"
    } ]
  }, {
    "tStartMs": 61130,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "hareketle, yeni nesil girişim dünyasında"
    } ]
  }, {
    "tStartMs": 64340,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "bunların etkilerini, nelere dikkat etmeniz"
    } ]
  }, {
    "tStartMs": 67820,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "gerektiğini, nerelerde aşırı ciddiye almanız"
    } ]
  }, {
    "tStartMs": 71930,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "gerektiğini, nerelerde sadece dikkatli"
    } ]
  }, {
    "tStartMs": 73980,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "olmanın yetebileceğini anlatmaya çalışacağız."
    } ]
  }, {
    "tStartMs": 76790,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "Bazı şirket tiplerinde mesela ben kendi"
    } ]
  }, {
    "tStartMs": 79010,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "deneyimlerimi aktaracağım size."
    } ]
  }, {
    "tStartMs": 81020,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "Çünkü şirket tipi diyince işte o dünyadan"
    } ]
  }, {
    "tStartMs": 84140,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "birisi size onu sıradan anlatır ama bir"
    } ]
  }, {
    "tStartMs": 86660,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "startup dünyasındaki şirket tipinde"
    } ]
  }, {
    "tStartMs": 89450,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "hangisini kurarsan ne yaşanırı biraz"
    } ]
  }, {
    "tStartMs": 92060,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "anlatmaya çalışacağız size bunu da böyle bir"
    } ]
  }, {
    "tStartMs": 94550,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "açıklama olarak yapmış olayım."
    } ]
  }, {
    "tStartMs": 96680,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Bu modelde aslında Ömer abinin açıkladığı"
    } ]
  }, {
    "tStartMs": 99080,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "detayda işleyeceğiz bunu."
    } ]
  }, {
    "tStartMs": 101750,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "Bir önceki iki önceki modülde şunu"
    } ]
  }, {
    "tStartMs": 103970,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "konuşmuştuk aslında fikir patentlenebilir"
    } ]
  }, {
    "tStartMs": 108140,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "olmadığı sürece aslında icraata bağlı bir"
    } ]
  }, {
    "tStartMs": 111200,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "başarı gösterir. O yüzden fikrin"
    } ]
  }, {
    "tStartMs": 113930,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "patentlenebilmesi neye bağlıdır?"
    } ]
  }, {
    "tStartMs": 115610,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "Bir önce onu konuşalım. Tamam, bunu biz"
    } ]
  }, {
    "tStartMs": 117620,
    "dDurationMs": 5580,
    "segs": [ {
      "utf8": "aslında bir kendimizin ynk videosu olarak"
    } ]
  }, {
    "tStartMs": 123200,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "yayınlamıştık. Epey bir zaman önceki 3 yıl"
    } ]
  }, {
    "tStartMs": 125810,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "önce."
    } ]
  }, {
    "tStartMs": 127160,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "Orada bayağı bir yorum gelmişti."
    } ]
  }, {
    "tStartMs": 129320,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "Şöyle şeyler söylemiştik demiştik ki fikir"
    } ]
  }, {
    "tStartMs": 133400,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "önemli değildir yeni nesil startup girişim"
    } ]
  }, {
    "tStartMs": 135920,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "dünyasında. Çünkü birçok fikir,"
    } ]
  }, {
    "tStartMs": 139520,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "patentlenemez. Ne patentlenebilir?"
    } ]
  }, {
    "tStartMs": 142580,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "Biz bilmiyoruz dedik, bilen aşağıya yazsın"
    } ]
  }, {
    "tStartMs": 144470,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "dedik. Ama şöyle bir şey geldi."
    } ]
  }, {
    "tStartMs": 146930,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Patent deyince akla ilk şey geliyor ya, işte"
    } ]
  }, {
    "tStartMs": 148850,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "kimyasal formülü yok ne bileyim ben işte"
    } ]
  }, {
    "tStartMs": 154340,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "biyolojik, genetik falan filan gibi şeyler"
    } ]
  }, {
    "tStartMs": 157670,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "geliyor akla. Yahut elektronik."
    } ]
  }, {
    "tStartMs": 159800,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "Neyse işte. Şart değil, başka şeylerin de"
    } ]
  }, {
    "tStartMs": 162920,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "patenti alınabiliyormuş."
    } ]
  }, {
    "tStartMs": 164330,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "Orada yorumlardan öğrendik bizde orada."
    } ]
  }, {
    "tStartMs": 166180,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "Mesela işte faydalı model diye bir kavram"
    } ]
  }, {
    "tStartMs": 168170,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "var. Ya da süreçlerin patenti"
    } ]
  }, {
    "tStartMs": 171080,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "alınabiliyormuş. Onları öğrendik."
    } ]
  }, {
    "tStartMs": 173090,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "Dolayısıyla patent deyip geçmeyin yani biz"
    } ]
  }, {
    "tStartMs": 177230,
    "dDurationMs": 4740,
    "segs": [ {
      "utf8": "hani fikrini söylemezsen olmaz diyoruz ama"
    } ]
  }, {
    "tStartMs": 183200,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "söylemeden önce de bir danışın bence onu da"
    } ]
  }, {
    "tStartMs": 186050,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "burada yine ben ön açıklama olarak vermiş"
    } ]
  }, {
    "tStartMs": 188720,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "olayım. Ama çoğunlukla bizim yaşadığımız"
    } ]
  }, {
    "tStartMs": 192530,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "geçtiğimiz yıllarda yeni nesil girişim"
    } ]
  }, {
    "tStartMs": 194840,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "dünyasında fikirlerin yüzde 99'u"
    } ]
  }, {
    "tStartMs": 198770,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "patentlenemiyordu. Bunu pratikten biliyoruz."
    } ]
  }, {
    "tStartMs": 201320,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Ama bu demek değildir ki sizinki"
    } ]
  }, {
    "tStartMs": 203120,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "patentlenemez onun için hani onlar dedi de"
    } ]
  }, {
    "tStartMs": 206210,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "biz patentlemedik olmasın lütfen söylemiş"
    } ]
  }, {
    "tStartMs": 208880,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "olayım tekrar. Ama pratikte baktığınız zaman"
    } ]
  }, {
    "tStartMs": 211070,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "istatistik olarak büyük ihtimalle sizin"
    } ]
  }, {
    "tStartMs": 212750,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "fikriniz de patentlenemez."
    } ]
  }, {
    "tStartMs": 214640,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "O halde ne yapmak lazım patentlenemiyorsa,"
    } ]
  }, {
    "tStartMs": 217610,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "hemen icraata koyulmak lazım."
    } ]
  }, {
    "tStartMs": 219950,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "Aslında diğer modüllerde bahsettiğimiz"
    } ]
  }, {
    "tStartMs": 222410,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "konuları hızlıca müşteriye götürerek,"
    } ]
  }, {
    "tStartMs": 224870,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "hızlıca kullanıcıya götürerek geri bildirimi"
    } ]
  }, {
    "tStartMs": 227660,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "almak, ürünü onlarla beraber geliştirmek,"
    } ]
  }, {
    "tStartMs": 230270,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "sonra farklı personalardan veya farklı"
    } ]
  }, {
    "tStartMs": 233450,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "teknoloji benimseme eğrisindeki kadranları"
    } ]
  }, {
    "tStartMs": 236210,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "kullanarak farklı noktalardan aslında"
    } ]
  }, {
    "tStartMs": 238580,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "kullanıcıyla buluşmak gerekiyor ki ürün bir"
    } ]
  }, {
    "tStartMs": 240890,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "şekilde farklılaşabilsin yani patentle"
    } ]
  }, {
    "tStartMs": 243590,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "farklılaşamıyorsanuz aslında hani tekil bir"
    } ]
  }, {
    "tStartMs": 246650,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "şekilde farklılaşmanızın damgasını"
    } ]
  }, {
    "tStartMs": 248960,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "kuramıyorsanız aslında pazarda farklılaşmaya"
    } ]
  }, {
    "tStartMs": 251660,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "gitmek gerekiyor. O yüzden yine bir önceki"
    } ]
  }, {
    "tStartMs": 254960,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "modellerde bahsettiğimiz taktikler ve"
    } ]
  }, {
    "tStartMs": 256880,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "yöntemler hala geçerli oluyor."
    } ]
  }, {
    "tStartMs": 259130,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "Aynen öyle. Çünkü patent aldığınız zaman"
    } ]
  }, {
    "tStartMs": 261260,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "patentlenebilir bir fikriniz varsa o zaman"
    } ]
  }, {
    "tStartMs": 263150,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "zaten o patent bir varlık oluyor sizin gelir"
    } ]
  }, {
    "tStartMs": 266480,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "gider bilanço gibi finansal sisteminizi bir"
    } ]
  }, {
    "tStartMs": 269240,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "değer olarak, bir varlık olarak giriyor."
    } ]
  }, {
    "tStartMs": 271700,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "O sizin belki alacağınız yatırımdaki"
    } ]
  }, {
    "tStartMs": 273590,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "değerlemenizi değiştirecek belki bir rakip"
    } ]
  }, {
    "tStartMs": 276800,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "gelip sizi sadece o patent yüzünden alacak."
    } ]
  }, {
    "tStartMs": 278840,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "Onlar ayrı konular. Biz onları dediğim gibi"
    } ]
  }, {
    "tStartMs": 280730,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "girmiyoruz. Sadece kontrol edin"
    } ]
  }, {
    "tStartMs": 283190,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "patentlenebilir mi değil mi?"
    } ]
  }, {
    "tStartMs": 284630,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "Değilse gelin buradan devam edin diyoruz."
    } ]
  }, {
    "tStartMs": 287510,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Gelin buradan devam edin derken de bir fikir"
    } ]
  }, {
    "tStartMs": 289850,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "eğer patentlenebilir değilse o zaman daha"
    } ]
  }, {
    "tStartMs": 292700,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "iyi uygulayan, icra eden kazanıyor."
    } ]
  }, {
    "tStartMs": 295460,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "Bunu da gördük yani birisi çıkıyor piyasaya,"
    } ]
  }, {
    "tStartMs": 298520,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "biraz yavaş gidiyor, iş takımı kuramıyor,"
    } ]
  }, {
    "tStartMs": 300710,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "büyüyemiyor falan. Bir başkası geliyor"
    } ]
  }, {
    "tStartMs": 302480,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "bakıyor. Tamam güzel diyor."
    } ]
  }, {
    "tStartMs": 304340,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "Alıp başını gidiyor mesela."
    } ]
  }, {
    "tStartMs": 305810,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Dolayısıyla pazara ilk giren değil, ilk"
    } ]
  }, {
    "tStartMs": 307730,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "ölçekleyen kazanır diye de bir kural var"
    } ]
  }, {
    "tStartMs": 309710,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "biliyorsun. Burada da ilk ölçekleyen"
    } ]
  }, {
    "tStartMs": 311630,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "kazanabilir. Bunu da söylemiş olalım yani."
    } ]
  }, {
    "tStartMs": 315290,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "Burada aslında değişik bir konuyla bağlamak"
    } ]
  }, {
    "tStartMs": 318560,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "gerekiyor. Bu yeni yeni patentle"
    } ]
  }, {
    "tStartMs": 321260,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "bağlanabilir bence."
    } ]
  }, {
    "tStartMs": 322790,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Patent nedir? Aslında bir şeyin tekilliğini"
    } ]
  }, {
    "tStartMs": 325130,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "ifade eden, dediğin gibi varlığa dönüştüren"
    } ]
  }, {
    "tStartMs": 327800,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "bir regülatif aksiyon, döküman."
    } ]
  }, {
    "tStartMs": 330620,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "Bir döküman aslında."
    } ]
  }, {
    "tStartMs": 331670,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "Bunun yeni nesil patent nedir?"
    } ]
  }, {
    "tStartMs": 333500,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "Blockchain'de aslında bazı şeyleri"
    } ]
  }, {
    "tStartMs": 336260,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "damgalama. Bu çok yeni bir şey."
    } ]
  }, {
    "tStartMs": 339990,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "Fikrinizi veya süreçlerini veya işte faydalı"
    } ]
  }, {
    "tStartMs": 342770,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "modellerinizi değil, belki blockchain'de"
    } ]
  }, {
    "tStartMs": 345860,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "damgalamayabilirsiniz ya da bir işinize"
    } ]
  }, {
    "tStartMs": 347630,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "yarayamayabilir uzun vadede."
    } ]
  }, {
    "tStartMs": 349340,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "Ancak farklı varlıklarımızı blockchain'e"
    } ]
  }, {
    "tStartMs": 352280,
    "dDurationMs": 2450,
    "segs": [ {
      "utf8": "taşıyabilirsiniz. Evet, orada da aslında"
    } ]
  }, {
    "tStartMs": 354740,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "bunu kullanan start uplar, girişimler var"
    } ]
  }, {
    "tStartMs": 357050,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "uzun süredir. Mesela bir fotoğrafınızı size"
    } ]
  }, {
    "tStartMs": 359540,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "ait olduğunu nasıl ispatlarsınız?"
    } ]
  }, {
    "tStartMs": 362180,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "İmzalarsınız bunu blockchain teknolojisiyle"
    } ]
  }, {
    "tStartMs": 365330,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": ". İmzalandığı zaman tabii bunların"
    } ]
  }, {
    "tStartMs": 368030,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "kullanılabildiği, o imzaların"
    } ]
  }, {
    "tStartMs": 369620,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "doğrulanabildiği siteler ya da uygulamalar"
    } ]
  }, {
    "tStartMs": 372680,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "olması lazım. Varsa dolayısıyla siz bunu da"
    } ]
  }, {
    "tStartMs": 375650,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "ispatlayabilirsiniz, imza aldığınız"
    } ]
  }, {
    "tStartMs": 377180,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "takdirde. O açıdan bakarsan blockchain de"
    } ]
  }, {
    "tStartMs": 379670,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "güzel bir örnek. Yaptığınız şeyin ilk siz"
    } ]
  }, {
    "tStartMs": 383540,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "yaptığınızı ispatlarsınız."
    } ]
  }, {
    "tStartMs": 384860,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "Belki patent ofisi onu reddeder patentlemeyi"
    } ]
  }, {
    "tStartMs": 388700,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "ama en azından bir yere gittiğinizde ilk"
    } ]
  }, {
    "tStartMs": 390500,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "gerçekten siz yapmışsınız, ispatlarsınız."
    } ]
  }, {
    "tStartMs": 392420,
    "dDurationMs": 1010,
    "segs": [ {
      "utf8": "Güzel bir ekleme oldu."
    } ]
  }, {
    "tStartMs": 394250,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "Burada fikri haklardan aslında bu konunun,"
    } ]
  }, {
    "tStartMs": 398360,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "bu modülün ikinci bölümü olan şirket kurulum"
    } ]
  }, {
    "tStartMs": 401390,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "ve şirket tiplerine geçeceğiz."
    } ]
  }, {
    "tStartMs": 402920,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "Yine Ömer Abi'nin söylediği gibi bu işte"
    } ]
  }, {
    "tStartMs": 405980,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "tecrübelerimizden kaynaklı bazı"
    } ]
  }, {
    "tStartMs": 409190,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "içgörülerimiz var. Onları sizle paylaşmak"
    } ]
  }, {
    "tStartMs": 411080,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "istiyoruz. Ama bu işin teknik tarafları"
    } ]
  }, {
    "tStartMs": 413750,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "neyin size daha faydalı olacak?"
    } ]
  }, {
    "tStartMs": 415280,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Hangi türün size daha yararlı olacağını yine"
    } ]
  }, {
    "tStartMs": 418250,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "uzmanlardan öğrenebilirsiniz."
    } ]
  }, {
    "tStartMs": 420420,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "İstersen bunu bir sonraki derste konuşalım."
    } ]
  }, {
    "tStartMs": 423320,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "Şirket tipleri ne kurmak lazım?"
    } ]
  }, {
    "tStartMs": 425480,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "Hangi farklı ülkelerde şirket kurmanın"
    } ]
  }, {
    "tStartMs": 428390,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "yöntemleri veya zararları, avantajları?"
    } ]
  }, {
    "tStartMs": 431720,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "Bunları bir sonraki derste konuşalım."
    } ]
  } ]
}
