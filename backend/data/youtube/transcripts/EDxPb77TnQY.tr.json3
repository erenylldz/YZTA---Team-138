  }, {
    "tStartMs": 9060,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "ne olacak Ömer Abi?"
    } ]
  }, {
    "tStartMs": 11230,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "Şimdi bütün perspektife koyalım istiyorsan."
