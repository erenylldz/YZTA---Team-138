    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "ile başkasından para alabiliyorsunuz."
    } ]
  }, {
    "tStartMs": 285100,
    "dDurationMs": 750,
    "segs": [ {
      "utf8": "Örneğin reklam."
    } ]
  }, {
    "tStartMs": 285850,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "Reklam göstererek."
    } ]
  }, {
    "tStartMs": 287080,
    "dDurationMs": 210,
    "segs": [ {
      "utf8": ".."
